<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">200</defaultcontrol>
	<backgroundcolor>FF141414</backgroundcolor>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="FF141414">white.png</texture>
		</control>
		<control type="label">
			<left>80</left><top>55</top><width>1400</width><height>60</height>
			<font>Bold40</font><textcolor>FFFFFFFF</textcolor><label>Search</label>
		</control>
		<control type="image">
			<left>80</left><top>140</top><width>1750</width><height>64</height>
			<texture colordiffuse="FF292929">white.png</texture>
		</control>
		<control type="label">
			<left>104</left><top>140</top><width>1700</width><height>64</height>
			<font>Reg32</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
			<label>$INFO[Window.Property(Search.Query)]</label>
		</control>
		<control type="label">
			<left>104</left><top>140</top><width>1700</width><height>64</height>
			<font>Reg28</font><textcolor>FF999999</textcolor><aligny>center</aligny>
			<label>Find a movie or TV show</label><visible>String.IsEmpty(Window.Property(Search.Query))</visible>
		</control>
		<control type="label">
			<left>80</left><top>235</top><width>430</width><height>36</height>
			<font>Reg24</font><textcolor>FFAAAAAA</textcolor><label>Movies &amp; TV shows</label>
		</control>
		<control type="panel" id="200">
			<left>80</left><top>290</top><width>432</width><height>432</height>
			<orientation>vertical</orientation><scrolltime>0</scrolltime>
			<onleft>200</onleft>
			<onright condition="Integer.IsGreater(Container(500).NumItems,0)">500</onright>
			<onright condition="!Integer.IsGreater(Container(500).NumItems,0) + String.IsEqual(Window.Property(Search.HasMore),true)">501</onright>
			<onup>204</onup><ondown>201</ondown>
			<itemlayout width="72" height="72">
				<control type="label">
					<left>2</left><top>2</top><width>66</width><height>66</height>
					<font>Reg32</font><textcolor>FFFFFFFF</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="72" height="72">
				<control type="image">
					<left>2</left><top>2</top><width>66</width><height>66</height>
					<texture colordiffuse="FFFFFFFF">white.png</texture><visible>Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>2</left><top>2</top><width>66</width><height>66</height>
					<font>Reg32</font><textcolor>FFFFFFFF</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus(200)</visible>
				</control>
				<control type="label">
					<left>2</left><top>2</top><width>66</width><height>66</height>
					<font>Reg32</font><textcolor>FF141414</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus(200)</visible>
				</control>
			</focusedlayout>
		</control>
		<control type="button" id="201">
			<left>80</left><top>745</top><width>210</width><height>60</height>
			<font>Reg28</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF141414</focusedcolor><align>center</align><aligny>center</aligny>
			<texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus><texturenofocus colordiffuse="FF292929">white.png</texturenofocus>
			<label>Space</label><onleft>200</onleft><onright>202</onright><onup>200</onup><ondown>203</ondown>
		</control>
		<control type="button" id="202">
			<left>302</left><top>745</top><width>210</width><height>60</height>
			<font>Reg28</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF141414</focusedcolor><align>center</align><aligny>center</aligny>
			<texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus><texturenofocus colordiffuse="FF292929">white.png</texturenofocus>
			<label>Delete</label><onleft>201</onleft><onup>200</onup><ondown>203</ondown>
			<onright condition="Integer.IsGreater(Container(500).NumItems,0)">500</onright>
			<onright condition="!Integer.IsGreater(Container(500).NumItems,0) + String.IsEqual(Window.Property(Search.HasMore),true)">501</onright>
		</control>
		<control type="button" id="203">
			<left>80</left><top>819</top><width>432</width><height>60</height>
			<font>Reg28</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF141414</focusedcolor><align>center</align><aligny>center</aligny>
			<texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus><texturenofocus colordiffuse="FF292929">white.png</texturenofocus>
			<label>Clear</label><onleft>203</onleft><onup>201</onup><ondown>204</ondown>
			<onright condition="Integer.IsGreater(Container(500).NumItems,0)">500</onright>
			<onright condition="!Integer.IsGreater(Container(500).NumItems,0) + String.IsEqual(Window.Property(Search.HasMore),true)">501</onright>
		</control>
		<control type="button" id="204">
			<left>1630</left><top>55</top><width>200</width><height>60</height>
			<font>Reg28</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF141414</focusedcolor><align>center</align><aligny>center</aligny>
			<texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus><texturenofocus colordiffuse="FF292929">white.png</texturenofocus>
			<label>Back</label><onleft>200</onleft><onright>200</onright><onup>200</onup><ondown>200</ondown>
		</control>
		<control type="button" id="501">
			<left>600</left><top>965</top><width>1220</width><height>60</height>
			<font>Reg28</font><textcolor>FFFFFFFF</textcolor><focusedcolor>FF141414</focusedcolor><align>center</align><aligny>center</aligny>
			<texturefocus colordiffuse="FFFFFFFF">white.png</texturefocus><texturenofocus colordiffuse="FF292929">white.png</texturenofocus>
			<label>$INFO[Window.Property(Search.MoreLabel)]</label><onleft>200</onleft><onright>200</onright><onup>500</onup><ondown>200</ondown>
			<visible>String.IsEqual(Window.Property(Search.HasMore),true)</visible>
			<enable>!String.IsEqual(Window.Property(Search.Pending),true)</enable>
		</control>
		<control type="label">
			<left>600</left><top>220</top><width>1220</width><height>40</height>
			<font>Reg24</font><textcolor>FFAAAAAA</textcolor><label>$INFO[Window.Property(Search.Status)]</label>
		</control>
		<control type="panel" id="500">
			<left>600</left><top>280</top><width>1220</width><height>680</height>
			<orientation>vertical</orientation><scrolltime>150</scrolltime>
			<onleft>200</onleft><onright>500</onright><onup>204</onup><ondown>501</ondown>
			<preloaditems>5</preloaditems>
			<itemlayout width="244" height="340">
				<control type="image">
					<left>6</left><top>6</top><width>210</width><height>280</height>
					<texture background="true">$INFO[ListItem.Art(poster)]</texture><aspectratio>scale</aspectratio>
				</control>
				<control type="label">
					<left>6</left><top>292</top><width>216</width><height>26</height>
					<font>Reg24</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>6</left><top>318</top><width>216</width><height>22</height>
					<font>font12</font><textcolor>FFAAAAAA</textcolor><label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="244" height="340">
				<control type="image">
					<left>0</left><top>0</top><width>222</width><height>292</height>
					<texture colordiffuse="FFFFFFFF">white.png</texture><visible>Control.HasFocus(500)</visible>
				</control>
				<control type="image">
					<left>6</left><top>6</top><width>210</width><height>280</height>
					<texture background="true">$INFO[ListItem.Art(poster)]</texture><aspectratio>scale</aspectratio>
				</control>
				<control type="label">
					<left>6</left><top>292</top><width>216</width><height>26</height>
					<font>Reg24</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>6</left><top>318</top><width>216</width><height>22</height>
					<font>font12</font><textcolor>FFAAAAAA</textcolor><label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>
		<control type="label">
			<left>80</left><top>910</top><width>450</width><height>90</height>
			<font>font12</font><textcolor>FF999999</textcolor><wrapmultiline>true</wrapmultiline>
			<label>Results update as you type.[CR]Move right to browse. Back to close.</label>
		</control>
	</controls>
</window>
