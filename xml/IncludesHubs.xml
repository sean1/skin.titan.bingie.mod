<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <!-- Fixed POV hub row. Content, label, target, order, and limit are code-defined. -->
    <include name="bingie_pov_hub_item">
        <control type="group" id="20$PARAM[widgetid]">
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <width>100%</width>
            <height>40</height>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>BingieNoCircularWidgetHeaderAnim</include>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Hub_Widget_Label">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="visibility" value="true" />
                <param name="label" value="$PARAM[label]" />
            </include>
            <control type="multiimage">
                <top>7</top>
                <width>100%</width>
                <height>30</height>
                <include>widget_header_leftalign</include>
                <aspectratio align="left">keep</aspectratio>
                <imagepath background="true">$VAR[WidgetBusySpinnerPath]</imagepath>
                <timeperimage>85</timeperimage>
                <colordiffuse>ffffffff</colordiffuse>
                <fadetime>0</fadetime>
                <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)</visible>
            </control>
        </control>
        <control type="fixedlist" id="$PARAM[widgetid]">
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <width>100%</width>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>ScrollTime</include>
            <preloaditems>5</preloaditems>
            <orientation>horizontal</orientation>
            <onback condition="$EXP[IsPlayingRecognizedContent]">SetFocus(509)</onback>
            <onback condition="!$EXP[IsPlayingRecognizedContent]">900</onback>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
			<onclick>Action(Info)</onclick>
            <include content="$PARAM[widgetStyle]">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="widgetTags" value="WidgetTagOverlayAuto" />
                <param name="multiRows" value="false" />
            </include>
            <content limit="30" target="videos" browse="never">$PARAM[path]</content>
        </control>
    </include>

    <!-- Bingie Items Movies -->
    <include name="bingie_items_movies">
        <include>Empty_Hub_Alt_Buttons</include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1510" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Continue Watching" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=in_progress_movies" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1520" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Trending Movies" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_trending" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1530" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Popular Movies" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_popular" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1540" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="New Releases" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_latest_releases" />
        </include>
    </include>

    <!-- Bingie Items TVShows -->
    <include name="bingie_items_tvshows">
        <include>Empty_Hub_Alt_Buttons</include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1510" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Continue Watching" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_in_progress_episode" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1520" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Trending TV Shows" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_trending" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1530" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Popular TV Shows" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_popular" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1540" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="New TV Shows" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_premieres" />
        </include>
    </include>

	 <!-- Bingie Items Play Something -->
    <include name="bingie_items_something">
		<posy>517</posy>
		<posx>124</posx>
        <include>Empty_Hub_Alt_Buttons</include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1510" />
            <param name="widgetStyle" value="PlaySomething_Widget" />
            <param name="label" value="Popular Movies" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_popular" />
        </include>
    </include>

    <!-- Bingie Items New -->
    <include name="bingie_items_new">
        <include>Empty_Hub_Alt_Buttons</include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1510" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="New Movie Releases" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_latest_releases" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1520" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="New TV Shows" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_premieres" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1530" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Popular Movies" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_movie_list&amp;action=tmdb_movies_popular" />
        </include>
        <include content="bingie_pov_hub_item">
            <param name="widgetid" value="1540" />
            <param name="widgetStyle" value="widget_layout_default" />
            <param name="label" value="Popular TV Shows" />
            <param name="path" value="plugin://plugin.video.pov.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_popular" />
        </include>
    </include>

    <include name="Hub_Widget_Label">
        <control type="textbox">
            <visible>$PARAM[visibility]</visible>
            <height>100%</height>
            <width>99%</width>
			<left>67</left>
            <font>Bold31</font>
            <include>widget_header_leftalign</include>
            <textcolor>ffffffff</textcolor>
            <shadowcolor>None</shadowcolor>
            <label>$PARAM[label]</label>
            <animation effect="slide" end="50" time="0" condition="Container($PARAM[widgetid]).IsUpdating + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)">Conditional</animation>
        </control>
    </include>


    <include name="Empty_Hub_Alt_Buttons">
        <control type="textbox" id="1501">
            <visible>[Integer.IsEqual(Container(1510).NumItems,0) + !Container(1510).IsUpdating] + [Integer.IsEqual(Container(1520).NumItems,0) + !Container(1520).IsUpdating]
                + [Integer.IsEqual(Container(1530).NumItems,0) + !Container(1530).IsUpdating] + [Integer.IsEqual(Container(1540).NumItems,0) + !Container(1540).IsUpdating]
                + [Integer.IsEqual(Container(1550).NumItems,0) + !Container(1550).IsUpdating] + [Integer.IsEqual(Container(1560).NumItems,0) + !Container(1560).IsUpdating]
                + [Integer.IsEqual(Container(1570).NumItems,0) + !Container(1570).IsUpdating] + [Integer.IsEqual(Container(1580).NumItems,0) + !Container(1580).IsUpdating]</visible>
            <animation effect="slide" time="0" start="0" end="65" condition="true">Conditional</animation>
			<animation effect="slide" time="0" start="0" end="-104,50" condition="Window.IsActive(1118)">Conditional</animation>
            <include>No_Circular_Slide_Animation</include>
            <height>45</height>
            <width>99%</width>
			<left>19</left>
            <font>Bold31</font>
            <include>widget_header_leftalign</include>
            <textcolor>ffffffff</textcolor>
            <shadowcolor>None</shadowcolor>
            <label>31372</label>
        </control>

        <control type="grouplist" id="1502">
            <visible>Control.IsVisible(1501)</visible>
            <animation effect="slide" time="0" start="0" end="65" condition="true">Conditional</animation>
			<animation effect="slide" time="0" start="0" end="-119,50" condition="Window.IsActive(1118)">Conditional</animation>
            <include>No_Circular_Slide_Animation</include>
            <height>132</height>
            <width>100%</width>
            <orientation>horizontal</orientation>
            <itemgap>50</itemgap>
            <align>left</align>
			<left>4</left>
            <onright>noop</onright>
            <onleft>900</onleft>

            <control type="grouplist" id="1503">
                <height>132</height>
                <width>600</width>
                <orientation>vertical</orientation>
                <itemgap>2</itemgap>
                <align>left</align>
                <onright>noop</onright>
                <onleft>900</onleft>
                <control type="button" id="1504">
                    <width>600</width>
                    <height>65</height>
                    <aligny>center</aligny>
                    <align>left</align>
                    <font>Reg30</font>
                    <textoffsetx>15</textoffsetx>
                    <textoffsety>8</textoffsety>
                    <textcolor>a6ffffff</textcolor>
                    <focusedcolor>ffffffff</focusedcolor>
                    <texturefocus border="10" colordiffuse="ffffffff">bingie/border/default_button_fo_4.png</texturefocus>
                    <texturenofocus/>
                    <label>31392</label>
                    <onclick>ActivateWindow(Videos,sources://video/,return)</onclick>
                    <visible>!Library.HasContent(Video)</visible>
                </control>
            </control>

            <control type="group">
                <control type="textbox">
                    <height>132</height>
                    <width min="550" max="850">auto</width>
                    <font>Light26</font>
                    <aligny>top</aligny>
                    <textcolor>ffffffff</textcolor>
                    <shadowcolor>None</shadowcolor>
                    <label>$VAR[NoItemsInHubButtonsInfo]</label>
                </control>
            </control>
        </control>
    </include>

    <variable name="NoItemsInHubButtonsInfo">
        <value condition="Control.HasFocus(1504)">$LOCALIZE[31391]</value>
    </variable>
</includes>
