<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window type="dialog" id="400">

    <defaultcontrol always="true">100</defaultcontrol>

	<include>animation_window_open_close</include>

    <visible>Player.HasVideo + Window.IsActive(PlayerControls) + !Window.IsActive(fullscreenvideo)</visible>
    <coordinates>
        <system>1</system>
    </coordinates>
    <controls>

	<include>DialogOverlayExtra</include>

	<!--NowPlaying-->

		<control type="group">
			<left>585</left>
			<top>310</top>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>745</width>
				<height>395</height>
				<colordiffuse>cc000000</colordiffuse>
				<texture border="10">diffuse/panel.png</texture>
			</control>

			<control type="image">
				<left>+10</left>
				<top>+10</top>
				<width>725</width>
				<height>375</height>
				<colordiffuse>cc000000</colordiffuse>
				<texture border="10">diffuse/panel.png</texture>
			</control>

			<control type="group" id="100">
				<left>38</left>
				<top>300</top>
				<defaultcontrol always="true">603</defaultcontrol>
				<control type="button" id="600">
					<left>0</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDPrevTrackfo.png</texturefocus>
					<texturenofocus>player-controls/OSDPrevTracknf.png</texturenofocus>
					<onleft>608</onleft>
					<onright>601</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>PlayerControl(Previous)</onclick>
				</control>
				<control type="button" id="601">
					<left>60</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDRewindfo.png</texturefocus>
					<texturenofocus>player-controls/OSDRewindnf.png</texturenofocus>
					<onleft>600</onleft>
					<onright>603</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>PlayerControl(Rewind)</onclick>
				</control>
				<control type="togglebutton" id="603">
					<left>120</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDPausefo.png</texturefocus>
					<texturenofocus>player-controls/OSDPausenf.png</texturenofocus>
					<usealttexture>Player.Paused | Player.Forwarding | Player.Rewinding</usealttexture>
					<alttexturefocus>player-controls/OSDPlayfo.png</alttexturefocus>
					<alttexturenofocus>player-controls/OSDPlaynf.png</alttexturenofocus>
					<onleft>601</onleft>
					<onright>602</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>PlayerControl(Play)</onclick>
				</control>
				<control type="button" id="602">
					<left>180</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDStopfo.png</texturefocus>
					<texturenofocus>player-controls/OSDStopnf.png</texturenofocus>
					<onleft>603</onleft>
					<onright>604</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>down</onclick>
					<onclick>PlayerControl(Stop)</onclick>
				</control>
				<control type="button" id="604">
					<left>240</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDForwardfo.png</texturefocus>
					<texturenofocus>player-controls/OSDForwardnf.png</texturenofocus>
					<onleft>602</onleft>
					<onright>605</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>PlayerControl(Forward)</onclick>
				</control>
				<control type="button" id="605">
					<left>300</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDNextTrackfo.png</texturefocus>
					<texturenofocus>player-controls/OSDNextTracknf.png</texturenofocus>
					<onleft>604</onleft>
					<onright>607</onright>
					<onup>900</onup>
					<ondown>200</ondown>
					<onclick>PlayerControl(Next)</onclick>
				</control>
				<control type="button" id="607">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus/>
					<texturenofocus/>
					<onclick>PlayerControl(Repeat)</onclick>
					<onleft>605</onleft>
					<onright>608</onright>
					<onup>900</onup>
					<ondown>200</ondown>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatnf.png</texture>
					<visible>!Playlist.IsRepeat + !Playlist.IsRepeatOne + !Control.HasFocus(607)</visible>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatfo.png</texture>
					<visible>!Playlist.IsRepeat + !Playlist.IsRepeatOne + Control.HasFocus(607)</visible>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatOnenf.png</texture>
					<visible>Playlist.IsRepeatOne + !Control.HasFocus(607)</visible>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatOnefo.png</texture>
					<visible>Playlist.IsRepeatOne + Control.HasFocus(607)</visible>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatAllnf.png</texture>
					<visible>Playlist.IsRepeat + !Control.HasFocus(607)</visible>
				</control>
				<control type="image">
					<left>360</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<texture>player-controls/OSDRepeatAllfo.png</texture>
					<visible>Playlist.IsRepeat + Control.HasFocus(607)</visible>
				</control>
				<control type="togglebutton" id="608">
					<left>420</left>
					<top>0</top>
					<width>60</width>
					<height>60</height>
					<label/>
					<texturefocus>player-controls/OSDRandomOfffo.png</texturefocus>
					<texturenofocus>player-controls/OSDRandomOffnf.png</texturenofocus>
					<usealttexture>Playlist.IsRandom</usealttexture>
					<alttexturefocus>player-controls/OSDRandomOnfo.png</alttexturefocus>
					<alttexturenofocus>player-controls/OSDRandomOnnf.png</alttexturenofocus>
					<onclick>PlayerControl(Random)</onclick>
					<onleft>607</onleft>
					<onright>600</onright>
					<onup>900</onup>
					<ondown>200</ondown>
				</control>
			</control>
			<!-- Now Playing Video Preview with Controls -->

			<control type="group">
				<visible>Player.HasVideo</visible>

			<control type="videowindow">
				<centertop>+155</centertop>
				<centerleft>+375</centerleft>
				<width>475</width>
				<height>267</height>
				<aspectratio>scale</aspectratio>
				<visible>Player.HasVideo</visible>
			</control>

			</control>

			<!-- mouse close window -->
			<control type="button">
				<description>Close Window button</description>
				<left>640</left>
				<top>12</top>
				<width>96</width>
				<height>48</height>
				<label/>
				<font/>
				<onclick>back</onclick>
				<texturefocus>player-controls/DialogCloseButton-focus.png</texturefocus>
				<texturenofocus>player-controls/DialogCloseButton.png</texturenofocus>
				<onleft>100</onleft>
				<onright>100</onright>
				<onup>100</onup>
				<ondown>100</ondown>
				<visible>system.getbool(input.enablemouse)</visible>
			</control>

		</control>

    </controls>
</window>
