<?xml version="1.0" encoding="utf-8"?>
<includes>
	<include name="PovInfoPage">
		<control type="group">
			<visible>String.IsEmpty(Window(Home).Property(PovInfoTransition))</visible>
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>

			<control type="image">
				<include>FullscreenDimensions</include>
				<texture>colors/color_black.png</texture>
			</control>
			<include>BingieRowTrailerPreviewWindow</include>
			<include content="BingieSpotlightCornerImage">
				<param name="visibility" value="!Player.HasVideo | [!String.IsEmpty(Window(Home).Property(BingieTrailerPreview)) + String.IsEmpty(Window(Home).Property(BingieTrailerPreviewReady))]" />
				<param name="image" value="$INFO[Window(Home).Property(PovInfoFanart)]" />
			</include>

			<control type="image" id="9105">
				<left>138</left>
				<top>10</top>
				<width>490</width>
				<height>190</height>
				<aspectratio align="left" aligny="center">keep</aspectratio>
				<texture background="true">$INFO[Window(Home).Property(PovInfoLogo)]</texture>
			</control>
			<control type="textbox">
				<visible>String.IsEmpty(Window(Home).Property(PovInfoLogo))</visible>
				<left>138</left>
				<top>10</top>
				<width>650</width>
				<height>190</height>
				<font>Title</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$INFO[Window(Home).Property(PovInfoTitle)]</label>
				<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
			</control>

			<control type="grouplist">
				<left>138</left>
				<top>220</top>
				<width>850</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<control type="label">
					<visible>!String.IsEmpty(Window(Home).Property(PovInfoMatch))</visible>
					<width max="220">auto</width>
					<height>40</height>
					<font>Bold24</font>
					<aligny>center</aligny>
					<textcolor>ff46d369</textcolor>
					<label>$INFO[Window(Home).Property(PovInfoMatch)]</label>
				</control>
				<control type="label">
					<visible>!String.IsEmpty(Window(Home).Property(PovInfoYearRange))</visible>
					<width max="180">auto</width>
					<height>40</height>
					<font>Reg24</font>
					<aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovInfoYearRange)]</label>
				</control>
				<control type="label">
					<visible>!String.IsEmpty(Window(Home).Property(PovInfoMpaa))</visible>
					<width max="150">auto</width>
					<height>40</height>
					<font>Bold24</font>
					<aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovInfoMpaa)]</label>
				</control>
				<control type="label">
					<visible>String.IsEqual(Window(Home).Property(PovInfoType),movie) + !String.IsEmpty(Window(Home).Property(PovInfoRuntime))</visible>
					<width max="180">auto</width>
					<height>40</height>
					<font>Reg24</font>
					<aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovInfoRuntime)]</label>
				</control>
				<control type="label">
					<visible>String.IsEqual(Window(Home).Property(PovInfoType),tvshow) + !String.IsEmpty(Window(Home).Property(PovInfoSeasons))</visible>
					<width max="180">auto</width>
					<height>40</height>
					<font>Reg24</font>
					<aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovInfoSeasons)]</label>
				</control>
			</control>

			<control type="textbox">
				<left>138</left>
				<top>275</top>
				<width>820</width>
				<height>135</height>
				<font>Plots</font>
				<textcolor>b3ffffff</textcolor>
				<align>left</align>
				<aligny>top</aligny>
				<label>$INFO[Window(Home).Property(PovInfoPlot)]</label>
				<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
			</control>

			<control type="grouplist" id="8000">
				<left>138</left>
				<top>430</top>
				<width>550</width>
				<height>220</height>
				<orientation>vertical</orientation>
				<itemgap>10</itemgap>
				<onup>noop</onup>
				<ondown>8010</ondown>
				<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
				<control type="radiobutton" id="80">
					<visible>String.IsEqual(Window(Home).Property(PovInfoType),movie)</visible>
					<include>Bingie_InfoDialog_Button_Default_Defs</include>
					<include content="Bingie_InfoDialog_Button_Texture">
						<param name="radiotexture" value="dialogs/videoinfo/info/play2.png" />
					</include>
					<label>$LOCALIZE[208]</label>
					<radioposx>17</radioposx>
					<radiowidth>22</radiowidth>
					<radioheight>22</radioheight>
					<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=play_from_info&amp;mediatype=movie&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)])</onclick>
					<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
				</control>
				<control type="radiobutton" id="51">
					<visible>String.IsEqual(Window(Home).Property(PovInfoType),tvshow)</visible>
					<include>Bingie_InfoDialog_Button_Default_Defs</include>
					<include content="Bingie_InfoDialog_Button_Texture">
						<param name="radiotexture" value="dialogs/videoinfo/info/play2.png" />
					</include>
					<label>$LOCALIZE[208]</label>
					<radioposx>17</radioposx>
					<radiowidth>22</radiowidth>
					<radioheight>22</radioheight>
					<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=play_from_info&amp;mediatype=tvshow&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)])</onclick>
					<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
				</control>
				<control type="radiobutton" id="53">
					<visible>String.IsEqual(Window(Home).Property(PovInfoType),tvshow)</visible>
					<include>Bingie_InfoDialog_Button_Default_Defs</include>
					<include content="Bingie_InfoDialog_Button_Texture">
						<param name="radiotexture" value="dialogs/videoinfo/info/more_episodes.png" />
					</include>
					<label>Episodes</label>
					<radioposy>22</radioposy>
					<radioposx>16</radioposx>
					<radiowidth>24</radiowidth>
					<radioheight>24</radioheight>
					<onclick condition="!String.IsEmpty(Window(Home).Property(PovInfoTmdb))">ActivateWindow(Videos,plugin://skin.titan.bingie.lite/?mode=build_season_list&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)],return)</onclick>
					<onclick condition="String.IsEmpty(Window(Home).Property(PovInfoTmdb)) + !String.IsEmpty(Window(Home).Property(PovInfoPendingTmdb))">ActivateWindow(Videos,plugin://skin.titan.bingie.lite/?mode=build_season_list&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoPendingTmdb)],return)</onclick>
					<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
				</control>
				<control type="radiobutton" id="55">
					<visible>!String.IsEmpty(Window(Home).Property(PovInfoTmdb))</visible>
					<include>Bingie_InfoDialog_Button_Default_Defs</include>
					<include content="Bingie_InfoDialog_Button_Texture">
						<param name="radiotexture" value="dialogs/videoinfo/info/play.png" />
					</include>
					<label>Trailer</label>
					<radioposx>17</radioposx>
					<radiowidth>22</radiowidth>
					<radioheight>22</radioheight>
					<ondown>8010</ondown>
					<onclick>SetProperty(BingieTrailerPreviewRequest,true,Home)</onclick>
					<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
				</control>
			</control>
			<control type="button" id="8010">
				<visible allowhiddenfocus="true">true</visible>
				<left>-100</left>
				<top>-100</top>
				<width>1</width>
				<height>1</height>
				<onfocus condition="$EXP[PovInfoHasCurrentCast]">SetFocus(550)</onfocus>
				<onfocus condition="!$EXP[PovInfoHasCurrentCast] + $EXP[PovInfoHasCurrentCollection]">SetFocus(563)</onfocus>
				<onfocus condition="!$EXP[PovInfoHasCurrentCast] + !$EXP[PovInfoHasCurrentCollection] + $EXP[PovInfoHasCurrentMoreLikeThis]">SetFocus(560)</onfocus>
				<onfocus condition="!$EXP[PovInfoHasCurrentCast] + !$EXP[PovInfoHasCurrentCollection] + !$EXP[PovInfoHasCurrentMoreLikeThis] + String.IsEqual(Window(Home).Property(PovInfoType),movie)">SetFocus(80)</onfocus>
				<onfocus condition="!$EXP[PovInfoHasCurrentCast] + !$EXP[PovInfoHasCurrentCollection] + !$EXP[PovInfoHasCurrentMoreLikeThis] + String.IsEqual(Window(Home).Property(PovInfoType),tvshow)">SetFocus(53)</onfocus>
			</control>

			<control type="list" id="566">
				<visible allowhiddenfocus="true">$EXP[PovInfoCollectionReady] + !String.IsEmpty(Window(Home).Property(PovInfoCollectionId))</visible>
				<left>-3000</left>
				<top>-3000</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1" />
				<focusedlayout width="1" height="1" />
				<content limit="15" target="videos" browse="never">$VAR[PovInfoPageCollectionPath]</content>
			</control>
			<control type="list" id="565">
				<visible allowhiddenfocus="true">$EXP[PovInfoMoreLikeThisReady]</visible>
				<left>-3000</left>
				<top>-3000</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1" />
				<focusedlayout width="1" height="1" />
				<content limit="15" target="videos" browse="never">$VAR[PovInfoPageMoreLikeThisPath]</content>
			</control>

			<control type="grouplist">
				<left>126</left>
				<top>650</top>
				<width>1668</width>
				<height>924</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<itemgap>2</itemgap>
				<animation effect="slide" end="0,-382" time="300" tween="cubic" easing="inout" condition="[Control.HasFocus(563) | Control.HasFocus(560)] + $EXP[PovInfoHasCurrentCast]">Conditional</animation>
				<animation effect="slide" end="0,-272" time="300" tween="cubic" easing="inout" condition="Control.HasFocus(560) + $EXP[PovInfoHasCurrentCollection]">Conditional</animation>

				<control type="group">
					<visible>$EXP[PovInfoHasValidMedia] + String.IsEqual(Window(Home).Property(PovInfoHasCast),true)</visible>
					<width>1668</width>
					<height>380</height>
					<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(563) | Control.HasFocus(560)">Conditional</animation>
					<control type="label">
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>$LOCALIZE[206]</label>
					</control>
					<control type="group">
						<visible>!$EXP[PovInfoHasCurrentCast]</visible>
						<top>50</top>
						<include content="PovCastPlaceholder"><param name="left" value="0" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="238" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="476" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="714" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="952" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="1190" /></include>
						<include content="PovCastPlaceholder"><param name="left" value="1428" /></include>
					</control>
					<control type="panel" id="550">
						<visible allowhiddenfocus="true">true</visible>
						<enable>$EXP[PovInfoHasCurrentCast]</enable>
						<top>50</top>
						<width>1668</width>
						<height>330</height>
						<orientation>horizontal</orientation>
						<preloaditems>4</preloaditems>
						<scrolltime tween="quadratic">400</scrolltime>
						<onup>8000</onup>
						<ondown condition="$EXP[PovInfoHasCurrentCollection]">563</ondown>
						<ondown condition="!$EXP[PovInfoHasCurrentCollection] + $EXP[PovInfoHasCurrentMoreLikeThis]">560</ondown>
						<ondown condition="!$EXP[PovInfoHasCurrentCollection] + !$EXP[PovInfoHasCurrentMoreLikeThis]">550</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<onclick>RunPlugin($INFO[ListItem.Property(PovActorPath)])</onclick>
						<oninfo>RunPlugin($INFO[ListItem.Property(PovActorPath)])</oninfo>
						<itemlayout width="238" height="320">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<include content="PovCastCard"><param name="focused" value="false" /></include>
							</control>
						</itemlayout>
						<focusedlayout width="238" height="320">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<include content="PovCastCard"><param name="focused" value="true" /></include>
							</control>
						</focusedlayout>
						<content limit="14" target="videos" browse="never">$VAR[PovInfoPageCastPath]</content>
					</control>
				</control>

				<control type="group">
					<visible>$EXP[PovInfoHasCurrentCollection]</visible>
					<width>1668</width>
					<height>270</height>
					<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(550)">Conditional</animation>
					<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(560)">Conditional</animation>
					<control type="label">
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>In This Collection</label>
					</control>
					<control type="panel" id="563">
						<visible allowhiddenfocus="true">true</visible>
						<top>50</top>
						<width>1668</width>
						<height>220</height>
						<orientation>horizontal</orientation>
						<preloaditems>2</preloaditems>
						<scrolltime tween="quadratic">400</scrolltime>
						<onup condition="$EXP[PovInfoHasCurrentCast]">550</onup>
						<onup condition="!$EXP[PovInfoHasCurrentCast]">8000</onup>
						<ondown condition="$EXP[PovInfoHasCurrentMoreLikeThis]">560</ondown>
						<ondown condition="!$EXP[PovInfoHasCurrentMoreLikeThis]">563</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<oninfo>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=movie&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)])</oninfo>
						<itemlayout width="333" height="193">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<width>335</width>
								<height>195</height>
								<include content="PovMoreLikeThisCard"><param name="focused" value="false" /></include>
							</control>
						</itemlayout>
						<focusedlayout width="333" height="193">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<width>335</width>
								<height>195</height>
								<include content="PovMoreLikeThisCard"><param name="focused" value="true" /></include>
							</control>
						</focusedlayout>
						<content><include>PovCollectionItems</include></content>
					</control>
				</control>

				<control type="group">
					<visible>$EXP[PovInfoHasCurrentMoreLikeThis]</visible>
					<width>1668</width>
					<height>270</height>
					<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(550) | Control.HasFocus(563)">Conditional</animation>
					<control type="label">
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>$LOCALIZE[31622]</label>
					</control>
					<control type="panel" id="560">
						<visible allowhiddenfocus="true">true</visible>
						<top>50</top>
						<width>1668</width>
						<height>220</height>
						<orientation>horizontal</orientation>
						<preloaditems>2</preloaditems>
						<scrolltime tween="quadratic">400</scrolltime>
						<onup condition="$EXP[PovInfoHasCurrentCollection]">563</onup>
						<onup condition="!$EXP[PovInfoHasCurrentCollection] + $EXP[PovInfoHasCurrentCast]">550</onup>
						<onup condition="!$EXP[PovInfoHasCurrentCollection] + !$EXP[PovInfoHasCurrentCast]">8000</onup>
						<ondown>560</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<oninfo>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[Window(Home).Property(PovInfoType)]&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)])</oninfo>
						<itemlayout width="333" height="193">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<width>335</width>
								<height>195</height>
								<include content="PovMoreLikeThisCard"><param name="focused" value="false" /></include>
							</control>
						</itemlayout>
						<focusedlayout width="333" height="193">
							<control type="group">
								<visible>String.IsEqual(ListItem.Property(PovInfoSourceTmdb),Window(Home).Property(PovInfoTmdb))</visible>
								<width>335</width>
								<height>195</height>
								<include content="PovMoreLikeThisCard"><param name="focused" value="true" /></include>
							</control>
						</focusedlayout>
						<content><include>PovMoreLikeThisItems</include></content>
					</control>
				</control>
			</control>
		</control>
	</include>

	<include name="PovCastPlaceholder">
		<control type="image">
			<left>$PARAM[left]</left>
			<width>230</width>
			<height>310</height>
			<texture diffuse="diffuse/poster3.png">DefaultActorPoster.png</texture>
			<aspectratio scalediffuse="true" align="center" aligny="top">scale</aspectratio>
			<bordersize>8</bordersize>
			<colordiffuse>99ffffff</colordiffuse>
		</control>
	</include>

	<variable name="PovInfoPageMoreLikeThisPath">
		<value condition="$EXP[PovInfoMoreLikeThisReady] + String.IsEqual(Window(Home).Property(PovInfoType),movie)">plugin://skin.titan.bingie.lite/?mode=build_movie_list&amp;action=tmdb_movies_more_like_this&amp;s=i&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)]</value>
		<value condition="$EXP[PovInfoMoreLikeThisReady] + String.IsEqual(Window(Home).Property(PovInfoType),tvshow)">plugin://skin.titan.bingie.lite/?mode=build_tvshow_list&amp;action=tmdb_tv_more_like_this&amp;s=i&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)]</value>
	</variable>

	<variable name="PovInfoPageCastPath">
		<value condition="$EXP[PovInfoHasValidMedia]">plugin://skin.titan.bingie.lite/?mode=build_media_cast&amp;mediatype=$INFO[Window(Home).Property(PovInfoType)]&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)]</value>
	</variable>

	<variable name="PovInfoPageCollectionPath">
		<value condition="$EXP[PovInfoCollectionReady] + !String.IsEmpty(Window(Home).Property(PovInfoCollectionId))">plugin://skin.titan.bingie.lite/?mode=build_movie_list&amp;action=tmdb_movies_in_collection&amp;s=i&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)]&amp;collection_id=$INFO[Window(Home).Property(PovInfoCollectionId)]</value>
	</variable>
</includes>
