<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <include name="View_523_Bingie_Main_Landscape">
        <control type="group">
            <include>FullscreenDimensions</include>
            <visible>Control.IsVisible(523)</visible>
            <include>animation_view_change</include>

            <control type="group">
                <visible>!String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
                <include content="Bingie_Main_Spotlight_Section"><param name="id" value="523" /></include>
            </control>
            <control type="group">
                <visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
                <left>138</left><top>105</top><width>1500</width><height>300</height>
                <control type="textbox"><width>1400</width><height>180</height><font>Bold45</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Property(LiveTV.Match)]</label></control>
                <control type="label"><top>190</top><width>1400</width><height>45</height><font>Reg26</font><textcolor>ffbcbcbc</textcolor><label>$INFO[ListItem.Property(LiveTV.League)]  $INFO[ListItem.Property(LiveTV.Feeds), · ]</label></control>
            </control>

            <!-- View 523 -->
            <control type="group">
				<visible>!Window.IsActive(DialogVideoInfo.xml)</visible>
				<include>Animation_Right_Home</include>
                <left>131</left>
                <top>560</top>
                <width>1660</width>
                <control type="label">
                    <visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
                    <posx>7</posx><top>11</top><width>1100</width><height>40</height><font>Bold31</font><textcolor>ffffffff</textcolor>
                    <label>LIVE SOCCER  ·  Left for menu</label>
                </control>
                <control type="label">
                    <visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
                    <right>12</right><top>11</top><width>550</width><height>40</height><align>right</align><font>Reg20</font><textcolor>ffbcbcbc</textcolor>
                    <label>$INFO[Window(Home).Property(LiveTV.Soccer.Status)]</label>
                </control>
                <!-- Content Header -->
                <control type="label">
                    <width>100%</width>
                    <height>40</height>
					<posx>7</posx>
					<top>11</top>
                    <font>Bold31</font>
                    <align>left</align>
                    <textcolor>ffffffff</textcolor>
                    <label>$VAR[BingieMainContentHeader] $INFO[Window(Home).Property(TVshows.Count),(,)]</label>
                    <visible>Integer.IsGreater(Container(523).NumItems,0)</visible>
					<visible>String.IsEqual(Container.FolderPath, videodb://tvshows/titles/)</visible>
                </control>
				<control type="label">
                    <width>100%</width>
                    <height>40</height>
					<posx>7</posx>
					<top>11</top>
                    <font>Bold31</font>
                    <align>left</align>
                    <textcolor>ffffffff</textcolor>
                    <label>$VAR[BingieMainContentHeader] $INFO[Window(Home).Property(Movies.Count),(,)]</label>
                    <visible>Integer.IsGreater(Container(523).NumItems,0)</visible>
					<visible>String.IsEqual(Container.FolderPath, videodb://movies/titles/)</visible>
                </control>

                <include content="Bingie_Main_Landscape_View">
                    <param name="containerType" value="panel" />
                </include>
            </control>

		   <!-- scrollbar -->
                <control type="scrollbar" id="60">
					<texturesliderbackground border="5" colordiffuse="ff141414">scrollbar/texturesliderbar_small.png</texturesliderbackground>
					<texturesliderbar colordiffuse="ff646464" border="5">scrollbar/texturesliderbar_small.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="ffcc0000" border="5">scrollbar/texturesliderbar_small.png</texturesliderbarfocus>
					<textureslidernib colordiffuse="ff646464">scrollbar/texturesliderbar_nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="ffcc0000">scrollbar/texturesliderbar_nib.png</textureslidernibfocus>
                    <visible>Control.IsVisible(523) + Integer.IsGreater(Container.NumItems,0)</visible>
                    <width>10</width>
					<height>461</height>
                    <right>0</right>
                    <bottom>0</bottom>
                    <onleft>523</onleft>
                    <orientation>vertical</orientation>
                    <animation effect="fade" start="0" end="100" time="400" condition="[Control.HasFocus(60) | Container.Scrolling]">Conditional</animation>
                    <animation effect="fade" start="100" end="0" time="400" condition="![Control.HasFocus(60) | Container.Scrolling]">Conditional</animation>
                </control>
        </control>
    </include>

    <!-- Container -->
    <include name="Bingie_Main_Landscape_View">
		<control type="$PARAM[containerType]" id="523">
			<visible>!Container.Content(episodes) + !Container.Content(seasons)</visible>
            <visible>!$EXP[IsPovLiteNavigationMenu]</visible>
			<visible>!String.IsEqual(Container.FolderPath,sources://video/)</visible>
            <viewtype label="31018">panel</viewtype>
            <focusedposition>0</focusedposition>
            <top>51</top>
            <width>1668</width>
            <height>470</height>
            <orientation>vertical</orientation>
            <itemgap>0</itemgap>
            <preloaditems>4</preloaditems>
            <pagecontrol>60</pagecontrol>
            <include>ScrollTime</include>
            <onright>60</onright>
			<onleft condition="Container.Content(movies) | Container.Content(tvshows)">RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.initialize)</onleft>
			<onleft condition="Container.Content(movies) | Container.Content(tvshows)">9000</onleft>
			<onleft condition="String.Contains(Container.FolderPath,mode=livetv.refine)">SetProperty(ShowViewSubMenu,show,Home)</onleft>
			<onleft condition="String.Contains(Container.FolderPath,mode=livetv.refine)">9001</onleft>
			<onleft condition="String.Contains(Container.FolderPath,mode=livetv.soccer)">SetProperty(ShowViewSubMenu,show,Home)</onleft>
			<onleft condition="String.Contains(Container.FolderPath,mode=livetv.soccer)">9002</onleft>
			<onleft>523</onleft>
            <onup>523</onup>
            <ondown>523</ondown>
			<onclick condition="$EXP[IsPovLiteInfoListItem]">RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.DBType]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</onclick>
			<onclick condition="$EXP[IsNativeInfoListItem]">Action(Info)</onclick>
			<onclick condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)">Action(Info)</onclick>
			<oninfo condition="$EXP[IsPovLiteInfoListItem]">RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.DBType]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</oninfo>
            <itemlayout height="193" width="333">
                <control type="group">
                    <width>335</width>
                    <height>195</height>
                    <control type="group"><visible>!String.Contains(Container.FolderPath,mode=livetv.refine) + !String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include>ThumbsViewItemBingieLayout</include></control>
                    <control type="group"><visible>String.Contains(Container.FolderPath,mode=livetv.refine)</visible><include>BingieLiveChannelGridArt</include></control>
                    <control type="group"><visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include>BingieLiveSoccerCardArt</include></control>
                    <control type="group"><visible>!String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include content="Bingie_Main_Landscape_Title"><param name="focused" value="false" /></include></control>
                    <include content="BingieLiveSoccerTitle"><param name="focused" value="false" /></include>
                </control>
            </itemlayout>
            <focusedlayout height="193" width="333">
                <control type="group">
                    <width>335</width>
                    <height>195</height>
                    <control type="image">
                        <!--Panel Normal-->
						<visible>!$EXP[IsNextPageListItem]</visible>
                        <texture background="true">home/home_matte3.png</texture>
                        <colordiffuse>ffffffff</colordiffuse>
                        <include>thumbsborder_focused</include>
                    </control>
					<control type="image">
						<visible>$EXP[IsNextPageListItem]</visible>
						<texture>colors/color_black.png</texture>
						<bordertexture colordiffuse="ffffffff">diffuse/panel2.png</bordertexture>
						<include>thumbsborder_focused</include>
					</control>
                    <control type="group"><visible>!String.Contains(Container.FolderPath,mode=livetv.refine) + !String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include>ThumbsViewItemBingieLayout</include></control>
                    <control type="group"><visible>String.Contains(Container.FolderPath,mode=livetv.refine)</visible><include>BingieLiveChannelGridArt</include></control>
                    <control type="group"><visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include>BingieLiveSoccerCardArt</include></control>
                    <control type="group"><visible>!String.Contains(Container.FolderPath,mode=livetv.soccer)</visible><include content="Bingie_Main_Landscape_Title"><param name="focused" value="true" /></include></control>
                    <include content="BingieLiveSoccerTitle"><param name="focused" value="true" /></include>
                </control>
				<!--Top 250 1-->
				<control type="image">
				<visible>!Container.Content(episodes) + !Container.Content(seasons) + !String.IsEmpty(Control.GetLabel(8231))</visible>
				<posy>8</posy>
				<left>8</left>
                <height>60</height>
                <width>50</width>
				<aspectratio>keep</aspectratio>
                <texture>bingie/top250p.png</texture>
		        </control>
            </focusedlayout>
        </control>
    </include>

    <include name="BingieLiveSoccerCardArt">
        <control type="image"><left>8</left><right>8</right><top>8</top><bottom>8</bottom><texture>colors/color_white.png</texture><colordiffuse>ff30343b</colordiffuse></control>
        <control type="image"><left>24</left><top>24</top><width>45</width><height>4</height><texture>colors/color_white.png</texture><colordiffuse>ffcc0000</colordiffuse></control>
        <control type="label"><left>24</left><right>24</right><top>36</top><height>45</height><font>Bold31</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Property(LiveTV.League)]</label><scroll>true</scroll><visible>!String.IsEmpty(ListItem.Property(LiveTV.Match)) + !String.IsEqual(ListItem.Property(LiveTV.League),Other / unknown)</visible></control>
        <control type="label"><left>24</left><right>24</right><top>40</top><height>40</height><font>Bold31</font><textcolor>ffffffff</textcolor><label>LIVE SOCCER</label><visible>String.IsEmpty(ListItem.Property(LiveTV.Match)) | String.IsEqual(ListItem.Property(LiveTV.League),Other / unknown)</visible></control>
    </include>

    <include name="BingieLiveSoccerTitle">
        <control type="group">
            <visible>String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
            <control type="image"><left>8</left><right>8</right><bottom>8</bottom><height>100</height><texture>colors/color_black.png</texture><colordiffuse>ddffffff</colordiffuse></control>
            <control type="label"><left>16</left><right>16</right><bottom>69</bottom><height>24</height><font>Reg20</font><textcolor>ffbcbcbc</textcolor><label>$INFO[ListItem.Property(LiveTV.League)]</label><scroll>$PARAM[focused]</scroll></control>
            <control type="label"><left>16</left><right>16</right><bottom>38</bottom><height>30</height><font>Reg20</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Property(LiveTV.Match)]</label><scroll>$PARAM[focused]</scroll><visible>!String.IsEmpty(ListItem.Property(LiveTV.Match))</visible></control>
            <control type="label"><left>16</left><right>16</right><bottom>38</bottom><height>30</height><font>Reg20</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Label]</label><scroll>$PARAM[focused]</scroll><visible>String.IsEmpty(ListItem.Property(LiveTV.Match))</visible></control>
            <control type="label"><left>16</left><right>16</right><bottom>12</bottom><height>24</height><font>Reg20</font><textcolor>ffbcbcbc</textcolor><label>$INFO[ListItem.Property(LiveTV.Feeds)]</label></control>
        </control>
    </include>

    <include name="BingieLiveChannelGridArt">
        <control type="image"><left>8</left><right>8</right><top>8</top><bottom>8</bottom><texture>colors/color_black.png</texture></control>
        <control type="image"><left>30</left><right>30</right><top>12</top><bottom>45</bottom><texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture><aspectratio>keep</aspectratio></control>
    </include>

    <include name="Bingie_Main_Landscape_Title">
        <control type="image">
            <visible>!String.IsEqual(ListItem.Label,..)</visible>
            <left>8</left>
            <right>8</right>
            <bottom>8</bottom>
            <height>128</height>
            <texture>overlays/gradient_episodes.png</texture>
            <aspectratio>stretch</aspectratio>
            <colordiffuse>ffffffff</colordiffuse>
        </control>
        <control type="label">
            <visible>!String.IsEqual(ListItem.Label,..)</visible>
            <left>16</left>
            <right>16</right>
            <bottom>8</bottom>
            <height>38</height>
            <align>left</align>
            <aligny>center</aligny>
            <label>$VAR[ThumbListDetails]</label>
            <font>Reg20</font>
            <scroll>$PARAM[focused]</scroll>
            <textcolor>ffffffff</textcolor>
        </control>
    </include>
</includes>
