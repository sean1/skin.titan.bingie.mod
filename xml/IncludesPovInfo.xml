			</control>
			<control type="label">
				<left>16</left><width>334</width><height>55</height>
				<font>Reg26</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<scroll>$PARAM[focused]</scroll>
			</control>
		</definition>
	</include>
