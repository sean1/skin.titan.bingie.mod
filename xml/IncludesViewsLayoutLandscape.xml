<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <!-- THUMBS LAYOUT (SMALL LANDSCAPE) -->





	<!-- THUMBS LAYOUT (BINGIE LANDSCAPE) -->
    <include name="ThumbsViewBingieLayout">
        <include>ThumbsViewItemBingieLayout</include>
     </include>
    <include name="ThumbsViewItemBingieLayout">
        <param name="poster_fallback" default="false" />
        <definition>
        <control type="image">
            <!--thumb image-->
			<visible>!$EXP[IsNextPageListItem] + [!$PARAM[poster_fallback] | !String.IsEmpty(ListItem.Art(landscape))]</visible>
            <bordersize>8</bordersize>
            <texture background="true" diffuse="home/home_matte3.png" fallback="DefaultVideo.png">$VAR[LandscapeImage]</texture>
            <aspectratio scalediffuse="false" align="center" aligny="center">scale</aspectratio>
            <visible>![!String.IsEmpty(ListItem.Art(thumb)) + String.IsEqual(ListItem.Art(thumb),ListItem.Property(channellogo))]</visible>
            <visible>String.IsEmpty(ListItem.Property(defaultID))</visible>
        </control>
		<control type="image">
			<visible>$EXP[IsNextPageListItem]</visible>
			<left>8</left>
			<top>8</top>
			<right>8</right>
			<bottom>8</bottom>
			<texture background="true" fallback="DefaultFolder.png">$VAR[LandscapeImage]</texture>
			<aspectratio align="center" aligny="center">keep</aspectratio>
		</control>
        <include condition="$PARAM[poster_fallback]">LandscapeCardPosterFallback</include>
        <include condition="!$EXP[IsBingieViewsActive] + !Control.IsVisible(523)">ThumbsTagOverlayBingie</include>
        <include condition="!$EXP[IsBingieViewsActive]">New_Episodes_Tag_Overlay</include>
		<include>LandscapeCardTopGradient</include>
		<include>LandscapeCardCountryFlag</include>
		<include>LandscapeCardLanguageBadge</include>
		<include>LandscapeCardYearLabel</include>
		<include>LandscapeCardComingSoonLabel</include>
		<include>LandscapeCardRatingBadge</include>
        </definition>
	</include>

    <include name="LandscapeCardPosterFallback">
        <control type="group">
            <visible>String.IsEmpty(ListItem.Art(landscape))</visible>
            <control type="image">
                <bordersize>8</bordersize>
                <texture colordiffuse="ff252525">home/home_matte3.png</texture>
            </control>
            <control type="image">
                <left>8</left><top>8</top><right>8</right><bottom>8</bottom>
                <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                <aspectratio align="center" aligny="center">keep</aspectratio>
            </control>
        </control>
    </include>

    <include name="BingieSearchResultCard">
        <param name="focused" default="false" />
        <definition>
            <control type="group">
                <left>26</left><top>8</top><width>landscape_width</width><height>210</height>
                <control type="image">
                    <visible>$PARAM[focused] + Control.HasFocus(500)</visible>
                    <texture background="true">home/home_matte3.png</texture>
                    <include>thumbsborder_focused</include>
                </control>
                <include content="ThumbsViewItemBingieLayout">
                    <param name="poster_fallback" value="true" />
                </include>
                <include content="Bingie_Main_Landscape_Title">
                    <param name="focused" value="$PARAM[focused]" />
                </include>
                <control type="label">
                    <left>16</left><right>16</right><bottom>38</bottom><height>22</height>
                    <font>Reg18</font><textcolor>ffdddddd</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label>
                </control>
            </control>
        </definition>
    </include>

	<include name="LandscapeCardRatingBadge">
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + $EXP[HasBingieItemRating] + !String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<right>16</right>
			<top>12</top>
			<width>58</width>
			<height>30</height>
			<include>BingieListRatingBadge</include>
		</control>
	</include>

	<include name="LandscapeCardCountryFlag">
		<control type="image">
			<visible>$EXP[IsMovieOrTvShowListItem] + !String.IsEmpty(ListItem.Property(card_flag))</visible>
			<left>16</left>
			<top>14</top>
			<width>34</width>
			<height>26</height>
			<texture background="true">$INFO[ListItem.Property(card_flag)]</texture>
			<aspectratio>keep</aspectratio>
		</control>
	</include>

	<include name="LandscapeCardLanguageBadge">
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + String.IsEmpty(ListItem.Property(card_flag)) + !String.IsEmpty(ListItem.Property(card_language))</visible>
			<left>16</left>
			<top>14</top>
			<width>34</width>
			<height>26</height>
			<control type="label">
				<width>100%</width>
				<height>100%</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>flags_classic</font>
				<textcolor>ffffffff</textcolor>
				<label>$INFO[ListItem.Property(card_language)]</label>
			</control>
		</control>
	</include>

	<include name="LandscapeCardComingSoonLabel">
		<control type="label">
			<visible>String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<right>16</right>
			<top>8</top>
			<width>160</width>
			<height>38</height>
			<align>right</align>
			<aligny>center</aligny>
			<font>Reg20</font>
			<textcolor>ffffffff</textcolor>
			<label>Coming soon</label>
			<scroll>false</scroll>
		</control>
	</include>

	<include name="LandscapeCardTopGradient">
		<control type="image">
			<visible>$EXP[IsMovieOrTvShowListItem] | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.Property(DBTYPE),episode) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.Property(DBTYPE),season) | String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<left>8</left>
			<right>8</right>
			<top>8</top>
			<height>160</height>
			<texture flipy="true">overlays/gradient_episodes.png</texture>
			<aspectratio>stretch</aspectratio>
			<colordiffuse>ffffffff</colordiffuse>
		</control>
	</include>

	<include name="LandscapeCardYearLabel">
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + String.IsEmpty(ListItem.Property(card_flag)) + String.IsEmpty(ListItem.Property(card_language)) + [!String.IsEmpty(ListItem.Year) | !String.IsEmpty(ListItem.Property(year)) | !String.IsEmpty(ListItem.Property(year_range)) | !String.IsEmpty(ListItem.Property(pov_lite_year_range))] + !String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<left>16</left>
			<top>8</top>
			<width>150</width>
			<height>38</height>
			<control type="label">
				<width>100%</width>
				<height>100%</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Reg20</font>
				<textcolor>ffffffff</textcolor>
				<label>$VAR[CardYearRange]</label>
			</control>
		</control>
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + [!String.IsEmpty(ListItem.Property(card_flag)) | !String.IsEmpty(ListItem.Property(card_language))] + [!String.IsEmpty(ListItem.Year) | !String.IsEmpty(ListItem.Property(year)) | !String.IsEmpty(ListItem.Property(year_range)) | !String.IsEmpty(ListItem.Property(pov_lite_year_range))] + !String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<left>58</left>
			<top>8</top>
			<width>150</width>
			<height>38</height>
			<control type="label">
				<width>100%</width>
				<height>100%</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Reg20</font>
				<textcolor>ffffffff</textcolor>
				<label>$VAR[CardYearRange]</label>
			</control>
		</control>
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + String.IsEmpty(ListItem.Property(card_flag)) + String.IsEmpty(ListItem.Property(card_language)) + [!String.IsEmpty(ListItem.Year) | !String.IsEmpty(ListItem.Property(year)) | !String.IsEmpty(ListItem.Property(year_range)) | !String.IsEmpty(ListItem.Property(pov_lite_year_range))] + String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<left>16</left>
			<top>8</top>
			<right>184</right>
			<height>38</height>
			<control type="label">
				<width>100%</width>
				<height>100%</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Reg20</font>
				<textcolor>ffffffff</textcolor>
				<label>$VAR[CardYearRange]</label>
				<scroll>true</scroll>
			</control>
		</control>
		<control type="group">
			<visible>$EXP[IsMovieOrTvShowListItem] + [!String.IsEmpty(ListItem.Property(card_flag)) | !String.IsEmpty(ListItem.Property(card_language))] + [!String.IsEmpty(ListItem.Year) | !String.IsEmpty(ListItem.Property(year)) | !String.IsEmpty(ListItem.Property(year_range)) | !String.IsEmpty(ListItem.Property(pov_lite_year_range))] + String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
			<left>58</left>
			<top>8</top>
			<right>184</right>
			<height>38</height>
			<control type="label">
				<width>100%</width>
				<height>100%</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Reg20</font>
				<textcolor>ffffffff</textcolor>
				<label>$VAR[CardYearRange]</label>
				<scroll>true</scroll>
			</control>
		</control>
	</include>



    <!-- LANDSCAPE LAYOUT -->

    <!-- TAG OVERLAYS -->
	<include name="LandscapeTagOverlayVisibility">
		<visible>false</visible>
	</include>
	<include name="ThumbsTagOverlayBingie">
		<control type="group">
			<visible>![[$EXP[IsTvShowDBType] | $EXP[IsMovieDBType]] + [$EXP[IsTVShowInLastEpisodes] | $EXP[IsNewMovie]]]</visible>
			<include condition="!Window.IsActive(Home) + !$EXP[IsBingieHubsActive] + !Control.IsVisible(523)">LandscapeTagOverlayVisibility</include>
			<control type="image">
				<!--Panel Ovelay-->
				<left>8</left>
				<right>8</right>
				<bottom>8</bottom>
				<height>128</height>
				<texture>overlays/gradient_episodes.png</texture>
				<aspectratio>stretch</aspectratio>
				<colordiffuse>ffffffff</colordiffuse>
			</control>
			<control type="label">
				<!--Label-->
				<left>16</left>
				<right>16</right>
				<bottom>8</bottom>
				<height>38</height>
				<align>left</align>
				<aligny>center</aligny>
				<label>$VAR[ThumbListDetails]</label>
				<font>Reg20</font>
				<scroll>false</scroll>
				<visible>!String.IsEqual(System.CurrentControl,ListItem.Label)</visible>
				<textcolor>ffffffff</textcolor>
			</control>
			<control type="label">
				<!--Label-->
				<left>16</left>
				<right>16</right>
				<bottom>8</bottom>
				<height>38</height>
				<align>left</align>
				<aligny>center</aligny>
				<label>$VAR[ThumbListDetails]</label>
				<font>Reg20</font>
				<scroll>true</scroll>
				<visible>String.IsEqual(System.CurrentControl,ListItem.Label)</visible>
				<textcolor>ffffffff</textcolor>
			</control>
		</control>
	</include>

    <!-- New Episodes Tag Overlay -->
    <include name="New_Episodes_Tag_Overlay">
        <control type="group">
			<visible>!$EXP[IsCategoryDBType]</visible>
            <visible>$EXP[IsTvShowDBType] + $EXP[IsTVShowInLastEpisodes]</visible>
            <width>100%</width>
            <height>30</height>
            <left>108</left>
            <bottom>7</bottom>
			<animation effect="slide" end="-15" time="0" condition="Control.IsVisible(523)">Conditional</animation>
            <control type="button">
                <width>150</width>
                <bottom>1</bottom>
				<height>121%</height>
                <onclick>noop</onclick>
                <align>center</align>
                <aligny>center</aligny>
                <font>Reg19</font>
                <textoffsety>1</textoffsety>
                <label>[B]$LOCALIZE[31007][/B]</label>
                <textcolor>ffffffff</textcolor>
				<focusedcolor>ffffffff</focusedcolor>
                <textoffsetx>5</textoffsetx>
                <texturefocus colordiffuse="ffe50914" border="10">diffuse/panel3.png</texturefocus>
                <texturenofocus colordiffuse="ffe50914" border="10">diffuse/panel3.png</texturenofocus>
            </control>
        </control>
    </include>

    <variable name="LandscapeImage">
		<value condition="!String.IsEmpty(ListItem.Art(thumb)) + [String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.Property(DBTYPE),episode)]">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb)) + String.IsEqual(ListItem.Property(DBTYPE),category)">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(season.landscape))">$INFO[ListItem.Art(season.landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.landscape))">$INFO[ListItem.Art(tvshow.landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart)) + !String.IsEmpty(ListItem.DBType)">$INFO[ListItem.Art(tvshow.fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(fanart)) + !String.IsEmpty(ListItem.DBType)">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Property(landscape))">$INFO[ListItem.Property(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Property(fanart))">$INFO[ListItem.Property(fanart)]</value>
		<value condition="String.IsEqual(ListItem.Label,..)">dialogs/filebrowser/DefaultFolderBack2.png</value>
        <value condition="[Container.Content(genres) | String.IsEqual(ListItem.DBTYPE,genre)] + String.Contains(ListItem.FolderPath,video)">$VAR[MovieGenreIconVarList]</value>
        <value condition="String.IsEmpty(ListItem.DBType) + String.IsEqual(ListItem.Property(DBTYPE),genre)">$VAR[BingieGenreIconVarList]</value>
        <value condition="String.IsEmpty(ListItem.DBType) + String.IsEqual(ListItem.Property(DBTYPE),categorie)">$VAR[CategoriesBricks]</value>
		<value condition="Container.Content(actors) + String.IsEmpty(ListItem.Art(thumb))">DefaultActorPoster.png</value>
		<value condition="Container.Content(directors) + String.IsEmpty(ListItem.Art(thumb))">DefaultActorPoster.png</value>
		<value condition="Container.Content(years)">DefaultYear.png</value>
		<value condition="Container.Content(countries)">DefaultCountry.png</value>
		<value condition="Container.Content(tags)">DefaultTags.png</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Icon)">$INFO[ListItem.Icon]</value>
    </variable>
</includes>
