<?xml version="1.0" encoding="utf-8"?>
<includes>
	<variable name="PovInfoMyListLabel">
		<value condition="String.IsEqual(Window(Home).Property(PovInfoMyListSaved),true)">Remove from My List</value>
		<value condition="String.IsEqual(Window(Home).Property(PovInfoMyListSaved),false)">Add to My List</value>
		<value>My List unavailable</value>
	</variable>
	<variable name="PovInfoCastLabel">
		<value condition="$EXP[PovInfoCastLoading]">$LOCALIZE[206] · Loading…</value>
		<value>$LOCALIZE[206]</value>
	</variable>
	<expression name="PovInfoPreviewFocused">Control.HasFocus(560) | Control.HasFocus(563)</expression>
	<variable name="PovInfoPagePreviewTitle">
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Label]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Label]</value>
	</variable>
	<variable name="PovInfoPagePreviewRating">
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Property(PovTMDBRating),TMDB ]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Property(PovTMDBRating),TMDB ]</value>
	</variable>
	<variable name="PovInfoPagePreviewYear">
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Property(year)]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Property(year)]</value>
	</variable>
	<expression name="PovInfoPreviewMetadataMatches">
		[Control.HasFocus(560) + !String.IsEmpty(Container(560).ListItem.Property(PovFocusIdentity)) + String.IsEqual(Window(Home).Property(PovFocusedMetaIdentity),Container(560).ListItem.Property(PovFocusIdentity))] |
		[Control.HasFocus(563) + !String.IsEmpty(Container(563).ListItem.Property(PovFocusIdentity)) + String.IsEqual(Window(Home).Property(PovFocusedMetaIdentity),Container(563).ListItem.Property(PovFocusIdentity))]
	</expression>
	<variable name="PovInfoPagePreviewDetails">
		<value condition="Control.HasFocus(560) + $EXP[PovInfoPreviewMetadataMatches] + !String.IsEmpty(Container(560).ListItem.Property(genre))">$INFO[Container(560).ListItem.Property(genre)]$INFO[Window(Home).Property(PovFocusedMainActors),[CR]]</value>
		<value condition="Control.HasFocus(560) + $EXP[PovInfoPreviewMetadataMatches] + !String.IsEmpty(Window(Home).Property(PovFocusedGenre))">$INFO[Window(Home).Property(PovFocusedGenre)]$INFO[Window(Home).Property(PovFocusedMainActors),[CR]]</value>
		<value condition="Control.HasFocus(560) + $EXP[PovInfoPreviewMetadataMatches]">$INFO[Window(Home).Property(PovFocusedMainActors)]</value>
		<value condition="Control.HasFocus(563) + $EXP[PovInfoPreviewMetadataMatches] + !String.IsEmpty(Container(563).ListItem.Property(genre))">$INFO[Container(563).ListItem.Property(genre)]$INFO[Window(Home).Property(PovFocusedMainActors),[CR]]</value>
		<value condition="Control.HasFocus(563) + $EXP[PovInfoPreviewMetadataMatches] + !String.IsEmpty(Window(Home).Property(PovFocusedGenre))">$INFO[Window(Home).Property(PovFocusedGenre)]$INFO[Window(Home).Property(PovFocusedMainActors),[CR]]</value>
		<value condition="Control.HasFocus(563) + $EXP[PovInfoPreviewMetadataMatches]">$INFO[Window(Home).Property(PovFocusedMainActors)]</value>
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Property(genre)]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Property(genre)]</value>
	</variable>
	<variable name="PovInfoPageFanart">
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Property(PovPreviewFanart)]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Property(PovPreviewFanart)]</value>
		<value>$INFO[Window(Home).Property(PovInfoFanart)]</value>
	</variable>
	<variable name="PovInfoPagePlot">
		<value condition="Control.HasFocus(560)">$INFO[Container(560).ListItem.Property(PovPreviewPlot)]</value>
		<value condition="Control.HasFocus(563)">$INFO[Container(563).ListItem.Property(PovPreviewPlot)]</value>
		<value>$INFO[Window(Home).Property(PovInfoPlot)]</value>
	</variable>
	<variable name="PovSeasonBrowserPath">
		<value condition="!String.IsEmpty(Window(Home).Property(PovInfoTmdb))">plugin://skin.titan.bingie.lite/?mode=build_season_list&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoTmdb)]</value>
		<value condition="!String.IsEmpty(Window(Home).Property(PovInfoPendingTmdb))">plugin://skin.titan.bingie.lite/?mode=build_season_list&amp;tmdb_id=$INFO[Window(Home).Property(PovInfoPendingTmdb)]</value>
	</variable>
	<variable name="PovSpotlightShowLogo">
		<value condition="!String.IsEmpty(Window(Home).Property(PovInfoLogo))">$INFO[Window(Home).Property(PovInfoLogo)]</value>
		<value>$INFO[Container(527).ListItem.Art(clearlogo)]</value>
	</variable>
	<variable name="PovSpotlightShowTitle">
		<value condition="!String.IsEmpty(Window(Home).Property(PovInfoTitle))">$INFO[Window(Home).Property(PovInfoTitle)]</value>
		<value>$INFO[Container(527).ListItem.TVShowTitle]</value>
	</variable>
	<variable name="PovSpotlightShowFanart">
		<value condition="!String.IsEmpty(Window(Home).Property(PovInfoFanart))">$INFO[Window(Home).Property(PovInfoFanart)]</value>
		<value>$INFO[Container(527).ListItemAbsolute(0).Art(fanart)]</value>
	</variable>
	<variable name="PovSpotlightSeasonLabel">
		<value condition="!String.IsEmpty(Window(1124).Property(PovSpotlightSelectedSeasonLabel))">$INFO[Window(1124).Property(PovSpotlightSelectedSeasonLabel)]</value>
		<value condition="!String.IsEmpty(Container(527).ListItemAbsolute(0).Label)">$INFO[Container(527).ListItemAbsolute(0).Label]</value>
		<value>$LOCALIZE[320207]</value>
	</variable>
	<variable name="PovSpotlightEpisodePath">
		<value condition="!String.IsEmpty(Window(1124).Property(PovSpotlightSelectedSeasonPath))">$INFO[Window(1124).Property(PovSpotlightSelectedSeasonPath)]</value>
		<value>$INFO[Container(527).ListItemAbsolute(0).FolderPath]</value>
	</variable>
	<variable name="PovSpotlightSeasonCount">
		<value condition="Integer.IsEqual(Container(5027).NumItems,1)">$INFO[Container(5027).NumItems,, $LOCALIZE[20452]]</value>
		<value>$INFO[Container(5027).NumItems,, $LOCALIZE[20453]]</value>
	</variable>
	<include name="PovSpotlightEpisodeCard">
		<param name="focused" default="false" />
		<definition>
			<control type="group">
				<width>landscape_width</width>
				<height>210</height>
				<control type="image">
					<visible>$PARAM[focused]</visible>
					<texture background="true">home/home_matte3.png</texture>
					<include>thumbsborder_focused</include>
				</control>
				<include>ThumbsViewItemBingieLayout</include>
				<control type="image">
					<left>8</left><right>8</right><bottom>8</bottom><height>128</height>
					<texture>overlays/gradient_episodes.png</texture>
					<aspectratio>stretch</aspectratio>
				</control>
				<control type="label">
					<left>16</left><width>150</width><top>11</top><height>30</height>
					<font>Reg18</font>
					<aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$VAR[View527SeasonEpisodeFormat]</label>
				</control>
				<control type="label">
					<visible>!String.IsEqual(ListItem.Property(card_coming_soon),true)</visible>
					<right>16</right><width>82</width><top>11</top><height>30</height>
					<font>Reg18</font>
					<align>right</align><aligny>center</aligny>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[ListItem.Duration(mins),,m]</label>
				</control>
				<control type="label">
					<left>16</left><right>16</right><bottom>12</bottom><height>30</height>
					<font>Reg22</font>
					<textcolor>ffffffff</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<scroll>$PARAM[focused]</scroll>
				</control>
				<control type="progress">
					<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
					<left>16</left><right>16</right><bottom>10</bottom><height>4</height>
					<texturebg colordiffuse="ff929699">diffuse/panel2.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="ffe50914">diffuse/panel2.png</midtexture>
					<righttexture />
					<info>ListItem.PercentPlayed</info>
				</control>
				<control type="image">
					<visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable</visible>
					<left>16</left><right>16</right><bottom>10</bottom><height>4</height>
					<texture colordiffuse="ffe50914">diffuse/panel2.png</texture>
				</control>
			</control>
		</definition>
	</include>
	<include name="PovSpotlightSeasonRow">
