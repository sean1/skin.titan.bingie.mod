<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <include name="NowPlayingBackground">
        <control type="group">
			<visible>Player.HasMedia + !Control.IsVisible(507) + String.IsEmpty(Window(Home).Property(BingieTrailerPreview))</visible>
			<include condition="Player.HasVideo">NowPlayingVideoBackground</include>

            <!--Background Overlay-->
			<include>DialogOverlay</include>
        </control>
    </include>

	<include name="NowPlayingVideoBackground">
		<control type="group">
			<visible>Player.HasVideo + String.IsEmpty(Window(Home).Property(BingieTrailerPreview))</visible>

            <!-- black background -->
            <control type="image">
                <include>FullscreenDimensions</include>
                <texture>colors/color_black.png</texture>
            </control>

			<control type="videowindow">
				<visible>String.IsEmpty(Window(Home).Property(BingieTrailerPreview))</visible>
				<include>FullscreenDimensions</include>
			</control>

		</control>
	</include>

	<include name="BingieRowTrailerPreviewWindow">
		<control type="group">
			<visible>Player.HasVideo + !String.IsEmpty(Window(Home).Property(BingieTrailerPreview))</visible>
			<top>0</top>
			<right>0</right>
			<width>1200</width>
			<height>675</height>
			<control type="image">
				<width>1200</width>
				<height>675</height>
				<texture>colors/color_black.png</texture>
			</control>
			<control type="videowindow">
				<width>1200</width>
				<height>675</height>
			</control>
			<control type="image">
				<width>1200</width>
				<height>675</height>
				<texture background="true" colordiffuse="$VAR[BingiePanelColor]" border="20">overlays/bingie_corner.png</texture>
			</control>
		</control>
	</include>

</includes>
