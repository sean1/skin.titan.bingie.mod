<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <zorder>2</zorder>
    <onload>SetFocus(200)</onload>
	<onload condition="![Skin.String(defaultosdbutton_video,203) + !Player.PauseEnabled] + ![[Skin.String(defaultosdbutton_video,202) | Skin.String(defaultosdbutton_video,203)] + !Player.SeekEnabled]">SetFocus($INFO[Skin.String(defaultosdbutton_video)])</onload>
    <onload condition="Skin.HasSetting(UseBingieOSD) + !Player.PauseEnabled">SetFocus(300)</onload>
    <onload condition="!Player.Paused + Skin.HasSetting(EnableAutoPauseOnOSD) + !Skin.HasSetting(EnableOSDInfo)">Pause</onload>
    <onload condition="Skin.HasSetting(OSDShowInfoOnPause) + !Skin.HasSetting(EnableOSDInfo)">Skin.ToggleSetting(EnableOSDInfo)</onload>
	<onload>ClearProperty(DialogMPAATopBar,home)</onload>
	<onload>ClearProperty(DisableOSDCast,Home)</onload>
	<onload>CancelAlarm(OpenMPAATopBar,silent)</onload>
	<onunload>AlarmClock(OpenMPAATopBar,SetProperty(DialogMPAATopBar,1,home),00:00,silent)</onunload>
    <controls>
		
        <!--OSD Panel-->
        <control type="group">
            <include>OSDButtonsModern</include>
            <include>HideOsdConditions</include>
		</control>
    </controls>
</window>
