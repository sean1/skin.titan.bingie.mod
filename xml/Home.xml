<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <menucontrol>900</menucontrol>

    <!-- Defaults -->
	<!-- BINGIE -->
    <onload>SetProperty(BingieHomeWidgetStage,3,Home)</onload>
    <onunload>ClearProperty(BingieHomeWidgetStage,Home)</onunload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <include>BingieViews_WindowOpen_Fade</include>

	<controls>
		<!-- Global Background -->
        <include>GlobalBackground</include>
        <control type="button" id="1000">
            <include>HiddenObject</include>
            <onfocus condition="String.IsEqual(Window(Home).Property(BingiePreviewReturnToMenu),true)">SetFocus(900)</onfocus>
            <onfocus condition="String.IsEqual(Window(Home).Property(BingiePreviewReturnToMenu),true)">ClearProperty(BingiePreviewReturnToMenu,Home)</onfocus>
            <onfocus condition="!String.IsEqual(Window(Home).Property(BingiePreviewReturnToMenu),true)">SetFocus(77777)</onfocus>
            <onleft>900</onleft>
            <onright>900</onright>
            <onback>900</onback>
        </control>

        <!-- Preload submenu for count calculations -->
        <include>hiddenSubmenu</include>

		<!-- NowPlaying Background -->
		<include>NowPlayingBackground</include>

		<!-- Home Screen -->
        <include>HomeBingie</include>

	</controls>
</window>
