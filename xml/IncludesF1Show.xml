<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="BingieF1Show">
        <control type="group">
            <visible>String.Contains(Container.FolderPath,mode=livetv.soccer) + String.IsEqual(Window(Home).Property(LiveTV.Sport),f1) + !Window.IsActive(virtualkeyboard)</visible>
            <control type="image"><width>1920</width><height>1080</height><texture>colors/color_black.png</texture><colordiffuse>ff101010</colordiffuse></control>
            <control type="image"><width>1920</width><height>300</height><texture background="true">livetv/f1.png</texture><aspectratio>scale</aspectratio></control>
            <control type="label"><left>138</left><top>65</top><width>1200</width><height>65</height><font>Bold45</font><textcolor>ffffffff</textcolor><label>FORMULA 1</label></control>
            <control type="label"><left>138</left><top>130</top><width>1200</width><height>35</height><font>Reg24</font><textcolor>ffdddddd</textcolor><label>RACES AND SESSIONS</label></control>
            <control type="button" id="9702">
                <left>1435</left><top>65</top><width>340</width><height>56</height><font>Reg26</font><textcolor>ffffffff</textcolor><focusedcolor>ffffffff</focusedcolor>
                <label>Season $INFO[Window(Home).Property(BingieF1.Season)]</label><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.f1_show_season)</onclick>
                <onleft>SetProperty(ShowViewSubMenu,show,Home)</onleft><onleft>9002</onleft><onright>9711</onright><ondown>9711</ondown><onup>9702</onup>
            </control>
            <control type="label"><left>138</left><top>315</top><width>1200</width><height>38</height><font>Bold26</font><textcolor>ffffffff</textcolor><label>RACES</label></control>
            <control type="list" id="9711">
                <left>138</left><top>365</top><width>1650</width><height>256</height><orientation>horizontal</orientation><preloaditems>2</preloaditems>
                <onup>9702</onup><ondown>9701</ondown><onleft condition="Integer.IsEqual(Container(9711).CurrentItem,1)">SetProperty(ShowViewSubMenu,show,Home)</onleft><onleft condition="Integer.IsEqual(Container(9711).CurrentItem,1)">9002</onleft>
                <onclick condition="!Container(9711).IsUpdating + !String.IsEmpty(Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9711).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season))">SetFocus(9701)</onclick>
                <itemlayout width="330" height="250"><include content="BingieF1RaceCard"><param name="focus" value="false" /></include></itemlayout>
                <focusedlayout width="330" height="250"><include content="BingieF1RaceCard"><param name="focus" value="true" /></include></focusedlayout>
                <content target="videos" browse="never">plugin://skin.titan.bingie.lite/?mode=livetv.f1_show_events&amp;year=$INFO[Window(Home).Property(BingieF1.Season)]&amp;revision=$INFO[Window(Home).Property(LiveTV.Sports.Fixtures.Acknowledged)]</content>
            </control>
            <control type="label"><left>138</left><top>390</top><width>1300</width><height>44</height><font>Reg24</font><textcolor>ffbcbcbc</textcolor><label>Loading races…</label><visible>Container(9711).IsUpdating + Integer.IsEqual(Container(9711).NumItems,0)</visible></control>
            <control type="label"><left>138</left><top>650</top><width>1500</width><height>42</height><font>Bold26</font><textcolor>ffffffff</textcolor><label>$INFO[Container(9711).ListItem.Property(F1.Event),, · SESSIONS]</label><scroll>true</scroll></control>
            <control type="list" id="9701">
                <left>138</left><top>710</top><width>1650</width><height>160</height><orientation>horizontal</orientation><preloaditems>2</preloaditems>
                <onup>9711</onup><ondown>9701</ondown><onleft condition="Integer.IsEqual(Container(9701).CurrentItem,1)">SetProperty(ShowViewSubMenu,show,Home)</onleft><onleft condition="Integer.IsEqual(Container(9701).CurrentItem,1)">9002</onleft>
                <onclick condition="!Container(9701).IsUpdating + !String.IsEmpty(Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.EventId),Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season)) + String.IsEqual(Container(9711).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season)) + !String.IsEmpty(Container(9701).ListItem.Property(F1.Action))">ActivateWindow(Videos,$ESCINFO[Container(9701).ListItem.FileNameAndPath],return)</onclick>
                <itemlayout width="260" height="120"><include content="BingieF1SessionCard"><param name="focus" value="false" /></include></itemlayout>
                <focusedlayout width="260" height="120"><include content="BingieF1SessionCard"><param name="focus" value="true" /></include></focusedlayout>
                <content target="videos" browse="never">plugin://skin.titan.bingie.lite/?mode=livetv.f1_show_sessions&amp;year=$INFO[Window(Home).Property(BingieF1.Season)]&amp;event_id=$INFO[Container(9711).ListItem.Property(F1.EventKey)]&amp;revision=$INFO[Window(Home).Property(LiveTV.Sports.Fixtures.Acknowledged)]</content>
            </control>
            <control type="label"><left>138</left><top>735</top><width>1200</width><height>44</height><font>Reg24</font><textcolor>ffbcbcbc</textcolor><label>Loading sessions…</label><visible>Container(9701).IsUpdating + Integer.IsEqual(Container(9701).NumItems,0) + !String.IsEmpty(Container(9711).ListItem.Property(F1.EventId))</visible></control>
            <control type="label"><left>138</left><top>900</top><width>1600</width><height>32</height><font>Reg20</font><textcolor>ffbcbcbc</textcolor><label>$INFO[Container(9701).ListItem.Property(F1.Description)]</label><scroll>true</scroll><visible>!Container(9701).IsUpdating + !String.IsEmpty(Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.EventId),Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season)) + String.IsEqual(Container(9711).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season))</visible></control>
        </control>
    </include>
    <include name="BingieF1RaceCard">
        <control type="group"><width>318</width><height>238</height>
            <control type="image"><visible>$PARAM[focus]</visible><texture background="true">home/home_matte3.png</texture><colordiffuse>ffffffff</colordiffuse><include>thumbsborder_focused</include></control>
            <control type="image"><left>8</left><right>8</right><top>8</top><bottom>8</bottom><texture>livetv/f1-card-circuit.jpg</texture><aspectratio>scale</aspectratio></control>
            <control type="image"><left>8</left><right>8</right><top>8</top><height>160</height><texture flipy="true">overlays/gradient_episodes.png</texture><aspectratio>stretch</aspectratio></control>
            <control type="image"><left>8</left><right>8</right><bottom>8</bottom><height>128</height><texture>overlays/gradient_episodes.png</texture><aspectratio>stretch</aspectratio></control>
            <control type="label"><left>16</left><top>8</top><width>120</width><height>38</height><font>Reg20</font><textcolor>ffffffff</textcolor><aligny>center</aligny><label>$INFO[ListItem.Property(F1.CardWhen)]</label></control>
            <control type="label"><right>16</right><top>8</top><width>130</width><height>38</height><font>Reg20</font><textcolor>ffffffff</textcolor><align>right</align><aligny>center</aligny><label>$INFO[ListItem.Property(F1.Status)]</label></control>
            <control type="label"><left>16</left><right>16</right><bottom>8</bottom><height>38</height><font>Reg20</font><textcolor>ffffffff</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label><scroll>$PARAM[focus]</scroll></control>
        </control>
    </include>
    <include name="BingieF1SessionCard">
        <control type="group"><visible>!Container(9701).IsUpdating + !String.IsEmpty(Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.EventId),Container(9711).ListItem.Property(F1.EventId)) + String.IsEqual(Container(9701).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season)) + String.IsEqual(Container(9711).ListItem.Property(F1.Year),Window(Home).Property(BingieF1.Season))</visible><width>248</width><height>108</height>
            <control type="image"><width>248</width><height>108</height><texture>colors/color_white.png</texture><colordiffuse>ff202020</colordiffuse></control>
            <control type="image"><width>248</width><height>108</height><texture border="10">bingie/border/default_button_fo_4.png</texture><visible>$PARAM[focus]</visible></control>
            <control type="label"><left>14</left><right>14</right><top>14</top><height>33</height><font>Reg24</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Property(F1.Session)]</label><scroll>$PARAM[focus]</scroll></control>
            <control type="label"><left>14</left><right>14</right><top>48</top><height>24</height><font>Reg20</font><textcolor>ffbcbcbc</textcolor><label>$INFO[ListItem.Property(F1.ShortWhen)]</label><scroll>$PARAM[focus]</scroll></control>
            <control type="label"><left>14</left><right>14</right><top>78</top><height>24</height><font>Reg20</font><textcolor>ffffffff</textcolor><label>$INFO[ListItem.Property(F1.Status)]</label></control>
        </control>
    </include>
</includes>
