								<posy>29</posy>
								<left>377</left>
								<width>155</width>
								<height>8</height>
								<texturebg colordiffuse="ff929699" border="0">diffuse/panel2.png</texturebg>
								<lefttexture/>
								<midtexture colordiffuse="ffe50914" border="4">diffuse/panel2.png</midtexture>
								<righttexture/>
								<info>Container(5050).ListItem.PercentPlayed</info>
							</control>
						</control>

						<!-- fixed frame -->
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>ControlGroup(8000).HasFocus() + !ControlGroup(700).HasFocus()</visible>
							<animation effect="fade" start="0" end="100" time="0" delay="250">Visible</animation>
							<width>550</width>
							<height>65</height>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/default_button_fo_4.png</texture>
							<animation effect="slide" end="0,65" time="150" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="150" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="150" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="150" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
					<control type="group">
						<animation effect="fade" time="200" delay="300">Visible</animation>
						<visible allowhiddenfocus="true">!String.IsEmpty(Window(Home).Property(showrateoptions)) | Window.IsVisible(1151) | Window.IsVisible(1152)</visible>
						<!-- fixed frame -->
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + Control.HasFocus(7001)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframefo_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + !Control.HasFocus(7001)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframenf_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + Control.HasFocus(7003)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<left>285</left>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframefo_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + !Control.HasFocus(7003)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<left>285</left>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframenf_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<!-- like / dislike / reset - user rating -->
						<control type="grouplist" id="700">
							<animation effect="fade" time="150">Visible</animation>
							<visible allowhiddenfocus="true">!String.IsEmpty(Window(Home).Property(showrateoptions)) | Window.IsVisible(1151) | Window.IsVisible(1152)</visible>
							<top>5</top>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 3)">Conditional</animation>
							<height>65</height>
							<width>800</width>
							<orientation>horizontal</orientation>
							<usecontrolcoords>true</usecontrolcoords>
							<itemgap>0</itemgap>
							<onleft>noop</onleft>
							<onright>noop</onright>
							<onup>ClearProperty(showrateoptions,Home)</onup>
							<onup>8000</onup>
							<onup>ClearProperty(ratebuttonposition,Home)</onup>
							<ondown>ClearProperty(showrateoptions,Home)</ondown>
							<ondown>8000</ondown>
							<ondown>ClearProperty(ratebuttonposition,Home)</ondown>
							<onback>ClearProperty(showrateoptions,Home)</onback>
							<onback>ClearProperty(ratebuttonposition,Home)</onback>

							<control type="radiobutton" id="7001">
								<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
								<width>265</width>
								<height>65</height>
								<font>Reg30</font>
								<texturefocus>-</texturefocus>
								<texturenofocus>-</texturenofocus>
