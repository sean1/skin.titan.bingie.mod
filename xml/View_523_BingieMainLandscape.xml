<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <include name="View_523_Bingie_Main_Landscape">
        <control type="group">
            <include>FullscreenDimensions</include>
            <visible>Control.IsVisible(523)</visible>
            <include>animation_view_change</include>

            <include content="Bingie_Main_Spotlight_Section">
                <param name="id" value="523" />
            </include>

            <!-- View 523 -->
            <control type="group">
				<visible>!Window.IsActive(DialogVideoInfo.xml)</visible>
				<include>Animation_Right_Home</include>
                <left>131</left>
                <top>660</top>
                <width>1660</width>
                <!-- Content Header -->
                <control type="label">
                    <width>100%</width>
                    <height>40</height>
					<posx>7</posx>
					<top>11</top>
                    <font>Bold31</font>
                    <align>left</align>
                    <textcolor>ffffffff</textcolor>
                    <label>$VAR[BingieMainContentHeader] $INFO[Window(Home).Property(TVshows.Count),(,)]</label>
                    <visible>!false + Integer.IsGreater(Container(523).NumItems,0)</visible>
					<visible>String.IsEqual(Container.FolderPath, videodb://tvshows/titles/)</visible>
                </control>
				<control type="label">
                    <width>100%</width>
                    <height>40</height>
					<posx>7</posx>
					<top>11</top>
                    <font>Bold31</font>
                    <align>left</align>
                    <textcolor>ffffffff</textcolor>
                    <label>$VAR[BingieMainContentHeader] $INFO[Window(Home).Property(Movies.Count),(,)]</label>
                    <visible>!false + Integer.IsGreater(Container(523).NumItems,0)</visible>
					<visible>String.IsEqual(Container.FolderPath, videodb://movies/titles/)</visible>
                </control>

                <include content="Bingie_Main_Landscape_View">
                    <param name="containerType" value="panel" />
                </include>
            </control>

		   <!-- scrollbar -->
            <control type="group">
                <control type="scrollbar" id="60">
					<texturesliderbackground border="5" colordiffuse="ff141414">scrollbar/texturesliderbar_small.png</texturesliderbackground>
					<texturesliderbar colordiffuse="ff646464" border="5">scrollbar/texturesliderbar_small.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="ffcc0000" border="5">scrollbar/texturesliderbar_small.png</texturesliderbarfocus>
					<textureslidernib colordiffuse="ff646464">scrollbar/texturesliderbar_nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="ffcc0000">scrollbar/texturesliderbar_nib.png</textureslidernibfocus>
                    <visible>Control.IsVisible(523) + Integer.IsGreater(Container.NumItems,0)</visible>
                    <width>10</width>
					<height>461</height>
                    <right>0</right>
                    <bottom>0</bottom>
                    <onleft>523</onleft>
                    <orientation>vertical</orientation>
                    <animation effect="fade" start="0" end="100" time="400" condition="[Control.HasFocus(60) | Container.Scrolling | false]">Conditional</animation>
                    <animation effect="fade" start="100" end="0" time="400" condition="![Control.HasFocus(60) | Container.Scrolling | false]">Conditional</animation>
                </control>
            </control>
        </control>
    </include>

    <!-- Container -->
    <include name="Bingie_Main_Landscape_View">
        <control type="$PARAM[containerType]" id="523">
			<visible>!Container.Content(episodes) + !Container.Content(seasons)</visible>
            <visible>
                ![String.Contains(Container.FolderPath,mode=navigator.genres) | String.Contains(Container.FolderPath,mode=navigator.search) |
                String.Contains(Container.FolderPath,mode=search_history)]
            </visible>
            <viewtype label="31018">panel</viewtype>
            <focusedposition>0</focusedposition>
            <top>51</top>
            <width>1668</width>
            <height>470</height>
            <orientation>vertical</orientation>
            <itemgap>0</itemgap>
            <preloaditems>4</preloaditems>
            <pagecontrol>60</pagecontrol>
            <include>ScrollTime</include>
            <onright condition="false + Control.IsVisible(6002)">6000</onright>
            <onright condition="false + !Control.IsVisible(6002)">noop</onright>
            <onright condition="!false">60</onright>
			<onleft>9000</onleft>
            <onup>523</onup>
            <ondown>523</ondown>
            <itemlayout height="193" width="333">
                <control type="group">
                    <width>335</width>
                    <height>195</height>
                    <include>ThumbsViewItemBingieLayout</include>
                    <include>Bingie_Main_Landscape_Title</include>
                </control>
            </itemlayout>
            <focusedlayout height="193" width="333">
                <control type="group">
                    <width>335</width>
                    <height>195</height>
                    <control type="image">
                        <!--Panel Normal-->
                        <texture background="true">home/home_matte3.png</texture>
                        <colordiffuse>ffffffff</colordiffuse>
                        <include>thumbsborder_focused</include>
                    </control>
                    <include>ThumbsViewItemBingieLayout</include>
                    <include>Bingie_Main_Landscape_Title</include>
                    <animation effect="zoom" end="103,103" center="auto" time="100" condition="false + false">focus</animation>
                </control>
				<!--Top 250 1-->
				<control type="image">
				<visible>!Container.Content(episodes) + !Container.Content(seasons) + !String.IsEmpty(Control.GetLabel(8231)) + !false + !false + !false |
				!Container.Content(episodes) + !Container.Content(seasons) + !String.IsEmpty(Control.GetLabel(8231)) + !false + false + !false |
				!Container.Content(episodes) + !Container.Content(seasons) + !String.IsEmpty(Control.GetLabel(8231)) + !false + !false + false
				</visible>
				<posy>8</posy>
				<left>8</left>
                <height>60</height>
                <width>50</width>
				<aspectratio>keep</aspectratio>
                <texture>bingie/top250p.png</texture>
		        </control>
				<!--Top 250 2-->
				<control type="image">
				<visible>!Container.Content(episodes) + !Container.Content(seasons) + !String.IsEmpty(Control.GetLabel(8231)) + !false + false + false</visible>
				<posy>5</posy>
				<left>3</left>
                <height>60</height>
                <width>50</width>
				<aspectratio>keep</aspectratio>
                <texture>bingie/top250p.png</texture>
		        </control>
            </focusedlayout>
        </control>
    </include>

    <include name="Bingie_Main_Landscape_Title">
        <control type="image">
            <visible>!String.IsEqual(ListItem.Label,..)</visible>
            <bordersize>8</bordersize>
            <bottom>0</bottom>
            <height>78</height>
            <texture>diffuse/home_overlay_bingie.png</texture>
            <colordiffuse>dd000000</colordiffuse>
        </control>
        <control type="label">
            <visible>!String.IsEqual(ListItem.Label,..)</visible>
            <left>16</left>
            <right>16</right>
            <bottom>18</bottom>
            <height>40</height>
            <align>left</align>
            <aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
            <font>Reg20</font>
            <textcolor>ffffffff</textcolor>
        </control>
    </include>
</includes>
