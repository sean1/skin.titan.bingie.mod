<includes>

	<!-- Bingie Info -->
	<include name="BingieInfo">
		<control type="group">
			<include>GlobalBackground</include>
			<!-- Base BG -->
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture background="true" colordiffuse="$VAR[BingiePanelColor]">diffuse/panel2.png</texture>
			</control>
			<!-- Dialog Info -->
			<control type="group">
				<animation effect="fade" start="0" end="100" time="200">Visible</animation>
				<visible>!ControlGroup(6000).HasFocus()</visible>
				<visible>String.IsEmpty(Window(Home).Property(Recommendations.IsLoading))</visible>
				<visible>!String.IsEqual(ListItem.Property(item.type),person)</visible>
				<!-- Hidden My Rating Button -->
				<control type="button" id="7">
					<include>HiddenObject</include>
				</control>

				<!-- Hidden List to Get First/Next Episode -->
				<control type="list" id="5050">
                    <visible allowhiddenfocus="true">!String.IsEmpty(ListItem.DBID) + String.IsEqual(ListItem.DBTYPE,tvshow)</visible>
                    <visible>Integer.IsGreater(Container(5050).NumItems,0) + !Container(5050).IsUpdating</visible>
					<left>-100</left>
					<top>-100</top>
					<preloaditems>1</preloaditems>
					<itemlayout/>
					<focusedlayout/>
					<content sortorder="ascending" sortby="playcount" limit="1">$VAR[InfoDialogNextUpContent]</content>
				</control>

				<!-- Full fanart behind all More Info content. -->
				<include content="BingieSpotlightFullImage">
					<param name="visibility" value="![Player.HasVideo + ![VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)]]" />
					<param name="image" value="$VAR[fanartBackground]" />
				</include>
				<!-- Darken the title and action column, then fade into the description column. -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1050</width>
					<height>100%</height>
					<texture background="true">overlays/gradient_videoinfo.png</texture>
					<colordiffuse>e6000000</colordiffuse>
				</control>

				<!-- Native Kodi cast row populated by POV metadata -->
				<control type="label">
					<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
					<left>126</left>
					<top>680</top>
					<width>1668</width>
					<height>45</height>
					<font>Bold31</font>
					<textcolor>ffffffff</textcolor>
					<label>$LOCALIZE[206]</label>
				</control>
				<control type="panel" id="50">
					<visible allowhiddenfocus="true">Integer.IsGreater(Container(50).NumItems,0)</visible>
					<left>-2000</left>
					<top>-2000</top>
					<width>1</width>
					<height>1</height>
					<orientation>horizontal</orientation>
					<preloaditems>4</preloaditems>
					<scrolltime tween="quadratic">400</scrolltime>
					<itemlayout width="238" height="320">
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" diffuse="diffuse/poster3.png" fallback="DefaultActorPoster.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="true" align="center" aligny="top">scale</aspectratio>
							<bordersize>8</bordersize>
						</control>
						<control type="image">
							<left>8</left>
							<bottom>10</bottom>
							<width>214</width>
							<height>82</height>
							<texture>diffuse/poster_tag2.png</texture>
							<colordiffuse>dd000000</colordiffuse>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>47</bottom>
							<height>30</height>
							<font>Reg22</font>
							<textcolor>ffffffff</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>18</bottom>
							<height>28</height>
							<font>Reg20</font>
							<textcolor>a6ffffff</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout width="238" height="320">
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" diffuse="diffuse/poster3.png" fallback="DefaultActorPoster.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="true" align="center" aligny="top">scale</aspectratio>
							<bordersize>8</bordersize>
						</control>
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" border="12">bingie/border/poster_fo_4.png</texture>
						</control>
						<control type="image">
							<left>8</left>
							<bottom>10</bottom>
							<width>214</width>
							<height>82</height>
							<texture>diffuse/poster_tag2.png</texture>
							<colordiffuse>dd000000</colordiffuse>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>47</bottom>
							<height>30</height>
							<font>Reg22</font>
							<textcolor>ffffffff</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>18</bottom>
							<height>28</height>
							<font>Reg20</font>
							<textcolor>a6ffffff</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</focusedlayout>
				</control>
				<!-- Control 50 is reserved by Kodi, so render its cast data in a normal panel that can route mouse and keyboard selection through POV. -->
				<control type="panel" id="550">
					<visible allowhiddenfocus="true">Integer.IsGreater(Container(50).NumItems,0)</visible>
					<left>126</left>
					<top>730</top>
					<width>1668</width>
					<height>330</height>
					<orientation>horizontal</orientation>
					<preloaditems>4</preloaditems>
					<scrolltime tween="quadratic">400</scrolltime>
					<onup>8000</onup>
					<ondown>550</ondown>
					<itemlayout width="238" height="320">
						<include content="PovCastCard">
							<param name="focused" value="false" />
						</include>
					</itemlayout>
					<focusedlayout width="238" height="320">
						<include content="PovCastCard">
							<param name="focused" value="true" />
						</include>
					</focusedlayout>
					<content>
						<include content="PovCastItems" />
					</content>
				</control>

				<!-- Additional Info Overlay -->
				<control type="image">
					<visible>!String.IsEmpty(Window.Property(AdditionalInfo)) + !String.IsEqual(Window.Property(AdditionalInfo),set)</visible>
					<width>100%</width>
					<height>100%</height>
					<texture background="true" colordiffuse="$VAR[BingiePanelColor]">colors/color_white.png</texture>
					<animation effect="fade" start="0" end="100" time="300" condition="!Player.HasVideo + !false">Visible</animation>
					<animation effect="fade" start="0" end="60" time="300" condition="!Player.HasVideo + false">Visible</animation>
					<animation effect="fade" start="0" end="70" time="300" condition="Player.HasVideo">Visible</animation>
				</control>

				<!-- Dialog Info Details -->
				<control type="grouplist">
                    <width>1760</width>
                    <include>BingieLeftDefs</include>
                    <top>10</top>
                    <orientation>vertical</orientation>
                    <usecontrolcoords>true</usecontrolcoords>
                    <itemgap>10</itemgap>
				<control type="grouplist">
					<include>Animation_Right_Delay_2</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<control type="image" id="90005">
						<height>190</height>
						<width>490</width>
						<align>left</align>
						<aspectratio align="center" aligny="center">keep</aspectratio>
						<texture background="true" fallback="colors/color_transparent.png">$VAR[BingieInfoClearlogo]</texture>
					</control>
					<!-- Movie Title with no Clearlogo -->
					<control type="textbox" id="90006">
						<visible>String.EndsWith(Control.GetLabel(90005),color_transparent.png)</visible>
						<top>-189</top>
						<height>184</height>
						<width max="650">auto</width>
						<font>Title</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieInfoLabel]</label>
						<include condition="$PARAM[genre_adjust]">Bingie_TextTitle_Adjust_Genre_Anim</include>
						<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
					</control>
					<control type="group">
						<top>-2</top>
						<width>1000</width>
						<height>35</height>
						<include>SpotlightRowDetails</include>
					</control>
				</control>
				<control type="grouplist">
					<top>228</top>
					<include>Animation_Right_Delay</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<!-- Media File Location -->
					<!-- Sublabel -->
					<control type="label" id="823">
						<visible>!String.IsEmpty(Control.GetLabel(823))</visible>
						<visible>!$EXP[IsMovieDBType]</visible>
						<animation effect="fade" start="100" end="0" time="200" condition="!String.IsEmpty(Window.Property(AdditionalInfo))">Conditional</animation>
						<top>34</top>
						<height>12</height>
						<width>100%</width>
						<font>Plots</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieDialogEpisodeInfoLabel]</label>
					</control>

					<!-- Plot with a 50%-opaque background for readability over light fanart. -->
					<control type="group">
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast) | String.IsEqual(Window.Property(AdditionalInfo),plot)">Conditional</animation>
						<left>620</left>
						<top>19</top>
						<height>300</height>
						<width>1130</width>
						<control type="image">
							<left>-10</left>
							<top>-10</top>
							<width>1150</width>
							<height>320</height>
							<texture colordiffuse="80ffffff">colors/color_black.png</texture>
						</control>
						<control type="textbox">
							<visible>[String.IsEmpty(ListItem.Set) + !false] | false</visible>
							<width>1130</width>
							<height>300</height>
							<textcolor>b3ffffff</textcolor>
							<align>left</align>
							<font>Plots</font>
							<label>$VAR[BingieDialogInfoPlot]</label>
							<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
						</control>
						<control type="textbox">
							<visible>[!String.IsEmpty(ListItem.Set) + !false]</visible>
							<width>1130</width>
							<height>300</height>
							<textcolor>b3ffffff</textcolor>
							<align>left</align>
							<font>Plots</font>
							<label>$VAR[BingieDialogInfoPlot]</label>
							<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
						</control>
					</control>

					<!-- buttons -->
					<control type="group">
						<top>-310</top>
						<width>550</width>
						<posx>1</posx>
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo), plot) | String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast)">Conditional</animation>
						<animation effect="slide" start="0,0" end="0,41" time="0" delay="0" condition="String.IsEqual(Window.Property(AdditionalInfo),set)">Conditional</animation>
						<!-- progress bar for resume buttons -->
						<control type="group">

							<control type="progress">
								<visible>Control.HasFocus(90) | [Control.HasFocus(51) + Container(5050).ListItem.IsResumable]</visible>
								<animation effect="fade" start="0" end="100" time="0" delay="125">Visible</animation>
								<posy>29</posy>
								<left>377</left>
								<width>155</width>
								<height>8</height>
								<texturebg colordiffuse="ff929699" border="0">diffuse/panel2.png</texturebg>
								<lefttexture/>
								<midtexture colordiffuse="ffe50914" border="4">diffuse/panel2.png</midtexture>
								<righttexture/>
								<info>ListItem.PercentPlayed</info>
							</control>
							<control type="progress">
								<visible>Control.IsVisible(5050) + String.IsEqual(ListItem.dbtype,tvshow) + [Control.HasFocus(51) + Container(5050).ListItem.IsResumable]</visible>
								<animation effect="fade" start="0" end="100" time="0" delay="125">Visible</animation>
								<posy>29</posy>
								<left>377</left>
								<width>155</width>
								<height>8</height>
								<texturebg colordiffuse="ff929699" border="0">diffuse/panel2.png</texturebg>
								<lefttexture/>
								<midtexture colordiffuse="ffe50914" border="4">diffuse/panel2.png</midtexture>
								<righttexture/>
								<info>Container(5050).ListItem.PercentPlayed</info>
							</control>
						</control>

					<control type="group">
						<animation effect="fade" time="200" delay="300">Visible</animation>
						<visible allowhiddenfocus="true">!String.IsEmpty(Window(Home).Property(showrateoptions)) | Window.IsVisible(1151) | Window.IsVisible(1152)</visible>
						<!-- fixed frame -->
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + Control.HasFocus(7001)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframefo_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + !Control.HasFocus(7001)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframenf_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + Control.HasFocus(7003)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<left>285</left>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframefo_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<control type="image">
							<visible>Window.IsActive(movieinformation)</visible>
							<visible>!ControlGroup(8000).HasFocus() + ControlGroup(700).HasFocus() + !Control.HasFocus(7003)</visible>
							<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
							<width>265</width>
							<height>65</height>
							<left>285</left>
							<texture border="10" background="true" colordiffuse="ffffffff">bingie/border/slimframenf_4.png</texture>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" tween="sine" easing="out" condition="Integer.IsGreater(Container(8000).Position, 3)">Conditional</animation>
						</control>
						<!-- like / dislike / reset - user rating -->
						<control type="grouplist" id="700">
							<animation effect="fade" time="150">Visible</animation>
							<visible allowhiddenfocus="true">!String.IsEmpty(Window(Home).Property(showrateoptions)) | Window.IsVisible(1151) | Window.IsVisible(1152)</visible>
							<top>5</top>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 0)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 1)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 2)">Conditional</animation>
							<animation effect="slide" end="0,65" time="0" condition="Integer.IsGreater(Window(Home).Property(ratebuttonposition), 3)">Conditional</animation>
							<height>65</height>
							<width>800</width>
							<orientation>horizontal</orientation>
							<usecontrolcoords>true</usecontrolcoords>
							<itemgap>0</itemgap>
							<onleft>noop</onleft>
							<onright>noop</onright>
							<onup>ClearProperty(showrateoptions,Home)</onup>
							<onup>8000</onup>
							<onup>ClearProperty(ratebuttonposition,Home)</onup>
							<ondown>ClearProperty(showrateoptions,Home)</ondown>
							<ondown>8000</ondown>
							<ondown>ClearProperty(ratebuttonposition,Home)</ondown>
							<onback>ClearProperty(showrateoptions,Home)</onback>
							<onback>ClearProperty(ratebuttonposition,Home)</onback>

							<control type="radiobutton" id="7001">
								<animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
								<width>265</width>
								<height>65</height>
								<font>Reg30</font>
								<texturefocus>-</texturefocus>
								<texturenofocus>-</texturenofocus>
								<alttexturefocus>-</alttexturefocus>
								<alttexturenofocus>-</alttexturenofocus>
								<radioposx>118</radioposx>
								<radioposy>12</radioposy>
								<radiowidth>30</radiowidth>
								<radioheight>30</radioheight>
								<textureradioonfocus/>
								<textureradioofffocus colordiffuse="ffffffff">bingie/rate/thumb_up_fo.png</textureradioofffocus>
								<textureradioonnofocus/>
								<textureradiooffnofocus colordiffuse="a6ffffff">bingie/rate/thumb_up_nf.png</textureradiooffnofocus>
