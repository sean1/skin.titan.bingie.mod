<?xml version="1.0" encoding="utf-8"?>
<includes>
	<include name="PovActorPage">
		<control type="group">
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>

			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture>colors/color_black.png</texture>
			</control>
			<include>BingieRowTrailerPreviewWindow</include>
			<include content="BingieSpotlightCornerImage">
				<param name="visibility" value="String.IsEqual(Window(Home).Property(PovActorReady),true) + [!Player.HasVideo | [!String.IsEmpty(Window(Home).Property(BingieTrailerPreview)) + String.IsEmpty(Window(Home).Property(BingieTrailerPreviewReady))]]" />
				<param name="image" value="$VAR[PovActorPageBackdrop]" />
			</include>

				<control type="label">
					<left>138</left>
					<top>88</top>
					<width>540</width>
					<height>72</height>
					<font>Bold50</font>
					<textcolor>ffffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovActorName)]</label>
				</control>
				<control type="label">
					<visible>String.IsEqual(Window(Home).Property(PovActorReady),true) + !String.IsEmpty(Window(Home).Property(PovActorLifespan))</visible>
					<left>138</left>
					<top>170</top>
					<width>540</width>
					<height>34</height>
					<font>Reg24</font>
					<textcolor>d9ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovActorLifespan)]</label>
				</control>
				<control type="textbox">
					<visible>String.IsEqual(Window(Home).Property(PovActorReady),true) + !String.IsEmpty(Window(Home).Property(PovActorBirthplace))</visible>
					<left>138</left>
					<top>210</top>
					<width>540</width>
					<height>70</height>
					<font>Reg24</font>
					<textcolor>a6ffffff</textcolor>
					<label>$INFO[Window(Home).Property(PovActorBirthplace),Born in ]</label>
				</control>
			<control type="textbox">
				<visible>String.IsEqual(Window(Home).Property(PovActorReady),true) + !String.IsEmpty(Window(Home).Property(PovActorBiography))</visible>
				<left>138</left>
				<top>300</top>
				<width>540</width>
				<height>280</height>
				<font>Reg24</font>
				<textcolor>e6ffffff</textcolor>
				<align>left</align>
				<aligny>top</aligny>
				<label>$INFO[Window(Home).Property(PovActorBiography)]</label>
				<autoscroll delay="9000" time="2500" repeat="6500">true</autoscroll>
			</control>
			<control type="button" id="600">
				<visible allowhiddenfocus="true">true</visible>
				<left>-100</left>
				<top>-100</top>
				<width>1</width>
				<height>1</height>
				<onfocus condition="String.IsEqual(Window(Home).Property(PovActorReady),true) + String.IsEqual(Window(Home).Property(PovActorHasMovies),true)">SetFocus(610)</onfocus>
				<onfocus
					condition="String.IsEqual(Window(Home).Property(PovActorReady),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasMovies),true)
						+ String.IsEqual(Window(Home).Property(PovActorHasTVShows),true)">SetFocus(620)</onfocus>
				<onfocus
					condition="String.IsEqual(Window(Home).Property(PovActorReady),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasMovies),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasTVShows),true)
						+ String.IsEqual(Window(Home).Property(PovActorHasDirected),true)">SetFocus(630)</onfocus>
				<onfocus
					condition="String.IsEqual(Window(Home).Property(PovActorReady),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasMovies),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasTVShows),true)
						+ !String.IsEqual(Window(Home).Property(PovActorHasDirected),true)">SetFocus(699)</onfocus>
				<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
			</control>

			<!-- Keep every available credit shelf in one Home-style vertical stack. -->
			<control type="grouplist">
				<left>126</left>
				<top>650</top>
				<width>1668</width>
				<height>831</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<itemgap>2</itemgap>
				<animation effect="slide" end="0,-277" time="300" tween="cubic" easing="inout" condition="[Control.HasFocus(620) | Control.HasFocus(630)] + $EXP[PovActorHasCurrentMovies]">Conditional</animation>
				<animation effect="slide" end="0,-277" time="300" tween="cubic" easing="inout" condition="Control.HasFocus(630) + $EXP[PovActorHasCurrentTVShows]">Conditional</animation>

				<control type="group">
					<visible>String.IsEqual(Window(Home).Property(PovActorHasMovies),true)</visible>
					<width>1668</width>
					<height>275</height>
					<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(620) | Control.HasFocus(630)">Conditional</animation>
					<control type="label">
						<visible>$EXP[PovActorHasCurrentMovies]</visible>
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>Movies</label>
					</control>
					<control type="panel" id="610">
						<visible allowhiddenfocus="true">true</visible>
						<enable>$EXP[PovActorHasCurrentMovies]</enable>
						<onfocus condition="System.HasAlarm(PovActorFocus)">CancelAlarm(PovActorFocus,silent)</onfocus>
						<top>55</top>
						<width>1668</width>
						<height>220</height>
						<orientation>horizontal</orientation>
						<preloaditems>2</preloaditems>
						<scrolltime tween="quadratic">350</scrolltime>
						<onup>610</onup>
						<ondown condition="$EXP[PovActorHasCurrentTVShows]">620</ondown>
						<ondown condition="!$EXP[PovActorHasCurrentTVShows] + $EXP[PovActorHasCurrentDirected]">630</ondown>
						<ondown condition="!$EXP[PovActorHasCurrentTVShows] + !$EXP[PovActorHasCurrentDirected]">610</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</onclick>
						<oninfo>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</oninfo>
						<include content="PovActorPanelLayouts"><param name="ready" value="$EXP[PovActorHasCurrentMovies]" /></include>
						<content target="videos" browse="never">plugin://skin.titan.bingie.lite/?mode=build_person_credits&amp;actor_id=$INFO[Window(Home).Property(PovActorId)]&amp;credit_type=movies&amp;sort=newest</content>
					</control>
				</control>

				<control type="group">
					<visible>String.IsEqual(Window(Home).Property(PovActorHasTVShows),true)</visible>
					<width>1668</width>
					<height>275</height>
					<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(610)">Conditional</animation>
					<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(630)">Conditional</animation>
					<control type="label">
						<visible>$EXP[PovActorHasCurrentTVShows]</visible>
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>TV Shows</label>
					</control>
					<control type="panel" id="620">
						<visible allowhiddenfocus="true">true</visible>
						<enable>$EXP[PovActorHasCurrentTVShows]</enable>
						<onfocus condition="System.HasAlarm(PovActorFocus)">CancelAlarm(PovActorFocus,silent)</onfocus>
						<top>55</top>
						<width>1668</width>
						<height>220</height>
						<orientation>horizontal</orientation>
						<preloaditems>2</preloaditems>
						<scrolltime tween="quadratic">350</scrolltime>
						<onup condition="$EXP[PovActorHasCurrentMovies]">610</onup>
						<onup condition="!$EXP[PovActorHasCurrentMovies]">620</onup>
						<ondown condition="$EXP[PovActorHasCurrentDirected]">630</ondown>
						<ondown condition="!$EXP[PovActorHasCurrentDirected]">620</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</onclick>
						<oninfo>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</oninfo>
						<include content="PovActorPanelLayouts"><param name="ready" value="$EXP[PovActorHasCurrentTVShows]" /></include>
						<content target="videos" browse="never">plugin://skin.titan.bingie.lite/?mode=build_person_credits&amp;actor_id=$INFO[Window(Home).Property(PovActorId)]&amp;credit_type=tvshows&amp;sort=newest</content>
					</control>
				</control>

				<control type="group">
					<visible>String.IsEqual(Window(Home).Property(PovActorHasDirected),true)</visible>
					<width>1668</width>
					<height>275</height>
					<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(610) | Control.HasFocus(620)">Conditional</animation>
					<control type="label">
						<visible>$EXP[PovActorHasCurrentDirected]</visible>
						<width>1668</width>
						<height>45</height>
						<font>Bold31</font>
						<textcolor>ffffffff</textcolor>
						<label>Directed By</label>
					</control>
					<control type="panel" id="630">
						<visible allowhiddenfocus="true">true</visible>
						<enable>$EXP[PovActorHasCurrentDirected]</enable>
						<onfocus condition="System.HasAlarm(PovActorFocus)">CancelAlarm(PovActorFocus,silent)</onfocus>
						<top>55</top>
						<width>1668</width>
						<height>220</height>
						<orientation>horizontal</orientation>
						<preloaditems>2</preloaditems>
						<scrolltime tween="quadratic">350</scrolltime>
						<onup condition="$EXP[PovActorHasCurrentTVShows]">620</onup>
						<onup condition="!$EXP[PovActorHasCurrentTVShows] + $EXP[PovActorHasCurrentMovies]">610</onup>
						<onup condition="!$EXP[PovActorHasCurrentTVShows] + !$EXP[PovActorHasCurrentMovies]">630</onup>
						<ondown>630</ondown>
						<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
						<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</onclick>
						<oninfo>RunPlugin(plugin://skin.titan.bingie.lite/?mode=show_media_info&amp;mediatype=$INFO[ListItem.Property(PovCreditType)]&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)])</oninfo>
						<include content="PovActorPanelLayouts"><param name="ready" value="$EXP[PovActorHasCurrentDirected]" /></include>
						<content target="videos" browse="never">plugin://skin.titan.bingie.lite/?mode=build_person_credits&amp;actor_id=$INFO[Window(Home).Property(PovActorId)]&amp;credit_type=directed&amp;sort=newest</content>
					</control>
				</control>
			</control>

			<control type="button" id="699">
				<visible>
					String.IsEqual(Window(Home).Property(PovActorReady),true) + !String.IsEqual(Window(Home).Property(PovActorHasMovies),true) +
					!String.IsEqual(Window(Home).Property(PovActorHasTVShows),true) + !String.IsEqual(Window(Home).Property(PovActorHasDirected),true)
				</visible>
				<left>126</left>
				<top>690</top>
				<width>520</width>
				<height>72</height>
				<font>Reg24</font>
				<label>No titles available</label>
				<align>center</align>
				<textcolor>ffffffff</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<texturefocus>colors/color_white.png</texturefocus>
				<texturenofocus colordiffuse="cc000000">colors/color_black.png</texturenofocus>
				<onfocus condition="System.HasAlarm(PovActorFocus)">CancelAlarm(PovActorFocus,silent)</onfocus>
				<onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onclick>
				<onback>RunPlugin(plugin://skin.titan.bingie.lite/?mode=pov_page_back)</onback>
			</control>
			<control type="label">
				<visible>!String.IsEqual(Window(Home).Property(PovActorReady),true)</visible>
				<left>126</left>
				<top>690</top>
				<width>520</width>
				<height>72</height>
				<font>Reg24</font>
				<label>Loading…</label>
				<textcolor>b3ffffff</textcolor>
				<aligny>center</aligny>
			</control>
		</control>
	</include>

	<include name="PovActorPanelLayouts">
		<itemlayout width="333" height="193">
			<control type="group">
				<visible>$PARAM[ready]</visible>
				<width>335</width>
				<height>195</height>
				<include content="PovMoreLikeThisCard"><param name="focused" value="false" /></include>
			</control>
		</itemlayout>
		<focusedlayout width="333" height="193">
			<control type="group">
				<visible>$PARAM[ready]</visible>
				<width>335</width>
				<height>195</height>
				<include content="PovMoreLikeThisCard"><param name="focused" value="true" /></include>
			</control>
		</focusedlayout>
	</include>

	<variable name="PovActorPageBackdrop">
		<value condition="$EXP[PovActorHasCurrentMovies] + Control.HasFocus(610) + !String.IsEmpty(Container(610).ListItem.Property(landscape))">$INFO[Container(610).ListItem.Property(landscape)]</value>
		<value condition="$EXP[PovActorHasCurrentTVShows] + Control.HasFocus(620) + !String.IsEmpty(Container(620).ListItem.Property(landscape))">$INFO[Container(620).ListItem.Property(landscape)]</value>
		<value condition="$EXP[PovActorHasCurrentDirected] + Control.HasFocus(630) + !String.IsEmpty(Container(630).ListItem.Property(landscape))">$INFO[Container(630).ListItem.Property(landscape)]</value>
		<value>$INFO[Window(Home).Property(PovActorBackdrop)]</value>
	</variable>

</includes>
