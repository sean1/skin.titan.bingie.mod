<includes>

	<!-- Bingie Info -->
	<include name="BingieInfo">
		<control type="group">
			<include>GlobalBackground</include>
			<!-- Base BG -->
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture background="true" colordiffuse="$VAR[BingiePanelColor]">diffuse/panel2.png</texture>
			</control>
			<!-- Dialog Info -->
			<control type="group">
				<animation effect="fade" start="0" end="100" time="200">Visible</animation>
				<visible>!ControlGroup(6000).HasFocus()</visible>
				<visible>String.IsEmpty(Window(Home).Property(Recommendations.IsLoading))</visible>
				<visible>!String.IsEqual(ListItem.Property(item.type),person)</visible>
				<!-- Hidden My Rating Button -->
				<control type="button" id="7">
					<include>HiddenObject</include>
				</control>

				<!-- Hidden List to Get First/Next Episode -->
				<control type="list" id="5050">
                    <visible allowhiddenfocus="true">!String.IsEmpty(ListItem.DBID) + String.IsEqual(ListItem.DBTYPE,tvshow)</visible>
                    <visible>Integer.IsGreater(Container(5050).NumItems,0) + !Container(5050).IsUpdating</visible>
					<left>-100</left>
					<top>-100</top>
					<preloaditems>1</preloaditems>
					<itemlayout/>
					<focusedlayout/>
					<content sortorder="ascending" sortby="playcount" limit="1">$VAR[InfoDialogNextUpContent]</content>
				</control>

				<!-- Normal Cast Details as Hidden List -->
				<control type="list" id="50">
					<posx>1</posx>
					<posy>1</posy>
					<width>1</width>
					<height>1</height>
					<itemlayout />
					<focusedlayout />
					<onup>8000</onup>
					<onleft>8000</onleft>
					<onright>8000</onright>
					<ondown>8000</ondown>
					<visible allowhiddenfocus="true">false</visible>
				</control>

				<!-- Fanart Background Image -->
				<include content="BingieSpotlightCornerImage">
					<animation effect="fade" start="100" end="50" time="300" condition="String.IsEmpty(Window(Home).Property(FullImage))">WindowOpen</animation>
					<animation effect="fade" start="50" end="50" time="300" condition="String.IsEmpty(Window(Home).Property(FullImage))">WindowClose</animation>
					<animation effect="fade" end="0" time="0" condition="!String.IsEmpty(Window(Home).Property(FullImage))">WindowOpen</animation>
					<animation effect="fade" end="0" time="0" condition="!String.IsEmpty(Window(Home).Property(FullImage))">WindowClose</animation>
					<param name="visibility" value="![Player.HasVideo + ![VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)]]" />
					<param name="image" value="$VAR[fanartBackground]" />
				</include>

				<!-- Spotlight Fanart Background Image -->
				<include content="BingieSpotlightFullImage">
					<param name="visibility" value="![Player.HasVideo + ![VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)] | String.IsEmpty(Window(Home).Property(FullImage))]" />
					<param name="image" value="$VAR[fanartBackground]" />
				</include>

				<!-- Additional Info Overlay -->
				<control type="image">
					<visible>!String.IsEmpty(Window.Property(AdditionalInfo)) + !String.IsEqual(Window.Property(AdditionalInfo),set)</visible>
					<width>100%</width>
					<height>100%</height>
					<texture background="true" colordiffuse="$VAR[BingiePanelColor]">colors/color_white.png</texture>
					<animation effect="fade" start="0" end="100" time="300" condition="!Player.HasVideo + !false">Visible</animation>
					<animation effect="fade" start="0" end="60" time="300" condition="!Player.HasVideo + false">Visible</animation>
					<animation effect="fade" start="0" end="70" time="300" condition="Player.HasVideo">Visible</animation>
				</control>

				<!-- Dialog Info Details -->
				<control type="grouplist">
                    <width>1500</width>
                    <include>BingieLeftDefs</include>
                    <top>10</top>
                    <orientation>vertical</orientation>
                    <usecontrolcoords>true</usecontrolcoords>
                    <itemgap>10</itemgap>
				<control type="grouplist">
					<include>Animation_Right_Delay_2</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<control type="image" id="90005">
						<height>190</height>
						<width>490</width>
						<align>left</align>
						<aspectratio align="center" aligny="center">keep</aspectratio>
						<texture background="true" fallback="colors/color_transparent.png">$VAR[BingieInfoClearlogo]</texture>
					</control>
					<!-- Movie Title with no Clearlogo -->
					<control type="textbox" id="90006">
						<visible>String.EndsWith(Control.GetLabel(90005),color_transparent.png)</visible>
						<top>-189</top>
						<height>184</height>
						<width max="650">auto</width>
						<font>Title</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieInfoLabel]</label>
						<include condition="$PARAM[genre_adjust]">Bingie_TextTitle_Adjust_Genre_Anim</include>
						<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
					</control>
					<control type="group">
						<top>-2</top>
						<width>1000</width>
						<height>35</height>
						<include>SpotlightRowDetails</include>
					</control>
				</control>
				<control type="grouplist">
					<top>228</top>
					<include>Animation_Right_Delay</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<!-- Media File Location -->
				    <control type="label">
					  <description>Show Media File Path BingiePoster/List/Panel</description>
						<visible>false</visible>
					    <top>34</top>
						<height>12</height>
						<width>100%</width>
						<font>Plots</font>
						<align>left</align>
				       <label>$INFO[ListItem.Path]</label>
		      	    </control>
					<!-- Sublabel -->
					<control type="label" id="823">
						<visible>!String.IsEmpty(Control.GetLabel(823))</visible>
						<visible>!$EXP[IsMovieDBType]</visible>
						<animation effect="fade" start="100" end="0" time="200" condition="!String.IsEmpty(Window.Property(AdditionalInfo))">Conditional</animation>
						<top>34</top>
						<height>12</height>
						<width>100%</width>
						<font>Plots</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieDialogEpisodeInfoLabel]</label>
					</control>

					<!-- Plot -->
					<control type="textbox">
						<visible>[String.IsEmpty(ListItem.Set) + !false] | false</visible>
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast) | String.IsEqual(Window.Property(AdditionalInfo),plot)">Conditional</animation>
						<width>820</width>
						<top>19</top>
						<height min="50" max="120">auto</height>
						<textcolor>b3ffffff</textcolor>
						<align>left</align>
						<font>Plots</font>
						<label>$VAR[BingieDialogInfoPlot]</label>   <!-- BingieInfoDialogPlot -->
					</control>

					<control type="textbox">
						<visible>[!String.IsEmpty(ListItem.Set) + !false]</visible>
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast) | String.IsEqual(Window.Property(AdditionalInfo),plot)">Conditional</animation>
						<width>820</width>
						<top>19</top>
						<height>120</height>
						<textcolor>b3ffffff</textcolor>
						<align>left</align>
						<font>Plots</font>
						<label>$VAR[BingieDialogInfoPlot]</label>   <!-- BingieInfoDialogPlot -->
					</control>

					<!-- buttons -->
					<control type="group">
						<top>33</top>
						<width>550</width>
						<posx>1</posx>
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo), plot) | String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast)">Conditional</animation>
						<animation effect="slide" start="0,0" end="0,41" time="0" delay="0" condition="String.IsEqual(Window.Property(AdditionalInfo),set)">Conditional</animation>
