<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <zorder>3</zorder>
    <controls>
        <control type="group">
            <depth>0.54</depth>
            <left>24</left>
            <top>24</top>
            <width>1872</width>
            <height>52</height>
            <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
            <visible>!Window.IsVisible(startup)</visible>
            <control type="grouplist">
                <width>1872</width>
                <height>52</height>
                <orientation>horizontal</orientation>
                <itemgap>14</itemgap>
                <control type="label" id="401">
                    <width max="116">auto</width>
                    <height>52</height>
                    <font>Bold20</font>
                    <shadowcolor>cc000000</shadowcolor>
                    <aligny>center</aligny>
                    <visible>!String.IsEmpty(Control.GetLabel(401))</visible>
                </control>
                <control type="fadelabel" id="402">
                    <width>1742</width>
                    <height>52</height>
                    <font>Reg22</font>
                    <shadowcolor>cc000000</shadowcolor>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                    <scrollspeed>100</scrollspeed>
                    <scrollout>false</scrollout>
                    <pauseatend>400</pauseatend>
                </control>
            </control>
        </control>
    </controls>
</window>
