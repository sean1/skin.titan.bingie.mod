				[$EXP[IsBingieCategoriesActive] + [Control.HasFocus(117) | ControlGroup(117).HasFocus()]] |
                [Container.Content(Genres) + false + !String.IsEmpty(ListItem.label) + !String.IsEqual(ListItem.label,..)] |
                [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)]
            </visible>
			<include condition="Window.IsMedia">disabledFanart</include>
            <include condition="Window.IsMedia">disabledExtraFanart</include>
