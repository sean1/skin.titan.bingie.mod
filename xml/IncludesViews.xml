<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <include name="videoViewIds">
        <views>50,523,525,527</views>
    </include>

    <include name="genericViewIds">
        <views>50</views>
    </include>

    <include name="allViews">
        <control type="group" id="5000">
            <visible>!Window.IsActive(virtualkeyboard)</visible>
            <include>animation_window_open_close</include>
            <include>View_50_List</include>
            <include condition="Window.IsActive(MyVideoNav.xml)">View_523_Bingie_Main_Landscape</include>
            <include condition="Window.IsActive(MyVideoNav.xml)">View_525_Episodes</include>
            <include condition="Window.IsActive(MyVideoNav.xml)">View_527_Seasons</include>
        </control>
    </include>

    <include name="thumbsborder_focused">
        <bordersize>4</bordersize>
    </include>

    <include name="WatchedIndicatorLayout">
        <control type="group">
            <visible>!String.IsEqual(ListItem$PARAM[listitem].Label,..)</visible>
            <width>$PARAM[width]</width>
            <height>$PARAM[height]</height>
            <right>0</right>
            <top>0</top>

            <control type="group">
                <description>Watched Overlay</description>
                <visible>Integer.IsGreater(ListItem$PARAM[listitem].PlayCount,0) + !ListItem$PARAM[listitem].IsResumable</visible>
                <visible>!ListItem$PARAM[listitem].IsPlaying</visible>
                <control type="image">
                    <texture background="true">$PARAM[overlay_texture]</texture>
                    <colordiffuse>cc800000</colordiffuse>
                </control>
                <control type="image">
                    <texture>overlays/$PARAM[overlay]/watched.png</texture>
                    <colordiffuse>ffffffff</colordiffuse>
                </control>
            </control>

            <control type="group">
                <description>In progress Overlay</description>
                <visible>Control.IsVisible(50) | Control.IsVisible(523) | Control.IsVisible(525) | Control.IsVisible(527)</visible>
                <visible>ListItem$PARAM[listitem].IsResumable</visible>
                <visible>!ListItem$PARAM[listitem].IsPlaying</visible>
                <control type="image">
                    <texture background="true">$PARAM[overlay_texture]</texture>
                    <colordiffuse>cc800000</colordiffuse>
                </control>
                <control type="label">
                    <right>0</right>
                    <top>0</top>
                    <align>center</align>
                    <font>$PARAM[font]</font>
                    <width>65%</width>
                    <height>45%</height>
                    <label>$INFO[ListItem$PARAM[listitem].PercentPlayed]%</label>
                    <textcolor>ffffffff</textcolor>
                </control>
            </control>

            <control type="group">
                <description>Movieset Overlay</description>
                <visible>ListItem$PARAM[listitem].IsCollection | String.Contains(ListItem$PARAM[listitem].Path,videodb://movies/sets/)</visible>
                <visible>!ListItem$PARAM[listitem].IsPlaying</visible>
                <control type="image">
                    <texture background="true">$PARAM[overlay_texture]</texture>
                    <colordiffuse>ffffbf00</colordiffuse>
                </control>
                <control type="image">
                    <texture>overlays/$PARAM[overlay]/discset.png</texture>
                    <colordiffuse>ffffffff</colordiffuse>
                </control>
            </control>

            <control type="group">
                <description>Is Playing</description>
                <visible>ListItem$PARAM[listitem].IsPlaying</visible>
                <control type="image">
                    <texture background="true">$PARAM[overlay_texture]</texture>
                    <colordiffuse>cc181818</colordiffuse>
                </control>
                <control type="image">
                    <texture>osd/slim/Play.png</texture>
                    <left>36%</left>
                    <top>-10%</top>
                    <width>74%</width>
                    <height>74%</height>
                    <colordiffuse>ffffffff</colordiffuse>
                </control>
            </control>
        </control>
    </include>


    <include name="WatchedIndicatorSmall">
        <include content="WatchedIndicatorLayout">
            <param name="width" value="60" />
            <param name="height" value="60" />
            <param name="font" value="indicator_small" />
            <param name="overlay" value="normal" />
            <param name="overlay_texture" value="diffuse/icon_overlay.png" />
        </include>
    </include>

    <include name="WatchedIndicatorLarge">
        <include content="WatchedIndicatorLayout">
            <param name="width" value="120" />
            <param name="height" value="120" />
            <param name="font" value="indicator_big" />
            <param name="overlay" value="big" />
            <param name="overlay_texture" value="diffuse/icon_overlay.png" />
        </include>
    </include>

    <include name="Top250Indicator">
        <param name="visibility" default="true" />
        <definition>
            <control type="image">
                <visible>$PARAM[visibility]</visible>
                <visible>!$EXP[IsEpisodeDBType] + !String.IsEmpty(Control.GetLabel(8231)) + !$EXP[IsCategoryDBType]</visible>
                <posy>8</posy>
                <left>8</left>
                <height>60</height>
                <width>50</width>
                <aspectratio>keep</aspectratio>
                <texture>bingie/top250p.png</texture>
            </control>
        </definition>
    </include>
</includes>
