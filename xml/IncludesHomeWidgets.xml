<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <include name="widget_layout_default">
		<include content="widget_layout_landscape">
			<param name="widgetid" value="$PARAM[widgetid]"/>
			<param name="widgetTags" value="$PARAM[widgetTags]"/>
			<param name="multiRows" value="$PARAM[multiRows]" />
		</include>
    </include>
	<!-- Play Something Widget -->
	<include name="PlaySomething_Widget">
        <focusedposition>0</focusedposition>
        <itemgap>0</itemgap>
        <width>1920</width>
        <height>1080</height>
        <orientation>horizontal</orientation>
        <itemgap>0</itemgap>
        <preloaditems>4</preloaditems>
        <pagecontrol>60</pagecontrol>
        <onright>noop</onright>
        <onleft>noop</onleft>
        <itemlayout></itemlayout>
        <focusedlayout>
			<include content="HiddenWidgetButton">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
		</focusedlayout>
    </include>

	<!-- Play Something -->
	<include name="PlaySomething_Widget_Base">
        <control type="group" id="9005">
				<!-- trailer video preview -->
				<control type="group">
					<include>FullscreenDimensions</include>
					<visible>$EXP[IsPlayingUnrecognizedContent] + [!Window.IsActive(DialogVideoInfo.xml) | !Window.IsActive(Custom_1190_TMDbHelperCast.xml) | !Window.IsActive(Custom_1191_TMDbHelper.xml)]</visible>
					<!-- bg -->
					<control type="image">
						<texture colordiffuse="ff000000" background="true">diffuse/panel2.png</texture>
					</control>
					<control type="videowindow"/>
				</control>
			<control type="image">
                <include>FullscreenDimensions</include>
                <texture background="true">$VAR[fanartBackground_something]</texture>
                <aspectratio>scale</aspectratio>
                <fadetime>350</fadetime>
				<visible>!Player.HasVideo</visible>
            </control>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture background="true" border="15">special://home/addons/resource.images.backgroundoverlays.basic/resources/vignette.png</texture>
				<colordiffuse>cc000000</colordiffuse>
			</control>
			<control type="image">
                <left>150</left>
                <top>120</top>
                <width>20</width>
                <height>20</height>
                <aspectratio>keep</aspectratio>
                <texture>bingie/something_arrow_up.png</texture>
				<colordiffuse>ffffffff</colordiffuse>
                <visible>Container(1510).HasNext | Container(1510).HasPrevious</visible>
			</control>
			<control type="label">
				<posx>185</posx>
				<top>98</top>
				<font>reg30</font>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[320094]</label>
				<visible>Container(1510).HasNext | Container(1510).HasPrevious</visible>
			</control>
			<control type="image">
                <right>50</right>
                <bottom>490</bottom>
                <posy>center</posy>
                <width>100</width>
                <height>100</height>
                <aspectratio>keep</aspectratio>
                <texture flipx="true">bingie/something_arrow.png</texture>
                <visible>Container(1510).HasNext</visible>
			</control>
			<control type="grouplist">
				<visible>Container(1510).HasNext</visible>
				<orientation>horizontal</orientation>
				<height>39</height>
				<width>450</width>
				<itemgap>15</itemgap>
				<right>140</right>
				<bottom>522</bottom>
				<align>right</align>
			<control type="image">
				<width>39</width>
                <height>39</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="ffffffff">shortcuts/something.png</texture>
            </control>
			<control type="label">
				<width>auto</width>
				<textoffsetx>0</textoffsetx>
				<height>37</height>
                <font>reg30</font>
				<align>right</align>
				<label>$LOCALIZE[320093]</label>
				<textcolor>ffffffff</textcolor>
			</control>
			</control>
			<control type="image">
				<width>100%</width>
                <height>100%</height>
                <texture>bingie/frameright.png</texture>
                <visible>Container(1510).HasNext + !Container(1510).HasPrevious</visible>
            </control>
            <control type="image">
                <left>50</left>
                <bottom>490</bottom>
                <posy>30</posy>
                <width>100</width>
                <height>100</height>
                <aspectratio>keep</aspectratio>
                <texture>bingie/something_arrow.png</texture>
                <visible>Container(1510).HasPrevious</visible>
            </control>
			<control type="image">
				<width>100%</width>
                <height>100%</height>
                <texture flipx="true">bingie/frameright.png</texture>
                <visible>Container(1510).HasPrevious + !Container(1510).HasNext</visible>
            </control>
			<control type="image">
				<width>100%</width>
                <height>100%</height>
                <texture>bingie/frameleft.png</texture>
                <visible>Container(1510).HasPrevious + Container(1510).HasNext</visible>
            </control>
			<control type="group">
				<animation effect="slide" start="0,0" end="0,-450" tween="sine" easing="in" time="300" delay="0" reversible="false" condition="System.IdleTime(1)">Conditional</animation>
				<animation effect="fade" start="0" end="100" tween="sine" easing="in" time="300" delay="0" reversible="false" condition="System.IdleTime(1)">Conditional</animation>
				<animation effect="slide" start="0,0" end="-650,0" tween="sine" easing="out" time="300" delay="0" reversible="false" condition="$EXP[IsPlayingUnrecognizedContent]">Conditional</animation>
				<animation effect="fade" start="100" end="0" tween="sine" easing="out" time="300" delay="0" reversible="false" condition="$EXP[IsPlayingUnrecognizedContent]">Conditional</animation>
				<top>1100</top>
				<left>150</left>
				<include content="Bingie_Headline_Item_2">
                    <param name="id" value="9005" />
                    <param name="image" value="$VAR[BingieInfoClearlogo]" />
                    <param name="text" value="$VAR[BingieInfoLabel]" />
				</include>
				<control type="group">
					<include>PlaySomethingRowDetails</include>
					<top>190</top>
				</control>
				<control type="label" id="823155">
					<top>270</top>
					<font>reg30</font>
					<textcolor>ffffffff</textcolor>
					<label>$INFO[ListItem.Tagline]</label>
					<visible>!String.IsEmpty(Control.GetLabel(823156)) | !String.IsEmpty(Control.GetLabel(823157))</visible>
				</control>
				<control type="label" id="823156">
					<top>270</top>
					<font>reg30</font>
					<textcolor>ffffffff</textcolor>
					<label>$LOCALIZE[320198] [LOWERCASE]$INFO[Container(99950).ListItem.Property(Genre.1.Name)][/LOWERCASE] $LOCALIZE[320199]</label>
					<visible>[String.IsEmpty(Control.GetLabel(823155)) | String.IsEmpty(Control.GetLabel(823157))] + $EXP[IsMovieDBType] + !String.IsEmpty(Container(99950).ListItem.Property(Genre.1.Name))</visible>
				</control>
				<control type="label" id="823157">
					<top>270</top>
					<font>reg30</font>
					<textcolor>ffffffff</textcolor>
					<label>$LOCALIZE[320198] [LOWERCASE]$INFO[Container(99950).ListItem.Property(Genre.1.Name)][/LOWERCASE] $LOCALIZE[320200]</label>
					<visible>[String.IsEmpty(Control.GetLabel(823155)) | String.IsEmpty(Control.GetLabel(823156))] + $EXP[IsTvShowDBType] + !String.IsEmpty(Container(99950).ListItem.Property(Genre.1.Name))</visible>
				</control>
			</control>
            <!-- Widgets -->
            <control type="grouplist" id="77777">
				<onup>back</onup>
				<include condition="Window.IsActive(1118)">bingie_items_something</include>
            </control>
		</control>
    </include>

    <!-- Widget Landscape -->
    <include name="widget_layout_landscape">
        <include content="widget_layout_landscape_not_vertical_layout">
            <param name="widgetid" value="$PARAM[widgetid]" />
            <param name="widgetTags" value="$PARAM[widgetTags]" />
            <param name="multiRows" value="$PARAM[multiRows]" />
        </include>
    </include>

    <include name="widget_layout_landscape_not_vertical_layout">
        <height>212</height>
        <itemlayout width="364" height="212">
            <control type="group">
                <include content="left">
                    <param name="left" value="bingie_no_circular_posx"/>
                </include>
                <width>landscape_width</width>
                <height>210</height>
                <include>ThumbsViewBingieLayout</include>
                <control type="group">
                    <description>widget label overlay</description>
                    <include>ThumbsTagOverlayBingie</include>
                </control>
                <include>New_Episodes_Tag_Overlay</include>
            </control>
        </itemlayout>
        <focusedlayout width="364" height="212" condition="Control.HasFocus($PARAM[widgetid])">
            <control type="group">
                <include content="left">
                    <param name="left" value="bingie_no_circular_posx"/>
                </include>
                <width>landscape_width</width>
                <height>210</height>
                <include>ThumbsViewItemBingieLayout</include>
                <control type="group">
                    <description>widget label overlay</description>
                    <include>ThumbsTagOverlayBingie</include>
                </control>
				<include>Top250Indicator</include>
                <include>New_Episodes_Tag_Overlay</include>
                <include content="HiddenWidgetButton">
                    <param name="widgetstyle" value="landscape"/>
                    <param name="widgetid" value="$PARAM[widgetid]"/>
                </include>
            </control>
        </focusedlayout>
		<focusedlayout width="364" height="212" condition="!Control.HasFocus($PARAM[widgetid])">
            <control type="group">
                <include content="left">
                    <param name="left" value="bingie_no_circular_posx"/>
                </include>
                <width>landscape_width</width>
                <height>210</height>
                <include>ThumbsViewItemBingieLayout</include>
                <control type="group">
                    <description>widget label overlay</description>
                    <include>ThumbsTagOverlayBingie</include>
                </control>
                <include>New_Episodes_Tag_Overlay</include>
				<include content="HiddenWidgetButton">
                    <param name="widgetstyle" value="landscape"/>
                    <param name="widgetid" value="$PARAM[widgetid]"/>
                </include>
            </control>
        </focusedlayout>
    </include>

    <include name="widget_header_multi">
        <control type="group" id="20$PARAM[widgetid]">
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <include>BingieNoCircularWidgetHeaderAnim</include>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <width>100%</width>
            <height>40</height>
            <!-- fixed focus navigation -->
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]"/>
            </include>
            <include content="Fixed_Focus_Navigation_Factory">
                <param name="widgetid" value="$PARAM[widgetid]"/>
            </include>
            <visible>String.IsEqual(Container(900).ListItem.Property(submenuVisibility),$PARAM[submenuid])</visible>
            <control type="label">
                <height>100%</height>
                <width>100%</width>
				<left>67</left>
                <font>Bold31</font>
                <include>widget_header_leftalign</include>
				<textcolor>ffffffff</textcolor>
                <label>$PARAM[widgetName]</label>
                <animation effect="slide" end="50" time="0" condition="Container($PARAM[widgetid]).IsUpdating + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)">Conditional</animation>
                <visible>String.IsEmpty(Container($PARAM[widgetid]).ListItem.Property(similartitle)) + String.IsEmpty(Container($PARAM[widgetid]).ListItem.Property(genretitle))</visible>
			</control>
            <control type="label">
                <height>100%</height>
                <width>100%</width>
				<left>67</left>
                <font>Bold31</font>
                <include>widget_header_leftalign</include>
				<textcolor>ffffffff</textcolor>
                <label>$INFO[Container($PARAM[widgetid]).ListItem.Property(similartitle),$LOCALIZE[31543] ,]$INFO[Container($PARAM[widgetid]).ListItem.Property(genretitle)]</label>
                <animation effect="slide" end="50" time="0" condition="Container($PARAM[widgetid]).IsUpdating + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)">Conditional</animation>
                <visible>!String.IsEmpty(Container($PARAM[widgetid]).ListItem.Property(similartitle)) | !String.IsEmpty(Container($PARAM[widgetid]).ListItem.Property(genretitle))</visible>
			</control>
            <control type="multiimage">
                <width>100%</width>
                <height>30</height>
                <top>7</top>
				<left>67</left>
                <include>widget_header_leftalign</include>
                <aspectratio align="left">keep</aspectratio>
                <imagepath background="true">$VAR[WidgetBusySpinnerPath]</imagepath>
                <timeperimage>85</timeperimage>
                <colordiffuse>ffffffff</colordiffuse>
                <fadetime>0</fadetime>
                <visible>Container($PARAM[widgetid]).IsUpdating + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)</visible>
            </control>
        </control>
    </include>
    <include name="widget_header_leftalign">
        <include content="left">
            <param name="left" value="65" />
        </include>
    </include>

    <include name="widget_base">
        <include content="widget_base_normal">
            <param name="containerType" value="fixedlist" />
            <param name="contentStyle" value="$PARAM[contentStyle]" />
            <param name="widgetid" value="$PARAM[widgetid]" />
            <param name="submenuid" value="$PARAM[submenuid]" />
            <param name="widgetTags" value="$PARAM[widgetTags]" />
            <param name="widgetTarget" value="$PARAM[widgetTarget]" />
            <param name="widgetPath" value="$PARAM[widgetPath]" />
            <param name="widgetSortBy" value="$PARAM[widgetSortBy]" />
            <param name="widgetSortOrder" value="$PARAM[widgetSortOrder]" />
            <param name="widgetLimit" value="$PARAM[widgetLimit]" />
            <param name="widgetStyle" value="$PARAM[widgetStyle]" />
            <param name="visibility" value="$PARAM[visibility]" />
            <param name="multiRows" value="$PARAM[multiRows]" />
        </include>
    </include>

    <include name="WidgetBaseBingieIncludes">
        <onunfocus condition="System.HasAlarm(preview_delay)">CancelAlarm(preview_delay,silent)</onunfocus>
        <onfocus condition="!String.IsEmpty(Window(Home).Property(KeepPlayingPreview))">ClearProperty(KeepPlayingPreview,home)</onfocus>
        <include content="ContainerShowInfoOnclick">
            <param name="widgetid" value="$PARAM[widgetid]" />
        </include>
        <include content="SetFixedVerticalNavigationProps">
            <param name="widgetid" value="$PARAM[widgetid]"/>
        </include>
        <include content="Fixed_Focus_Navigation_Factory">
            <param name="widgetid" value="$PARAM[widgetid]"/>
        </include>
        <include content="BingieUnfocusedWidgetFade">
            <param name="widgetid" value="$PARAM[widgetid]" />
        </include>
    </include>

    <include name="widget_base_normal">
        <control type="$PARAM[containerType]" id="$PARAM[widgetid]">
            <visible>$PARAM[visibility]</visible>
            <visible>String.IsEqual(Container(900).ListItem.Property(submenuVisibility),$PARAM[submenuid])</visible>
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <include condition="$PARAM[multiRows]">widget_base_vertical</include>
            <orientation>horizontal</orientation>
            <width>100%</width>
            <include>ScrollTime</include>
            <preloaditems>5</preloaditems>
            <include content="WidgetBaseBingieIncludes">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>WidgetsBaseAnimation</include>
			<onfocus>ClearProperty(Animation,home)</onfocus>
            <onfocus>SetProperty(ShowWidget,1,home)</onfocus>
            <include content="$PARAM[widgetStyle]">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="widgetTags" value="$PARAM[widgetTags]" />
                <param name="multiRows" value="$PARAM[multiRows]" />
            </include>
            <include content="widget_base_content_$PARAM[contentStyle]">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="submenuid" value="$PARAM[submenuid]" />
                <param name="widgetTarget" value="$PARAM[widgetTarget]" />
                <param name="widgetPath" value="$PARAM[widgetPath]" />
                <param name="widgetSortBy" value="$PARAM[widgetSortBy]" />
                <param name="widgetSortOrder" value="$PARAM[widgetSortOrder]" />
                <param name="widgetLimit" value="$PARAM[widgetLimit]" />
            </include>
        </control>
    </include>

    <include name="widget_base_vertical">
        <width>102%</width>
        <orientation>vertical</orientation>
    </include>

    <include name="widget_base_content_normal">
        <content sortby="$PARAM[widgetSortBy]" sortorder="$PARAM[widgetSortOrder]" limit="$PARAM[widgetLimit]" target="$PARAM[widgetTarget]" browse="never">$PARAM[widgetPath]</content>
    </include>
    <include name="WidgetTagOverlayAuto">
        <include>$PARAM[prefix]TagOverlayVisibility</include>
    </include>

    <!-- Spotlight Dummy Landscape Widget -->
    <include name="SpotlightDummyLandscapeWidget">
        <control type="grouplist">
            <visible>Control.IsVisible(1508)</visible>
            <visible>Integer.IsGreater(Container(77777).NumItems,1) + String.IsEqual(Window(Home).Property(CurrentWidgetPos),Container(77777).NumItems)</visible>
            <animation effect="fade" start="0" end="55" time="250">VisibleChange</animation>
            <animation effect="slide" start="0,-252" end="0,0" time="300" condition="!String.IsEqual(Window(Home).Property(CurrentWidgetPos),1)">Conditional</animation>
            <animation effect="slide" start="0,252" end="0,0" time="300" condition="String.IsEqual(Window(Home).Property(CurrentWidgetPos),1) | String.IsEqual(Window(Home).Property(CurrentWidgetPos),Container(77777).NumItems)">Conditional</animation>
            <orientation>vertical</orientation>
            <itemgap>0</itemgap>
            <usecontrolcoords>true</usecontrolcoords>
            <height>250</height>
            <include>No_Circular_Left</include>
            <left>0</left>
            <top>863</top>
            <control type="textbox">
                <left>8</left>
                <height>40</height>
                <width>99%</width>
                <font>Bold31</font>
				<textcolor>white</textcolor>
                <textcolor>73ffffff</textcolor>
                <label>$LOCALIZE[31185]</label>
            </control>
            <control type="image">
                <left>0</left>
                <height>210</height>
                <width>landscape_width</width>
                <bordersize>8</bordersize>
                <texture background="true" diffuse="home/home_matte3.png" fallback="resource://resource.images.skinicons.wide/video.png">$VAR[SpotlightLandscapeImage]</texture>
                <aspectratio scalediffuse="false" align="center" aligny="center">stretch</aspectratio>
            </control>
        </control>
    </include>
</includes>
