<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <!-- Fixed POV hub row. Content, label, target, order, and limit are code-defined. -->
    <include name="bingie_pov_hub_item">
        <control type="group" id="20$PARAM[widgetid]">
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <width>100%</width>
            <height>40</height>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>BingieNoCircularWidgetHeaderAnim</include>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Hub_Widget_Label">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="visibility" value="true" />
                <param name="label" value="$PARAM[label]" />
            </include>
            <control type="multiimage">
                <top>7</top>
                <width>100%</width>
                <height>30</height>
                <include>widget_header_leftalign</include>
                <aspectratio align="left">keep</aspectratio>
                <imagepath background="true">$VAR[WidgetBusySpinnerPath]</imagepath>
                <timeperimage>85</timeperimage>
                <colordiffuse>ffffffff</colordiffuse>
                <fadetime>0</fadetime>
                <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)</visible>
            </control>
        </control>
        <control type="fixedlist" id="$PARAM[widgetid]">
            <visible allowhiddenfocus="$PARAM[pollEmpty] + Integer.IsEqual(Container($PARAM[widgetid]).NumItems,0)">
                Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)
            </visible>
            <width>100%</width>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>ScrollTime</include>
            <preloaditems>2</preloaditems>
            <orientation>horizontal</orientation>
            <onback condition="$EXP[IsPlayingRecognizedContent]">SetFocus(509)</onback>
            <onback condition="!$EXP[IsPlayingRecognizedContent]">900</onback>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
			<include>ContainerShowInfoOnclick</include>
            <include content="$PARAM[widgetStyle]">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="widgetTags" value="WidgetTagOverlayAuto" />
                <param name="multiRows" value="false" />
            </include>
            <content limit="30" target="videos" browse="never">$PARAM[path]</content>
        </control>
    </include>

    <include name="bingie_discover_action_card">
        <control type="group">
            <include content="left">
                <param name="left" value="bingie_no_circular_posx" />
            </include>
            <width>landscape_width</width>
            <height>210</height>
            <control type="image">
                <left>8</left>
                <top>8</top>
                <right>8</right>
                <bottom>8</bottom>
                <texture border="10" colordiffuse="f2151515">diffuse/panel3.png</texture>
            </control>
            <control type="image">
                <left>28</left>
                <top>79</top>
                <width>52</width>
                <height>52</height>
                <aspectratio>keep</aspectratio>
                <texture background="true">$INFO[ListItem.Icon]</texture>
            </control>
            <control type="label">
                <left>104</left>
                <right>24</right>
                <top>58</top>
                <height>94</height>
                <align>left</align>
                <aligny>center</aligny>
                <font>Bold24</font>
                <textcolor>ffffffff</textcolor>
                <label>$INFO[ListItem.Label]</label>
                <scroll>false</scroll>
            </control>
        </control>
    </include>

    <include name="bingie_discover_action_layout">
        <height>212</height>
        <itemlayout width="364" height="212">
            <include>bingie_discover_action_card</include>
        </itemlayout>
        <focusedlayout width="364" height="212">
            <include>bingie_discover_action_card</include>
        </focusedlayout>
    </include>

    <!-- Local Discover actions use their plugin paths directly instead of opening media info. -->
    <include name="bingie_pov_hub_action_item">
        <control type="group" id="20$PARAM[widgetid]">
            <visible>Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <width>100%</width>
            <height>40</height>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>BingieNoCircularWidgetHeaderAnim</include>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Hub_Widget_Label">
                <param name="widgetid" value="$PARAM[widgetid]" />
                <param name="visibility" value="true" />
                <param name="label" value="$PARAM[label]" />
            </include>
        </control>
        <control type="fixedlist" id="$PARAM[widgetid]">
            <visible allowhiddenfocus="true">Container($PARAM[widgetid]).IsUpdating + Control.IsVisible($PARAM[widgetid]) | Integer.IsGreater(Container($PARAM[widgetid]).NumItems,0)</visible>
            <width>100%</width>
            <include content="BingieUnfocusedWidgetFade">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include>ScrollTime</include>
            <preloaditems>2</preloaditems>
            <orientation>horizontal</orientation>
            <onback condition="$EXP[IsPlayingRecognizedContent]">SetFocus(509)</onback>
            <onback condition="!$EXP[IsPlayingRecognizedContent]">900</onback>
            <include content="SetFixedVerticalNavigationProps">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <include content="Fixed_Focus_Navigation_Factory1">
                <param name="widgetid" value="$PARAM[widgetid]" />
            </include>
            <onfocus>SetProperty(BingieTrailerPreviewCancel,true,Home)</onfocus>
            <include>bingie_discover_action_layout</include>
            <content limit="10" target="videos" browse="never">$PARAM[path]</content>
        </control>
    </include>

