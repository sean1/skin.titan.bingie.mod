							<width>550</width>
							<height>325</height>
                            <orientation>vertical</orientation>
							<itemgap>0</itemgap>
                            <onup>noop</onup>
                            <ondown condition="!Player.HasVideo">noop</ondown>
							<ondown condition="Player.HasVideo">noop</ondown>
                            <scrolltime tween="sine" easing="inout">200</scrolltime>
							<pagecontrol>300</pagecontrol>

							<!-- Play/Resume via 5050 Container (next episode) -->
