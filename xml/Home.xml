<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <menucontrol>900</menucontrol>

    <!-- Defaults -->
	<!-- BINGIE -->
    <onload>SetProperty(bingieviews,1,Home)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">AlarmClock(BingieHomeTrendingWidgets,SetProperty(BingieHomeTrendingReady,1,Home),00:00:01,silent)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">AlarmClock(BingieHomePopularWidgets,SetProperty(BingieHomePopularReady,1,Home),00:00:02,silent)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetProperty(BingieHomeTrendingReady,1,Home)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetProperty(BingieHomePopularReady,1,Home)</onload>
    <onunload>SetProperty(SectionBackground,$ESCINFO[Control.GetLabel(99004)])</onunload>
    <onunload condition="System.HasAlarm(BingieHomeTrendingWidgets)">CancelAlarm(BingieHomeTrendingWidgets,silent)</onunload>
    <onunload condition="System.HasAlarm(BingieHomePopularWidgets)">CancelAlarm(BingieHomePopularWidgets,silent)</onunload>
    <onunload>ClearProperty(BingieHomeTrendingReady,Home)</onunload>
    <onunload>ClearProperty(BingieHomePopularReady,Home)</onunload>
    <onunload>ClearProperty(submenu,Home)</onunload>
    <onunload>ClearProperty(ShowWidget,Home)</onunload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <onunload>ClearProperty(bingieviews,Home)</onunload>
    <include>BingieViews_WindowOpen_Fade</include>

	<controls>
		<!-- Global Background -->
        <include>GlobalBackground</include>
        <control type="button" id="1000">
            <include>HiddenObject</include>
            <onfocus condition="String.IsEmpty(Window(Home).Property(LastFocusWidget))">SetFocus(77777)</onfocus>
            <onfocus condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetProperty(HomeFirstLoadDone,1)</onfocus>
            <onleft>900</onleft>
            <onright>900</onright>
            <onback>900</onback>
        </control>

        <!-- Preload submenu for count calculations -->
        <include>hiddenSubmenu</include>

		<!-- NowPlaying Background -->
		<include>NowPlayingBackground</include>

		<!-- Home Screen -->
        <include>HomeBingie</include>

	</controls>
</window>
