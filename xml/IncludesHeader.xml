<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>

    <include name="Header">
        <include condition="!false + false | !false + !false">Header_Normal</include>
        <include condition="false + false | false + !false">Header_Compact</include>
    </include>

    <include name="Header_Normal">
        <!-- Header Normal -->
        <control type="group">
            <visible>!Window.IsActive(notification) + !Window.IsActive(extendedprogressdialog) + !Control.IsVisible(77551) + !Control.IsVisible(88888) + !Control.IsVisible(88883)</visible>
            <visible>!Control.IsVisible(525) | !Control.IsVisible(527)</visible>
            <!-- header panel -->
            <control type="image">
				<posx>0</posx>
				<posy>-5</posy>
				<width>100%</width>
				<height>145</height>
				<texture border="5">diffuse/panel2.png</texture>
				<colordiffuse>None</colordiffuse>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(Home) | $EXP[IsBingieHubsActive] | $EXP[IsBingieCategoriesActive]]</visible>
			</control>

            <!-- Header Logo left -->
            <control type="group">
                <include condition="[!Window.IsActive(Home) + false] | [Window.IsActive(Home) + false]">HeaderLogo</include>
                <include>animation_fade_visible</include>
                <visible>![String.IsEqual(Window(Home).Property(ShowViewSubMenu),show) | Control.IsVisible(882) | !String.IsEmpty(Control.GetLabel(29476))]</visible>
            </control>

            <!-- Time right -->
            <control type="group">
                <include condition="[![Window.IsActive(Home) | $EXP[IsBingieHubsActive] | $EXP[IsBingieCategoriesActive]] + false] | [[Window.IsActive(Home) | $EXP[IsBingieHubsActive] | $EXP[IsBingieCategoriesActive]] + false]">TimeInfo</include>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(volumebar) | Control.IsVisible(881)]</visible>
            </control>

            <!-- Title left -->
            <control type="group">
                <include condition="[!Window.IsActive(Home) + false] | [Window.IsActive(Home) + false]">HeaderTitle</include>
                <include>animation_fade_visible</include>
                <visible>![String.IsEqual(Window(Home).Property(ShowViewSubMenu),show) | Control.IsVisible(882) | !String.IsEmpty(Control.GetLabel(29476))]</visible>
            </control>

            <!-- Profile right -->
            <control type="group">
                <right>60</right>
                <include condition="Window.IsActive(Home) + false">ProfileInfo</include>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(volumebar)]</visible>
            </control>

            <!-- Profile left -->
            <control type="group">
                <left>60</left>
                <include>ProfileInfo</include>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(volumebar) | !String.IsEmpty(Control.GetLabel(29476))]</visible>
                <visible>Window.IsActive(Home) + false</visible>
            </control>

        </control>

    </include>
    <include name="Header_Compact">
        <!-- Header Compact -->
        <control type="group">
            <visible>false</visible>
            <include>animation_fade_visible</include>
            <visible>!Window.IsActive(notification) + !Window.IsActive(extendedprogressdialog) + !Control.IsVisible(77551) + !Control.IsVisible(88888) + !Control.IsVisible(88883)</visible>
            <visible>!Control.IsVisible(525) | !Control.IsVisible(527)</visible>
            <!-- header panel -->

            <!-- Header Logo left -->
            <control type="group">
                <include>animation_fade_visible</include>
                <visible>![String.IsEqual(Window(Home).Property(ShowViewSubMenu),show) | Control.IsVisible(882)]</visible>
                <visible>[!Window.IsActive(Home) + false] | [Window.IsActive(Home) + false]</visible>
            </control>

            <!-- Time right -->
            <control type="group">
                <include>TimeInfoCompact</include>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(volumebar) | Control.IsVisible(881)]</visible>
                <visible>[![Window.IsActive(Home) | $EXP[IsBingieHubsActive] | $EXP[IsBingieCategoriesActive]] + false] | [[Window.IsActive(Home) | $EXP[IsBingieHubsActive] | $EXP[IsBingieCategoriesActive]] + false]</visible>
            </control>

            <!-- Profile right -->
            <control type="group">
                <include>ProfileInfoCompact</include>
                <include>animation_fade_visible</include>
                <visible>![Window.IsActive(volumebar)]</visible>
                <visible>Window.IsActive(Home) + false</visible>
            </control>

            <control type="grouplist" id="5555">
                <include>animation_fade_visible</include>
                <include>BingieNoCircularWidgetHeaderAnim</include>
                <orientation>horizontal</orientation>
                <itemgap>25</itemgap>
                <posx>-10</posx>
                <top>25</top>
                <onright>890</onright>
                <ondown>9000</ondown>
                <onup>9000</onup>
                <visible>![String.IsEqual(Window(Home).Property(ShowViewSubMenu),show) | Control.IsVisible(882)]</visible>
                <!-- Title left -->
                <control type="group" id="99226">
                    <visible>[!Window.IsActive(Home) + false] | [Window.IsActive(Home) + false]</visible>
                    <control type="label">
                        <top>-13</top>
                        <align>left</align>
                        <width>800</width>
                        <label>$VAR[value_header]</label>
                        <font>Bold30</font>
                        <textcolor>ffffffff</textcolor>
                        <shadowcolor>None</shadowcolor>
                    </control>
                    <control type="label">
                        <top>17</top>
                        <align>left</align>
                        <width>800</width>
                        <label>$VAR[value_subheader]</label>
                        <font>Reg26</font>
                        <textcolor>ffffffff</textcolor>
                        <shadowcolor>None</shadowcolor>
                    </control>
                </control>
            </control>

        </control>

    </include>

    <include name="HeaderTitle">

        <control type="group">
            <control type="label">
                <posx>60</posx>
                <posy>0</posy>
                <width min="80" max="1400">auto</width>
                <height>100</height>
                <font>Bold45</font>
                <align>left</align>
                <textcolor>ffffffff</textcolor>
                <label>$VAR[value_header]</label>
                <shadowcolor>None</shadowcolor>
            </control>
             <control type="label">
                <posy>75</posy>
                <posx>60</posx>
                <width min="0" max="1400">auto</width>
                <height>50</height>
                <label>$VAR[value_subheader]</label>
                <font>Reg28</font>
                <textcolor>ffffffff</textcolor>
                <shadowcolor>None</shadowcolor>
            </control>
        </control>

    </include>


	<include name="TimeInfo">
        <control type="group">
            <!--Time-->
            <control type="label">
                <right>60</right>
                <posy>0</posy>
                <width>600</width>
                <height>100</height>
                <align>right</align>
                <info>System.Time()</info>
                <font>Bold55</font>
                <textcolor>ffffffff</textcolor>
                <shadowcolor>None</shadowcolor>
            </control>
            <!--Date-->
            <control type="label">
                <right>60</right>
                <align>right</align>
                <posy>75</posy>
                <width>800</width>
                <height>50</height>
                <info>System.Date()</info>
                <font>Reg30</font>
                <textcolor>ffffffff</textcolor>
                <shadowcolor>None</shadowcolor>
            </control>
        </control>
	</include>


    <include name="TimeInfoCompact">
        <control type="group">
            <control type="label">
                <right>60</right>
                <top>12</top>
                <align>right</align>
                <width>300</width>
                <info>System.Time</info>
                <font>Bold30</font>
                <textcolor>ffffffff</textcolor>
                <shadowcolor>None</shadowcolor>
            </control>
            <control type="label">
                <right>60</right>
                <top>42</top>
                <align>right</align>
                <width>500</width>
                <info>System.Date</info>
                <font>Reg26</font>
                <textcolor>ffffffff</textcolor>
                <shadowcolor>None</shadowcolor>
            </control>
        </control>
    </include>

	<include name="ProfileInfo">
		<control type="group" id="891">
			<defaultcontrol>890</defaultcontrol>
			<posy>15</posy>
            <width>150</width>
            <height>110</height>
			<control type="image">
				<texture diffuse="home/home_matte2.png">colors/color_white.png</texture>
				<colordiffuse>cc0a0a0a</colordiffuse>
				<visible>!Control.HasFocus(890)</visible>
			</control>
			<control type="image">
				<texture diffuse="home/home_matte2.png">colors/color_white.png</texture>
				<colordiffuse>cce0e0e0</colordiffuse>
				<visible>Control.HasFocus(890)</visible>
			</control>
			<control type="image" id="888">
				<bordersize>8</bordersize>
                <height>75%</height>
				<texture fallback="common/profil/avatar.png">$INFO[System.ProfileThumb]</texture>
				<aspectratio align="center" aligny="top">keep</aspectratio>
				<visible>!Control.HasFocus(890)</visible>
			</control>
			<control type="image" id="889">
				<bordersize>8</bordersize>
                <height>75%</height>
				<texture fallback="common/profil/avatar.png">$INFO[System.ProfileThumb]</texture>
				<aspectratio align="center" aligny="top">keep</aspectratio>
				<visible>Control.HasFocus(890)</visible>
			</control>
			<control type="button" id="890">
				<ondown>900</ondown>
				<width>100%</width>
				<height>100%</height>
				<texturefocus/>
				<texturenofocus/>
				<onclick>System.LogOff</onclick>
			</control>
			<control type="label">
				<!--Profile name-->
				<left>4%</left>
                <width>92%</width>
				<bottom>0</bottom>
                <height>25%</height>
				<label>$VAR[ProfileLabel]</label>
				<align>center</align>
                <aligny>center</aligny>
				<font>Reg22</font>
				<textcolor>ffffffff</textcolor>
			</control>
		</control>
	</include>

    <include name="ProfileInfoCompact">
        <control type="radiobutton" id="890">
            <right>30</right>
            <top>20</top>
            <ondown>9000</ondown>
            <onleft>5555</onleft>
            <width>600</width>
            <height>60</height>
            <radiowidth>60</radiowidth>
            <radioheight>60</radioheight>
            <align>right</align>
            <aligny>center</aligny>
            <font>Reg26</font>
            <label>$VAR[ProfileLabel]</label>
            <textcolor>ffffffff</textcolor>
            <focusedcolor>ffffffff</focusedcolor>
            <textureradioonfocus colordiffuse="ffffffff">common/profil/avatar.png</textureradioonfocus>
            <textureradioonnofocus colordiffuse="ffffffff">common/profil/avatar.png</textureradioonnofocus>
            <textureradioofffocus colordiffuse="ffffffff">common/profil/avatar.png</textureradioofffocus>
            <textureradiooffnofocus colordiffuse="ffffffff">common/profil/avatar.png</textureradiooffnofocus>
            <textoffsetx>70</textoffsetx>
            <radioposx>0</radioposx>
            <pulseonselect>false</pulseonselect>
            <texturefocus/>
            <texturenofocus/>
            <onclick>System.LogOff</onclick>
            <selected>Control.HasFocus(890)</selected>
        </control>
    </include>

    <include name="HeaderLogo">
        <!-- Kodi Logo image -->
        <control type="image">
            <posx>45</posx>
            <posy>-30</posy>
            <height>196</height>
            <width></width>
            <aspectratio align="left">keep</aspectratio>
            <colordiffuse>ffffffff</colordiffuse>
            <texture>bingie_mod_logo.png</texture>
            <visible>String.IsEmpty(Control.GetLabel(198754))</visible>
            <visible>![false]</visible>
        </control>
		<control type="image">
            <posx>43</posx>
            <posy>-13</posy>
            <height>132</height>
            <width></width>
            <aspectratio align="left">keep</aspectratio>
            <colordiffuse>ffffffff</colordiffuse>
            <texture>home/bingie_mod_logo.png</texture>
            <visible>String.IsEmpty(Control.GetLabel(198754))</visible>
            <visible>![!false]</visible>
        </control>
    </include>

</includes>
