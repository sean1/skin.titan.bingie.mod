<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <menucontrol>900</menucontrol>

    <!-- Defaults -->
	<!-- BINGIE -->
    <onload condition="String.IsEmpty(Window(Home).Property(BingieHomeFirstLoadDone))">AlarmClock(BingieHomeWidgetStage2,SetProperty(BingieHomeWidgetStage,1,Home),00:00:01,silent)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(BingieHomeFirstLoadDone))">AlarmClock(BingieHomeWidgetStage3,SetProperty(BingieHomeWidgetStage,2,Home),00:00:02,silent)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(BingieHomeFirstLoadDone))">AlarmClock(BingieHomeWidgetStage4,SetProperty(BingieHomeWidgetStage,3,Home),00:00:03,silent)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(BingieHomeFirstLoadDone))">SetProperty(BingieHomeWidgetStage,3,Home)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(BingieHomeFirstLoadDone))">SetProperty(BingieHomeFirstLoadDone,1,Home)</onload>
    <onunload condition="System.HasAlarm(BingieHomeWidgetStage2)">CancelAlarm(BingieHomeWidgetStage2,silent)</onunload>
    <onunload condition="System.HasAlarm(BingieHomeWidgetStage3)">CancelAlarm(BingieHomeWidgetStage3,silent)</onunload>
    <onunload condition="System.HasAlarm(BingieHomeWidgetStage4)">CancelAlarm(BingieHomeWidgetStage4,silent)</onunload>
    <onunload>ClearProperty(BingieHomeWidgetStage,Home)</onunload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <include>BingieViews_WindowOpen_Fade</include>

	<controls>
		<!-- Global Background -->
        <include>GlobalBackground</include>
        <control type="button" id="1000">
            <include>HiddenObject</include>
            <onfocus>SetFocus(77777)</onfocus>
            <onleft>900</onleft>
            <onright>900</onright>
            <onback>900</onback>
        </control>

        <!-- Preload submenu for count calculations -->
        <include>hiddenSubmenu</include>

		<!-- NowPlaying Background -->
		<include>NowPlayingBackground</include>

		<!-- Home Screen -->
        <include>HomeBingie</include>

	</controls>
</window>
