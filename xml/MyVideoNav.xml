<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">5000</defaultcontrol>
	    <include>videoViewIds</include>
    <onload condition="$EXP[IsPovLiteNavigationMenu]">Container.SetViewMode(50)</onload>
	<onload condition="String.Contains(Container.FolderPath,mode=livetv.refine) | String.Contains(Container.FolderPath,mode=livetv.soccer)">Container.SetViewMode(523)</onload>
	<onload condition="String.IsEqual(Container.FolderPath,sources://video/)">Container.SetViewMode(50)</onload>
	<onload>ClearProperty(ShowViewSubMenu,Home)</onload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <!-- return to infodialog if previous window -->
    <onunload condition="!String.IsEmpty(Window(Home).Property(BaseWindow)) + String.IsEmpty(Window(Home).Property(ListItem.TVShowID)) + !Player.HasVideo">AlarmClock(loadinfo,Action(Info),00:00,silent)</onunload>
    <!-- clear tvshowid property -->
    <onunload condition="!String.IsEmpty(Window(Home).Property(ListItem.TVShowID))">ClearProperty(ListItem.TVShowID,Home)</onunload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(KeepTVShowID))">ClearProperty(KeepTVShowID,Home)</onunload>
	<onload>ClearProperty(FullImage,home)</onload>

    <controls>
        <!-- Video Background -->
        <include>GlobalBackground</include>
		<!--NowPlaying-->
        <!-- all Views -->
        <include>allViews</include>

        <!-- Live sports dashboard menu -->
        <control type="group">
            <posx>-660</posx><posy>0</posy>
            <visible>!Window.IsActive(virtualkeyboard) + String.Contains(Container.FolderPath,mode=livetv.soccer)</visible>
            <include>animation_sub_menu</include>
            <control type="image"><left>0</left><width>500</width><height>100%</height><colordiffuse>fa0a0a0a</colordiffuse><aspectratio>stretch</aspectratio><texture background="true">diffuse/panel2.png</texture></control>
            <control type="label"><posx>71</posx><posy>10</posy><width>400</width><height>100</height><font>Bold45</font><textcolor>ffffffff</textcolor><label>$INFO[Window(Home).Property(LiveTV.Sport.Title)]</label></control>
            <control type="grouplist" id="9002">
                <posx>21</posx><posy>185</posy><width>458</width><height>770</height><itemgap>3</itemgap><orientation>vertical</orientation>
                <onleft>ClearProperty(ShowViewSubMenu,Home)</onleft><onleft>523</onleft>
                <onright>ClearProperty(ShowViewSubMenu,Home)</onright><onright>523</onright>
                <onback>ClearProperty(ShowViewSubMenu,Home)</onback><onback>523</onback>
                <onup>9002</onup><ondown>9002</ondown>
                <control type="button" id="9306"><include>SideBladeMenuButton</include><label>Soccer</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=soccer)</onclick></control>
                <control type="button" id="9307"><include>SideBladeMenuButton</include><label>Hockey</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=hockey)</onclick></control>
                <control type="button" id="9308"><include>SideBladeMenuButton</include><label>Football</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=football)</onclick></control>
                <control type="button" id="9314"><include>SideBladeMenuButton</include><label>Basketball</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=basketball)</onclick></control>
                <control type="button" id="9317"><include>SideBladeMenuButton</include><label>Tennis</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=tennis)</onclick></control>
                <control type="button" id="9301"><include>SideBladeMenuButton</include><label>League: $INFO[Window(Home).Property(LiveTV.Soccer.League)]</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),soccer)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=soccer&amp;action=league)</onclick></control>
                <control type="button" id="9311"><include>SideBladeMenuButton</include><label>All standings</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),hockey)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.all_standings&amp;sport=hockey)</onclick></control>
                <control type="button" id="9312"><include>SideBladeMenuButton</include><label>All standings</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),football)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.all_standings&amp;sport=football)</onclick></control>
                <control type="button" id="9316"><include>SideBladeMenuButton</include><label>All standings</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),basketball)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.all_standings&amp;sport=basketball)</onclick></control>
                <control type="button" id="9313"><include>SideBladeMenuButton</include><label>Scroll standings</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Standings.Layout),ncaa) + String.IsEqual(Window(Home).Property(LiveTV.Standings.Key),Container(523).ListItem.Property(LiveTV.StandingsKey)) + !String.IsEmpty(Window(Home).Property(LiveTV.Standings.AllText))</visible><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>SetFocus(9321)</onclick></control>
                <control type="button" id="9302"><include>SideBladeMenuButton</include><label>Search Live TV</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>SetFocus(523)</onclick><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.search)</onclick></control>
                <control type="button" id="9303"><include>SideBladeMenuButton</include><label>Browse channels</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.refine)</onclick></control>
                <control type="button" id="9304"><include>SideBladeMenuButton</include><label>TV guide</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.guide)</onclick></control>
                <control type="button" id="9305"><include>SideBladeMenuButton</include><label>Refresh matches</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),soccer)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=soccer&amp;action=refresh)</onclick></control>
                <control type="button" id="9309"><include>SideBladeMenuButton</include><label>Refresh matches</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),hockey)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=hockey&amp;action=refresh)</onclick></control>
                <control type="button" id="9310"><include>SideBladeMenuButton</include><label>Refresh matches</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),football)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=football&amp;action=refresh)</onclick></control>
                <control type="button" id="9315"><include>SideBladeMenuButton</include><label>Refresh matches</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),basketball)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=basketball&amp;action=refresh)</onclick></control>
                <control type="button" id="9318"><include>SideBladeMenuButton</include><label>Refresh matches</label><visible>String.IsEqual(Window(Home).Property(LiveTV.Sport),tennis)</visible><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.soccer&amp;sport=tennis&amp;action=refresh)</onclick></control>
            </control>
        </control>

        <!-- Live TV channel refine blade -->
        <control type="group">
            <posx>-660</posx>
            <posy>0</posy>
            <visible>!Window.IsActive(virtualkeyboard) + String.Contains(Container.FolderPath,mode=livetv.refine)</visible>
            <include>animation_sub_menu</include>
            <control type="image">
                <left>0</left><width>500</width><height>100%</height><colordiffuse>fa0a0a0a</colordiffuse><aspectratio>stretch</aspectratio><texture background="true">diffuse/panel2.png</texture>
            </control>
            <control type="label">
                <posx>71</posx><posy>10</posy><width>400</width><height>100</height><font>Bold45</font><textcolor>ffffffff</textcolor><label>REFINE CHANNELS</label>
            </control>
            <control type="grouplist" id="9001">
                <posx>21</posx><posy>185</posy><width>458</width><height>770</height><itemgap>3</itemgap><orientation>vertical</orientation>
                <onleft>ClearProperty(ShowViewSubMenu,Home)</onleft><onleft>523</onleft>
                <onright>ClearProperty(ShowViewSubMenu,Home)</onright><onright>523</onright>
                <onback>ClearProperty(ShowViewSubMenu,Home)</onback><onback>523</onback>
                <onup>9001</onup><ondown>9001</ondown>
                <control type="button" id="9201"><include>SideBladeMenuButton</include><label>Category: $INFO[Window(Home).Property(LiveTV.Refine.Category)]</label><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.refine&amp;action=category)</onclick></control>
                <control type="button" id="9202"><include>SideBladeMenuButton</include><label>Channel name: $INFO[Window(Home).Property(LiveTV.Refine.Name)]</label><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.refine&amp;action=name)</onclick></control>
                <control type="button" id="9203"><include>SideBladeMenuButton</include><label>SHOW RESULTS</label><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.refine&amp;action=apply)</onclick></control>
                <control type="button" id="9204"><include>SideBladeMenuButton</include><label>CLEAR REFINEMENTS</label><onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=livetv.refine&amp;action=clear)</onclick></control>
                <control type="button" id="9205"><include>SideBladeMenuButton</include><label>Live TV menu and search</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>SetFocus(523)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.browse)</onclick></control>
                <control type="button" id="9206"><include>SideBladeMenuButton</include><label>TV guide</label><onclick>ClearProperty(ShowViewSubMenu,Home)</onclick><onclick>SetFocus(523)</onclick><onclick>Container.Update(plugin://skin.titan.bingie.lite/?mode=livetv.guide)</onclick></control>
            </control>
        </control>

        <!-- Movie/TV listing refine blade -->
        <control type="group">
            <posx>-660</posx>
            <posy>0</posy>
            <visible>!Window.IsActive(virtualkeyboard) + [Container.Content(movies) | Container.Content(tvshows)]</visible>
            <include>animation_sub_menu</include>
            <control type="image">
                <left>0</left>
                <width>500</width>
                <height>100%</height>
                <colordiffuse>fa0a0a0a</colordiffuse>
                <aspectratio>stretch</aspectratio>
                <texture background="true">diffuse/panel2.png</texture>
            </control>
            <control type="label">
                <posx>71</posx>
                <posy>10</posy>
                <width min="80" max="400">auto</width>
                <height>100</height>
                <font>Bold45</font>
                <align>left</align>
                <textcolor>ffffffff</textcolor>
                <label>[UPPERCASE]REFINE$INFO[Window(Home).Property(Refine.Count), (,)][/UPPERCASE]</label>
            </control>
            <control type="image">
                <posx>56</posx>
                <posy>160</posy>
                <width>388</width>
                <height>20</height>
                <texture>common/menu-separator2.png</texture>
            </control>
            <control type="image">
                <posx>56</posx>
                <posy>980</posy>
                <width>388</width>
                <height>20</height>
                <texture>common/menu-separator2.png</texture>
            </control>
            <control type="grouplist" id="9000">
                <posx>21</posx>
                <posy>185</posy>
                <width>458</width>
                <height>770</height>
                <itemgap>3</itemgap>
                <orientation>vertical</orientation>
                <onleft>523</onleft>
                <onright condition="String.IsEqual(Window(Home).Property(Refine.Changed),true)">RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.apply)</onright>
                <onright condition="!String.IsEqual(Window(Home).Property(Refine.Changed),true)">523</onright>
                <onback>523</onback>
                <onup>9000</onup>
                <ondown>9000</ondown>
                <control type="button" id="9112">
                    <include>SideBladeMenuButton</include>
                    <label>Preset: $INFO[Window(Home).Property(Refine.Preset)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.preset)</onclick>
                </control>
                <control type="button" id="9101">
                    <include>SideBladeMenuButton</include>
                    <label>Sort by: $INFO[Window(Home).Property(Refine.Sort)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.sort)</onclick>
                </control>
                <control type="button" id="9102">
                    <include>SideBladeMenuButton</include>
                    <label>Order: $INFO[Window(Home).Property(Refine.Order)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.order)</onclick>
                </control>
                <control type="button" id="9103">
                    <include>SideBladeMenuButton</include>
                    <label>Genres: $INFO[Window(Home).Property(Refine.Genres)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.genres)</onclick>
                </control>
                <control type="button" id="9115">
                    <include>SideBladeMenuButton</include>
                    <label>Theme: $INFO[Window(Home).Property(Refine.Theme)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.theme)</onclick>
                </control>
                <control type="button" id="9104">
                    <include>SideBladeMenuButton</include>
                    <label>Year: $INFO[Window(Home).Property(Refine.Year)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.year)</onclick>
                </control>
                <control type="button" id="9113">
                    <include>SideBladeMenuButton</include>
                    <label>Released only: $INFO[Window(Home).Property(Refine.Released)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.released)</onclick>
                </control>
                <control type="button" id="9116">
                    <include>SideBladeMenuButton</include>
                    <label>Released within: $INFO[Window(Home).Property(Refine.ReleaseWindow)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.release_window)</onclick>
                </control>
                <control type="button" id="9105">
                    <include>SideBladeMenuButton</include>
                    <label>Minimum rating: $INFO[Window(Home).Property(Refine.Rating)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.rating)</onclick>
                </control>
                <control type="button" id="9106">
                    <include>SideBladeMenuButton</include>
                    <label>Minimum votes: $INFO[Window(Home).Property(Refine.Votes)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.votes)</onclick>
                </control>
                <control type="button" id="9114">
                    <include>SideBladeMenuButton</include>
                    <label>Maximum votes: $INFO[Window(Home).Property(Refine.MaxVotes)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.max_votes)</onclick>
                </control>
                <control type="button" id="9107">
                    <include>SideBladeMenuButton</include>
                    <label>Language: $INFO[Window(Home).Property(Refine.Language)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.language)</onclick>
                </control>
                <control type="button" id="9111">
                    <include>SideBladeMenuButton</include>
                    <label>Original network: $INFO[Window(Home).Property(Refine.Network)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.network)</onclick>
                    <visible>Container.Content(tvshows)</visible>
                </control>
                <control type="button" id="9110">
                    <include>SideBladeMenuButton</include>
                    <label>MPAA rating: $INFO[Window(Home).Property(Refine.MPAA)]</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.mpaa)</onclick>
                    <visible>Container.Content(movies)</visible>
                </control>
                <control type="button" id="9108">
                    <include>SideBladeMenuButton</include>
                    <label>SHOW RESULTS</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.apply)</onclick>
                </control>
                <control type="button" id="9109">
                    <include>SideBladeMenuButton</include>
                    <label>CLEAR REFINEMENTS</label>
                    <onclick>RunPlugin(plugin://skin.titan.bingie.lite/?mode=refine.clear)</onclick>
                </control>
            </control>
        </control>

		<!--Header-->
        <include>Header</include>
	</controls>
</window>
