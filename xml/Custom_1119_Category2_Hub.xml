<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window id="1119">
    <defaultcontrol always="true">77777</defaultcontrol>
    <menucontrol>900</menucontrol>
    <include>CustomBingieWinProps</include>
    <include>BingieViews_WindowOpen_Fade</include>
    <controls>
        <include>GlobalBackground</include>
        <include>NowPlayingBackground</include>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture>colors/color_black.png</texture>
        </control>
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture>overlays/gradient_categories.png</texture>
        </control>
        <control type="list" id="77777">
            <orientation>vertical</orientation>
            <top>180</top>
            <left>137</left>
            <width>700</width>
            <height>300</height>
            <onleft>900</onleft>
            <onback>900</onback>
            <animation effect="fade" start="0" end="100" time="400">Visible</animation>
            <itemlayout width="700" height="90">
                <control type="label">
                    <left>32</left>
                    <width>650</width>
                    <height>90</height>
                    <label>$INFO[ListItem.Label]</label>
                    <align>left</align>
                    <aligny>center</aligny>
                    <font>BigLight50</font>
                    <textcolor>ffffffff</textcolor>
                </control>
            </itemlayout>
            <focusedlayout width="700" height="90">
                <control type="image">
                    <top>10</top>
                    <width>10</width>
                    <height>70</height>
                    <texture background="true" colordiffuse="ffe50914">bingie/line.png</texture>
                </control>
                <control type="label">
                    <left>32</left>
                    <width>650</width>
                    <height>90</height>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                    <font>Bold50</font>
                    <textcolor>ffffffff</textcolor>
                </control>
            </focusedlayout>
            <content>
                <item id="1">
                    <label>Movie Genres</label>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.pov.lite/?mode=navigator.genres&amp;menu_type=movie,return)</onclick>
                </item>
                <item id="2">
                    <label>TV Show Genres</label>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.pov.lite/?mode=navigator.genres&amp;menu_type=tvshow,return)</onclick>
                </item>
            </content>
        </control>
        <include content="Dim_Overlay">
            <param name="visibility" value="$EXP[IsMainMenuOpened]" />
        </include>
        <include>BingieSideBladeMainMenu</include>
    </controls>
</window>
