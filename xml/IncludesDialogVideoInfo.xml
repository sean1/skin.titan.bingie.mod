								<onclick>SetProperty(ratelike,1,Home)</onclick>
								<onclick>AlarmClock(showrateoptions,SetFocus(8000),00:01,silent)</onclick>
							</control>
							<control type="group" id="7002">
								<height>60</height>
								<control type="image">
									<visible>Window.IsVisible(1151)</visible>
									<top>12</top>
									<left>-150</left>
									<width>30</width>
									<height>30</height>
									<texture colordiffuse="ffffffff">dialogs/videoinfo/info/thumbs-up.png</texture>
									<animation reversible="false" type="Visible">
										<effect type="slide" start="0" end="-100" time="300" delay="100"/>
