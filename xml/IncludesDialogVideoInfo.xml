								<radioposy>13</radioposy>
								<radiowidth>30</radiowidth>
								<radioheight>30</radioheight>
								<textureradioonfocus/>
								<textureradioofffocus flipy="true" colordiffuse="ffffffff">bingie/rate/thumb_up_fo.png</textureradioofffocus>
								<textureradioonnofocus/>
								<textureradiooffnofocus flipy="true" colordiffuse="a6ffffff">bingie/rate/thumb_up_nf.png</textureradiooffnofocus>
								<selected>Window.IsVisible(1152)</selected>
								<onclick>SetProperty(ratedislike,1,Home)</onclick>
