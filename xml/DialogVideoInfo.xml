<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">8000</defaultcontrol>
	<onload condition="!String.IsEmpty(Window.Property(AdditionalInfo))">ClearProperty(AdditionalInfo)</onload>
    <onload>ClearProperty(PovInfoTmdb)</onload>
    <onload>ClearProperty(PovInfoType)</onload>
    <onload condition="[String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)] + !String.IsEmpty(ListItem.UniqueID(tmdb))">SetProperty(PovInfoTmdb,$INFO[ListItem.UniqueID(tmdb)])</onload>
    <onload condition="String.IsEqual(ListItem.DBTYPE,movie)">SetProperty(PovInfoType,movie)</onload>
    <onload condition="String.IsEqual(ListItem.DBTYPE,tvshow)">SetProperty(PovInfoType,tvshow)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(ListItem.TVShowID))">ClearProperty(ListItem.TVShowID,Home)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(BaseWindow))">ClearProperty(BaseWindow,Home)</onload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(ListItem.TVShowID)) + String.IsEmpty(Window(Home).Property(KeepTVShowID))">ClearProperty(ListItem.TVShowID,Home)</onunload>
	<onunload condition="!String.IsEmpty(Window.Property(AdditionalInfo))">ClearProperty(AdditionalInfo)</onunload>
    <onunload>ClearProperty(PovInfoTmdb)</onunload>
    <onunload>ClearProperty(PovInfoType)</onunload>
    <controls>
        <include condition="true">BingieInfo</include>
	</controls>
</window>
