							<height>325</height>
                            <orientation>vertical</orientation>
							<itemgap>10</itemgap>
                            <onup>noop</onup>
	                            <ondown condition="Integer.IsGreater(Container(50).NumItems,0)">550</ondown>
								<ondown condition="!Integer.IsGreater(Container(50).NumItems,0)">noop</ondown>
                            <scrolltime tween="sine" easing="inout">200</scrolltime>
							<pagecontrol>300</pagecontrol>

							<!-- Play the next unwatched POV episode, or start with S01E01. -->
                            <control type="radiobutton" id="51">
								<visible>$EXP[IsTvShowDBTypeNoFallback] + !String.IsEmpty(ListItem.UniqueID(tmdb))</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
								<label>$LOCALIZE[208]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
								<radioheight>22</radioheight>
								<onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(PlayShow,RunPlugin(plugin://plugin.video.pov.lite/?mode=smart_play_media&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]),00:01,silent)</onclick>
                            </control>

							<!-- Play the selected POV season from its first episode. -->
							<control type="radiobutton" id="54">
								<visible>[String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.Property(DBTYPE),season)] + !String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Season)</visible>
								<include>Bingie_InfoDialog_Button_Default_Defs</include>
								<include content="Bingie_InfoDialog_Button_Texture">
									<param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
								</include>
								<label>$LOCALIZE[208]$INFO[ListItem.Season, $LOCALIZE[20373] ,]</label>
								<radioposx>17</radioposx>
								<radiowidth>22</radiowidth>
								<radioheight>22</radioheight>
								<onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(PlaySeason,RunPlugin(plugin://plugin.video.pov.lite/?mode=play_media&amp;mediatype=episode&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]&amp;season=$INFO[ListItem.Season]&amp;episode=1),00:01,silent)</onclick>
							</control>

                            <!-- Play -->
                            <control type="radiobutton" id="80">
                                <!-- <visible>false</visible> -->
								<visible>!Control.IsVisible(90) + !$EXP[IsTvShowDBTypeNoFallback] + !String.IsEqual(ListItem.DBTYPE,season) + !String.IsEqual(ListItem.Property(DBTYPE),season)</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
                                <label>$LOCALIZE[208]$INFO[ListItem.Season, $LOCALIZE[20373] ,]$INFO[ListItem.Episode,: $LOCALIZE[20359] ,]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
								<!-- Set InfoDialog as BaseWindow if NOT clicked via SendClick -->
								<onclick condition="!$EXP[IsTvShowDBTypeNoFallback]">SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick condition="!String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FileNameAndPath]),00:01,silent)</onclick>
								<onclick condition="String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FolderPath]),00:01,silent)</onclick>
							</control>

                            <!-- Resume -->
                            <control type="radiobutton" id="90">
                                <!-- <visible>false</visible> -->
								<visible>ListItem.IsResumable</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
                                <label>$LOCALIZE[13404]$INFO[ListItem.Season, $LOCALIZE[31871],: ]$INFO[ListItem.Episode,$LOCALIZE[31873]. ,]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
                                <!-- Set InfoDialog as BaseWindow if NOT clicked via SendClick -->
                                <onclick condition="!$EXP[IsTvShowDBTypeNoFallback]">SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick condition="!String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FileNameAndPath],resume),00:01,silent)</onclick>
								<onclick condition="String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FolderPath],resume),00:01,silent)</onclick>
                            </control>

							<!-- Play from beginning -->
                            <control type="radiobutton" id="52">
                                <!-- <visible>false</visible> -->
                                <visible>Control.IsVisible(90) | [Control.IsVisible(5050) + Container(5050).ListItem.IsResumable]</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play_beginning.png"/>
                                </include>
                                <label>$LOCALIZE[320000]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
                                <onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
                                <!-- play episode -->
                                <onclick condition="!Control.IsVisible(5050) + String.IsEqual(ListItem.DBTYPE,episode) + !String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia(videodb://tvshows/$INFO[ListItem.DBID]),00:01,silent)</onclick>
                                <!-- play movie -->
                                <onclick condition="!Control.IsVisible(5050) + String.IsEqual(ListItem.DBTYPE,movie) + !String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia(videodb://movies/$INFO[ListItem.DBID]),00:01,silent)</onclick>
                                <!-- fallback to native play button -->
                                <onclick condition="[String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,movie)] + String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia($INFO[ListItem.FileNameAndPath],noresume),00:01,silent)</onclick>
                                <!-- only if FILE FOLDERS structured with seasons folders -->
                                <onclick condition="Control.IsVisible(5050) + String.IsEqual(Container(5050).ListItem.Path)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[Container(5050).ListItem.Path],isdir,playoffset=$VAR[NextUpEpisodeMinusOne]),00:01,silent)</onclick>
								<!-- seasons folders -->
								<onclick condition="Control.IsVisible(5050) + !String.IsEqual(Container(5050).ListItem.Path)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[Container(5050).ListItem.FileNameAndPath],noresume),00:01,silent)</onclick>
                            </control>


							<!-- Browse POV seasons and episodes. -->
                            <control type="radiobutton" id="53">
								<visible>$EXP[IsTvShowDBTypeNoFallback] + !String.IsEmpty(ListItem.UniqueID(tmdb))</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/more_episodes.png"/>
                                </include>
								<label>Episodes</label>
								<radioposy>22</radioposy>
                                <radioposx>16</radioposx>
                                <radiowidth>24</radiowidth>
                                <radioheight>24</radioheight>
                                <onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(BrowseEpisodes,ActivateWindow(Videos,plugin://plugin.video.pov.lite/?mode=build_season_list&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)],return),00:01,silent)</onclick>
							</control>

							<!-- Rate this title -->
                            <control type="radiobutton" id="58">
								<visible>!Container.Content(tvshows)</visible>
                                <visible>false + Control.IsEnabled(7)</visible>
                                <visible>[String.IsEmpty(ListItem.UserRating) + String.IsEmpty(Window(Home).Property(RateTitle))] | [String.IsEqual(Window(Home).Property(RateTitle.Action),reset) + String.IsEqual(Window(Home).Property(RateTitle),ListItem.DBID)]</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/thumbs-up.png"/>
                                </include>
                                <label>$LOCALIZE[31854]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>24</radiowidth>
                                <radioheight>24</radioheight>
                                <onclick>SetProperty(showrateoptions,1,Home)</onclick>
                                <onclick>SetProperty(ratebuttonposition,$INFO[Container(8000).Position],Home)</onclick>
                                <onclick>SetFocus(700)</onclick>
                                <include>Fade_Rate_Button</include>
                            </control>

							<!-- Change rating - thumbs up -->
                            <control type="radiobutton" id="591">
                                <visible>false</visible>
                                <visible>[Integer.IsGreaterOrEqual(ListItem.UserRating,5) + String.IsEmpty(Window(Home).Property(RateTitle))] | [String.IsEqual(Window(Home).Property(RateTitle.Action),like) + String.IsEqual(Window(Home).Property(RateTitle),ListItem.DBID)]</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/thumbs-up.png"/>
                                </include>
                                <label>$LOCALIZE[31855]</label>
                                <radioposx>15</radioposx>
                                <radiowidth>24</radiowidth>
                                <radioheight>24</radioheight>
                                <onclick>SetProperty(showrateoptions,1,Home)</onclick>
                                <onclick>SetProperty(ratebuttonposition,$INFO[Container(8000).Position],Home)</onclick>
                                <onclick>SetFocus(700)</onclick>
                                <include>Fade_Rate_Button</include>
                            </control>

							<!-- Changed Rating Position -->

							<!-- Change rating - thumbs down -->
                            <control type="radiobutton" id="592">
                                <visible>false</visible>
                                <visible>[!String.IsEmpty(ListItem.UserRating) + Integer.IsLessOrEqual(ListItem.UserRating,5) + String.IsEmpty(Window(Home).Property(RateTitle))] | [String.IsEqual(Window(Home).Property(RateTitle.Action),dislike) + String.IsEqual(Window(Home).Property(RateTitle),ListItem.DBID)]</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/thumbs-down.png"/>
                                </include>
                                <label>$LOCALIZE[31855]</label>
                                <radioposx>15</radioposx>
								<radioposy>22</radioposy>
                                <radiowidth>24</radiowidth>
                                <radioheight>24</radioheight>
                                <onclick>SetProperty(showrateoptions,1,Home)</onclick>
                                <onclick>SetProperty(ratebuttonposition,$INFO[Container(8000).Position],Home)</onclick>
                                <onclick>SetFocus(700)</onclick>
                                <include>Fade_Rate_Button</include>
                            </control>

						</control>
					</control>
				</control>
			</control>
		</control>
	</control>
	</include>

    <include name="Bingie_InfoDialog_Button_Default_Defs">
        <width>550</width>
        <height>65</height>
        <aligny>center</aligny>
        <align>left</align>
        <font>Plots</font>
        <textoffsetx>55</textoffsetx>
		<textoffsety>0</textoffsety>
		<radioposy>21</radioposy>
		<textcolor>ffffffff</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<disabledcolor>ffaaaaaa</disabledcolor>
		<texturenofocus colordiffuse="ccffffff">colors/color_black.png</texturenofocus>
		<texturefocus>colors/color_white.png</texturefocus>
    </include>

    <include name="Bingie_InfoDialog_Button_Texture">
		<textureradioonfocus colordiffuse="ff000000">$PARAM[radiotexture]</textureradioonfocus>
		<textureradioofffocus colordiffuse="ff000000">$PARAM[radiotexture]</textureradioofffocus>
		<textureradioonnofocus colordiffuse="ffffffff">$PARAM[radiotexture]</textureradioonnofocus>
		<textureradiooffnofocus colordiffuse="ffffffff">$PARAM[radiotexture]</textureradiooffnofocus>
		<textureradiooffdisabled colordiffuse="ffaaaaaa">$PARAM[radiotexture]</textureradiooffdisabled>
    </include>

    <include name="Fade_Rate_Button">
        <animation effect="fade" start="100" end="0" time="250" condition="!String.IsEmpty(Window(Home).Property(showrateoptions)) | Window.IsVisible(1151) | Window.IsVisible(1152)">Conditional</animation>
    </include>

