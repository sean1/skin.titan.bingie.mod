<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<includes>
    <!--Overlay-->
    <include name="DialogOverlay">
        <!--Dialog Overlay default-->
        <control type="image">
            <include>FullscreenDimensions</include>
            <texture fallback="diffuse/background.png">overlays/black.png</texture>
            <visible>!Control.IsVisible(507)</visible>
            <visible>true</visible>
        </control>
    </include>

    <include name="bgColorDiffuse">
        <colordiffuse>None</colordiffuse>
    </include>


    <include name="DialogOverlayExtra">
        <!-- dim screen overlay used in certain dialogs -->
        <control type="image">
            <include>FullscreenDimensions</include>
            <texture>diffuse/background.png</texture>
            <colordiffuse>aawhite</colordiffuse>
            <visible>true</visible>
        </control>
        <control type="image">
            <include>FullscreenDimensions</include>
            <texture>diffuse/background.png</texture>
            <colordiffuse>aa0f0f0f</colordiffuse>
            <visible>true</visible>
        </control>
    </include>


<!-- Side Menu Background Panel Color -->
    <include name="Dim_Overlay">
        <control type="image">
            <include>FullscreenDimensions</include>
            <visible>$PARAM[visibility]</visible>
			<texture>overlays/background.png</texture>
            <colordiffuse>black</colordiffuse>
            <animation time="300" effect="fade" start="0" end="100" reversible="true" easing="inout">Visible</animation>
        </control>
    </include>

    <!--Global Background -->
    <include name="GlobalBackground">

        <!-- background panel -->
        <!-- global background -->
        <control type="multiimage" id="99004">
            <include>HiddenObject</include>
            <include condition="![Window.IsActive(Home) | Window.IsActive(1110) | Window.IsActive(1111) | Window.IsActive(1112) | Window.IsActive(1113)]">FullscreenDimensions</include>
            <imagepath background="true" fallback="colors/color_black.png">$VAR[backgroundVar]</imagepath>
            <aspectratio>scale</aspectratio>
            <fadetime>800</fadetime>
            <include condition="true + !true + !true">bgColorDiffuse</include>
            <loop>yes</loop>
        </control>
        <!-- fanart image background (hidden with visibility conditions)-->
        <control type="image" id="99006">
            <left>-1</left>
            <top>-1</top>
            <width>1</width>
            <height>1</height>
            <texture background="true">$VAR[fanartBackground]</texture>
            <visible>true | !String.IsEmpty(Window(Home).Property(bingieviews)) | Control.IsVisible(523) | Control.IsVisible(526)</visible>
            <include condition="Window.IsMedia">disabledFanart</include>
        </control>
        <!-- hidden container for categories fanart -->
        <control type="list" id="99007">
            <include>HiddenObject</include>
            <visible>String.IsEqual(ListItem.Property(DBTYPE),category)</visible>
            <itemlayout/>
            <focusedlayout/>
            <content limit="5" sortby="random">$VAR[ItemArtContentRandomizer]</content>
        </control>

		<include condition="true + false">Native_extraFanartBackground</include>

		<include condition="![Window.IsActive(Home) | Window.IsActive(1110) | Window.IsActive(1111) | Window.IsActive(1112) | Window.IsActive(1113)]">DialogOverlay</include>
    </include>

	<!-- Extra Fanart -->
