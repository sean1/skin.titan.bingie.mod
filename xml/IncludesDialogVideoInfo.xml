<includes>

	<!-- Bingie Info -->
	<include name="BingieInfo">
		<control type="group">
			<!-- Keep More Info on the same permanent black canvas as Home. -->
			<control type="image">
				<include>FullscreenDimensions</include>
				<texture>colors/color_black.png</texture>
			</control>
			<include>BingieRowTrailerPreviewWindow</include>
			<include content="BingieSpotlightCornerImage">
				<param name="visibility" value="!Player.HasVideo | [!String.IsEmpty(Window(Home).Property(BingieTrailerPreview)) + String.IsEmpty(Window(Home).Property(BingieTrailerPreviewReady))]" />
				<param name="image" value="$INFO[Window.Property(PovInfoFanart)]" />
			</include>
			<!-- Dialog Info -->
			<control type="group">
				<animation effect="fade" start="0" end="100" time="200">Visible</animation>
				<visible>!ControlGroup(6000).HasFocus()</visible>
				<visible>String.IsEmpty(Window(Home).Property(Recommendations.IsLoading))</visible>
				<visible>!String.IsEqual(ListItem.Property(item.type),person)</visible>
				<!-- Hidden My Rating Button -->
				<control type="button" id="7">
					<include>HiddenObject</include>
				</control>

				<!-- Hidden List to Get First/Next Episode -->
				<control type="list" id="5050">
                    <visible allowhiddenfocus="true">!String.IsEmpty(ListItem.DBID) + String.IsEqual(ListItem.DBTYPE,tvshow)</visible>
                    <visible>Integer.IsGreater(Container(5050).NumItems,0) + !Container(5050).IsUpdating</visible>
					<left>-100</left>
					<top>-100</top>
					<preloaditems>1</preloaditems>
					<itemlayout/>
					<focusedlayout/>
					<content sortorder="ascending" sortby="playcount" limit="1">$VAR[InfoDialogNextUpContent]</content>
				</control>

				<!-- Native Kodi cast provider populated by POV metadata. -->
				<control type="panel" id="50">
					<visible allowhiddenfocus="true">Integer.IsGreater(Container(50).NumItems,0)</visible>
					<left>-2000</left>
					<top>-2000</top>
					<width>1</width>
					<height>1</height>
					<orientation>horizontal</orientation>
					<preloaditems>1</preloaditems>
					<scrolltime tween="quadratic">400</scrolltime>
					<itemlayout width="238" height="320">
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" diffuse="diffuse/poster3.png" fallback="DefaultActorPoster.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="true" align="center" aligny="top">scale</aspectratio>
							<bordersize>8</bordersize>
						</control>
						<control type="image">
							<left>8</left>
							<bottom>10</bottom>
							<width>214</width>
							<height>96</height>
							<texture>overlays/gradient_episodes.png</texture>
							<aspectratio>stretch</aspectratio>
							<colordiffuse>ffffffff</colordiffuse>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>47</bottom>
							<height>30</height>
							<font>Reg22</font>
							<textcolor>ffffffff</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>18</bottom>
							<height>28</height>
							<font>Reg20</font>
							<textcolor>a6ffffff</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout width="238" height="320">
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" diffuse="diffuse/poster3.png" fallback="DefaultActorPoster.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="true" align="center" aligny="top">scale</aspectratio>
							<bordersize>8</bordersize>
						</control>
						<control type="image">
							<width>230</width>
							<height>310</height>
							<texture background="true" border="12">bingie/border/poster_fo_4.png</texture>
						</control>
						<control type="image">
							<left>8</left>
							<bottom>10</bottom>
							<width>214</width>
							<height>96</height>
							<texture>overlays/gradient_episodes.png</texture>
							<aspectratio>stretch</aspectratio>
							<colordiffuse>ffffffff</colordiffuse>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>47</bottom>
							<height>30</height>
							<font>Reg22</font>
							<textcolor>ffffffff</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<left>20</left>
							<right>20</right>
							<bottom>18</bottom>
							<height>28</height>
							<font>Reg20</font>
							<textcolor>a6ffffff</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</focusedlayout>
				</control>
				<!-- Hidden POV providers load independently so optional visual shelves collapse without gaps. -->
				<control type="list" id="566">
					<visible allowhiddenfocus="true">$EXP[PovDialogCollectionReady] + [!String.IsEmpty(Window.Property(PovInfoCollectionId)) | !String.IsEqual(ListItem.Property(PovLiteItem),true)]</visible>
					<left>-3000</left>
					<top>-3000</top>
					<width>1</width>
					<height>1</height>
					<itemlayout width="1" height="1" />
					<focusedlayout width="1" height="1" />
					<content limit="15" target="videos" browse="never">$VAR[PovInThisCollectionPath]</content>
				</control>
				<control type="list" id="565">
					<visible allowhiddenfocus="true">$EXP[PovDialogMoreLikeThisReady]</visible>
					<left>-3000</left>
					<top>-3000</top>
					<width>1</width>
					<height>1</height>
					<itemlayout width="1" height="1" />
					<focusedlayout width="1" height="1" />
					<content limit="15" target="videos" browse="never">$VAR[PovMoreLikeThisPath]</content>
				</control>

				<!-- Home-style shelf stack: focused rows stay anchored while later rows remain visible below. -->
				<control type="grouplist">
					<left>126</left>
					<top>650</top>
					<width>1668</width>
					<height>924</height>
					<orientation>vertical</orientation>
					<usecontrolcoords>true</usecontrolcoords>
					<itemgap>2</itemgap>
					<animation effect="slide" end="0,-382" time="300" tween="cubic" easing="inout" condition="[Control.HasFocus(563) | Control.HasFocus(560)] + Integer.IsGreater(Container(50).NumItems,0)">Conditional</animation>
					<animation effect="slide" end="0,-272" time="300" tween="cubic" easing="inout" condition="Control.HasFocus(560) + Integer.IsGreater(Container(566).NumItems,0)">Conditional</animation>

					<!-- Control 50 is reserved by Kodi, so this normal panel proxies its cast data through POV. -->
					<control type="group">
						<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
						<width>1668</width>
						<height>380</height>
						<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(563) | Control.HasFocus(560)">Conditional</animation>
						<control type="label">
							<width>1668</width>
							<height>45</height>
							<font>Bold31</font>
							<textcolor>ffffffff</textcolor>
							<label>$LOCALIZE[206]</label>
						</control>
						<control type="panel" id="550">
							<visible allowhiddenfocus="true">true</visible>
							<top>50</top>
							<width>1668</width>
							<height>330</height>
							<orientation>horizontal</orientation>
							<preloaditems>4</preloaditems>
							<scrolltime tween="quadratic">400</scrolltime>
							<onup>8000</onup>
							<ondown condition="Integer.IsGreater(Container(563).NumItems,0)">563</ondown>
							<ondown condition="!Integer.IsGreater(Container(563).NumItems,0) + Integer.IsGreater(Container(560).NumItems,0)">560</ondown>
							<ondown condition="!Integer.IsGreater(Container(563).NumItems,0) + !Integer.IsGreater(Container(560).NumItems,0)">550</ondown>
							<itemlayout width="238" height="320">
								<include content="PovCastCard"><param name="focused" value="false" /></include>
							</itemlayout>
							<focusedlayout width="238" height="320">
								<include content="PovCastCard"><param name="focused" value="true" /></include>
							</focusedlayout>
							<content><include content="PovCastItems" /></content>
						</control>
					</control>

					<control type="group">
						<visible>Integer.IsGreater(Container(566).NumItems,0)</visible>
						<width>1668</width>
						<height>270</height>
						<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(550)">Conditional</animation>
						<animation effect="fade" start="100" end="0" time="250" condition="Control.HasFocus(560)">Conditional</animation>
						<control type="label">
							<width>1668</width>
							<height>45</height>
							<font>Bold31</font>
							<textcolor>ffffffff</textcolor>
							<label>In This Collection</label>
						</control>
						<control type="panel" id="563">
							<visible allowhiddenfocus="true">true</visible>
							<top>50</top>
							<width>1668</width>
							<height>220</height>
							<orientation>horizontal</orientation>
							<preloaditems>2</preloaditems>
							<scrolltime tween="quadratic">400</scrolltime>
							<onup condition="Integer.IsGreater(Container(50).NumItems,0)">550</onup>
							<onup condition="!Integer.IsGreater(Container(50).NumItems,0)">8000</onup>
							<ondown condition="Integer.IsGreater(Container(560).NumItems,0)">560</ondown>
							<ondown condition="!Integer.IsGreater(Container(560).NumItems,0)">563</ondown>
							<itemlayout width="333" height="193">
								<control type="group">
									<width>335</width>
									<height>195</height>
									<include content="PovMoreLikeThisCard"><param name="focused" value="false" /></include>
								</control>
							</itemlayout>
							<focusedlayout width="333" height="193">
								<control type="group">
									<width>335</width>
									<height>195</height>
									<include content="PovMoreLikeThisCard"><param name="focused" value="true" /></include>
								</control>
							</focusedlayout>
							<content><include>PovCollectionItems</include></content>
						</control>
					</control>

					<control type="group">
						<visible>Integer.IsGreater(Container(565).NumItems,0)</visible>
						<width>1668</width>
						<height>270</height>
						<animation effect="fade" start="100" end="50" time="100" condition="Control.HasFocus(550) | Control.HasFocus(563)">Conditional</animation>
						<control type="label">
							<width>1668</width>
							<height>45</height>
							<font>Bold31</font>
							<textcolor>ffffffff</textcolor>
							<label>$LOCALIZE[31622]</label>
						</control>
						<control type="panel" id="560">
							<visible allowhiddenfocus="true">true</visible>
							<top>50</top>
							<width>1668</width>
							<height>220</height>
							<orientation>horizontal</orientation>
							<preloaditems>2</preloaditems>
							<scrolltime tween="quadratic">400</scrolltime>
							<onup condition="Integer.IsGreater(Container(563).NumItems,0)">563</onup>
							<onup condition="!Integer.IsGreater(Container(563).NumItems,0) + Integer.IsGreater(Container(50).NumItems,0)">550</onup>
							<onup condition="!Integer.IsGreater(Container(563).NumItems,0) + !Integer.IsGreater(Container(50).NumItems,0)">8000</onup>
							<ondown>560</ondown>
							<itemlayout width="333" height="193">
								<control type="group">
									<width>335</width>
									<height>195</height>
									<include content="PovMoreLikeThisCard"><param name="focused" value="false" /></include>
								</control>
							</itemlayout>
							<focusedlayout width="333" height="193">
								<control type="group">
									<width>335</width>
									<height>195</height>
									<include content="PovMoreLikeThisCard"><param name="focused" value="true" /></include>
								</control>
							</focusedlayout>
							<content><include>PovMoreLikeThisItems</include></content>
						</control>
					</control>
				</control>

				<!-- Additional Info Overlay -->
				<control type="image">
					<visible>!String.IsEmpty(Window.Property(AdditionalInfo)) + !String.IsEqual(Window.Property(AdditionalInfo),set)</visible>
					<width>100%</width>
					<height>100%</height>
					<texture background="true" colordiffuse="$VAR[BingiePanelColor]">colors/color_white.png</texture>
					<animation effect="fade" start="0" end="100" time="300" condition="!Player.HasVideo">Visible</animation>
					<animation effect="fade" start="0" end="70" time="300" condition="Player.HasVideo">Visible</animation>
				</control>

				<!-- Dialog Info Details -->
				<control type="grouplist">
                    <width>1760</width>
                    <include>BingieLeftDefs</include>
                    <top>10</top>
                    <orientation>vertical</orientation>
                    <usecontrolcoords>true</usecontrolcoords>
                    <itemgap>10</itemgap>
				<control type="grouplist">
					<include>Animation_Right_Delay_2</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<control type="image" id="90005">
						<height>190</height>
						<width>490</width>
						<align>left</align>
						<aspectratio align="center" aligny="center">keep</aspectratio>
						<texture background="true" fallback="colors/color_transparent.png">$VAR[BingieInfoClearlogo]</texture>
					</control>
					<!-- Movie Title with no Clearlogo -->
					<control type="textbox" id="90006">
						<visible>String.EndsWith(Control.GetLabel(90005),color_transparent.png)</visible>
						<top>-189</top>
						<height>184</height>
						<width max="650">auto</width>
						<font>Title</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieInfoLabel]</label>
						<include condition="$PARAM[genre_adjust]">Bingie_TextTitle_Adjust_Genre_Anim</include>
						<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
					</control>
					<control type="group">
						<top>-2</top>
						<width>1000</width>
						<height>35</height>
						<include>SpotlightRowDetails</include>
					</control>
				</control>
				<control type="grouplist">
					<top>228</top>
					<include>Animation_Right_Delay</include>
					<usecontrolcoords>true</usecontrolcoords>
					<orientation>vertical</orientation>
					<!-- Media File Location -->
					<!-- Sublabel -->
					<control type="label" id="823">
						<visible>!String.IsEmpty(Control.GetLabel(823))</visible>
						<visible>!$EXP[IsMovieDBType]</visible>
						<animation effect="fade" start="100" end="0" time="200" condition="!String.IsEmpty(Window.Property(AdditionalInfo))">Conditional</animation>
						<top>34</top>
						<height>12</height>
						<width>100%</width>
						<font>Plots</font>
						<align>left</align>
						<aligny>center</aligny>
						<textcolor>ffffffff</textcolor>
						<label>$VAR[BingieDialogEpisodeInfoLabel]</label>
					</control>

					<!-- Plot -->
					<control type="group">
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast) | String.IsEqual(Window.Property(AdditionalInfo),plot)">Conditional</animation>
						<top>19</top>
						<height>120</height>
						<width>820</width>
						<control type="textbox">
							<visible>String.IsEmpty(ListItem.Set)</visible>
							<width>820</width>
							<height>120</height>
							<textcolor>b3ffffff</textcolor>
							<align>left</align>
							<font>Plots</font>
							<label>$VAR[BingieDialogInfoPlot]</label>
							<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
						</control>
						<control type="textbox">
							<visible>!String.IsEmpty(ListItem.Set)</visible>
							<width>820</width>
							<height>120</height>
							<textcolor>b3ffffff</textcolor>
							<align>left</align>
							<font>Plots</font>
							<label>$VAR[BingieDialogInfoPlot]</label>
							<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
						</control>
					</control>

					<!-- buttons -->
					<control type="group">
						<top>33</top>
						<width>550</width>
						<posx>1</posx>
						<animation effect="fade" start="100" end="0" time="200" condition="String.IsEqual(Window.Property(AdditionalInfo), plot) | String.IsEqual(Window.Property(AdditionalInfo),similar) | String.IsEqual(Window.Property(AdditionalInfo),cast)">Conditional</animation>
						<animation effect="slide" start="0,0" end="0,41" time="0" delay="0" condition="String.IsEqual(Window.Property(AdditionalInfo),set)">Conditional</animation>
						<!-- progress bar for resume buttons -->

							<control type="progress">
								<visible>Control.HasFocus(90) | [Control.HasFocus(51) + Container(5050).ListItem.IsResumable]</visible>
								<animation effect="fade" start="0" end="100" time="0" delay="125">Visible</animation>
								<posy>29</posy>
								<left>377</left>
								<width>155</width>
								<height>8</height>
								<texturebg colordiffuse="ff929699" border="0">diffuse/panel2.png</texturebg>
								<lefttexture/>
								<midtexture colordiffuse="ffe50914" border="4">diffuse/panel2.png</midtexture>
								<righttexture/>
								<info>ListItem.PercentPlayed</info>
							</control>
							<control type="progress">
								<visible>Control.IsVisible(5050) + String.IsEqual(ListItem.dbtype,tvshow) + [Control.HasFocus(51) + Container(5050).ListItem.IsResumable]</visible>
								<animation effect="fade" start="0" end="100" time="0" delay="125">Visible</animation>
								<posy>29</posy>
								<left>377</left>
								<width>155</width>
								<height>8</height>
								<texturebg colordiffuse="ff929699" border="0">diffuse/panel2.png</texturebg>
								<lefttexture/>
								<midtexture colordiffuse="ffe50914" border="4">diffuse/panel2.png</midtexture>
								<righttexture/>
								<info>Container(5050).ListItem.PercentPlayed</info>
							</control>

						<control type="grouplist" id="8000">
							<width>550</width>
							<height>325</height>
                            <orientation>vertical</orientation>
							<itemgap>10</itemgap>
                            <onup>noop</onup>
	                            <ondown condition="Integer.IsGreater(Container(50).NumItems,0)">550</ondown>
								<ondown condition="!Integer.IsGreater(Container(50).NumItems,0) + Integer.IsGreater(Container(563).NumItems,0)">563</ondown>
								<ondown condition="!Integer.IsGreater(Container(50).NumItems,0) + !Integer.IsGreater(Container(563).NumItems,0) + Integer.IsGreater(Container(560).NumItems,0)">560</ondown>
								<ondown condition="!Integer.IsGreater(Container(50).NumItems,0) + !Integer.IsGreater(Container(563).NumItems,0) + !Integer.IsGreater(Container(560).NumItems,0)">noop</ondown>
                            <scrolltime tween="sine" easing="inout">200</scrolltime>
							<pagecontrol>300</pagecontrol>

							<!-- Play the next unwatched POV episode, or start with S01E01. -->
                            <control type="radiobutton" id="51">
								<visible>$EXP[IsTvShowDBTypeNoFallback] + !String.IsEmpty(ListItem.UniqueID(tmdb))</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
								<label>$LOCALIZE[208]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
								<radioheight>22</radioheight>
								<onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(PlayShow,RunPlugin(plugin://skin.titan.bingie.lite/?mode=smart_play_media&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]),00:01,silent)</onclick>
                            </control>

							<!-- Play the selected POV season from its first episode. -->
							<control type="radiobutton" id="54">
								<visible>[String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.Property(DBTYPE),season)] + !String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Season)</visible>
								<include>Bingie_InfoDialog_Button_Default_Defs</include>
								<include content="Bingie_InfoDialog_Button_Texture">
									<param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
								</include>
								<label>$LOCALIZE[208]$INFO[ListItem.Season, $LOCALIZE[20373] ,]</label>
								<radioposx>17</radioposx>
								<radiowidth>22</radiowidth>
								<radioheight>22</radioheight>
								<onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(PlaySeason,RunPlugin(plugin://skin.titan.bingie.lite/?mode=play_media&amp;mediatype=episode&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]&amp;season=$INFO[ListItem.Season]&amp;episode=1),00:01,silent)</onclick>
							</control>

                            <!-- Play -->
                            <control type="radiobutton" id="80">
                                <!-- <visible>false</visible> -->
								<visible>!Control.IsVisible(90) + !$EXP[IsTvShowDBTypeNoFallback] + !String.IsEqual(ListItem.DBTYPE,season) + !String.IsEqual(ListItem.Property(DBTYPE),season)</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
                                <label>$LOCALIZE[208]$INFO[ListItem.Season, $LOCALIZE[20373] ,]$INFO[ListItem.Episode,: $LOCALIZE[20359] ,]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
								<!-- Set InfoDialog as BaseWindow if NOT clicked via SendClick -->
								<onclick condition="!$EXP[IsTvShowDBTypeNoFallback]">SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick condition="!String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FileNameAndPath]),00:01,silent)</onclick>
								<onclick condition="String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FolderPath]),00:01,silent)</onclick>
							</control>

                            <!-- Resume -->
                            <control type="radiobutton" id="90">
                                <!-- <visible>false</visible> -->
								<visible>ListItem.IsResumable</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play2.png"/>
                                </include>
                                <label>$LOCALIZE[13404]$INFO[ListItem.Season, $LOCALIZE[31871],: ]$INFO[ListItem.Episode,$LOCALIZE[31873]. ,]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
                                <!-- Set InfoDialog as BaseWindow if NOT clicked via SendClick -->
                                <onclick condition="!$EXP[IsTvShowDBTypeNoFallback]">SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick condition="!String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FileNameAndPath],resume),00:01,silent)</onclick>
								<onclick condition="String.IsEmpty(ListItem.FileNameAndPath)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[ListItem.FolderPath],resume),00:01,silent)</onclick>
                            </control>

							<!-- Play from beginning -->
                            <control type="radiobutton" id="52">
                                <!-- <visible>false</visible> -->
                                <visible>Control.IsVisible(90) | [Control.IsVisible(5050) + Container(5050).ListItem.IsResumable]</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/play_beginning.png"/>
                                </include>
                                <label>$LOCALIZE[320000]</label>
                                <radioposx>17</radioposx>
                                <radiowidth>22</radiowidth>
                                <radioheight>22</radioheight>
                                <onclick>SetProperty(BaseWindow,1,Home)</onclick>
								<onclick>Dialog.Close(movieinformation)</onclick>
                                <!-- play episode -->
                                <onclick condition="!Control.IsVisible(5050) + String.IsEqual(ListItem.DBTYPE,episode) + !String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia(videodb://tvshows/$INFO[ListItem.DBID]),00:01,silent)</onclick>
                                <!-- play movie -->
                                <onclick condition="!Control.IsVisible(5050) + String.IsEqual(ListItem.DBTYPE,movie) + !String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia(videodb://movies/$INFO[ListItem.DBID]),00:01,silent)</onclick>
                                <!-- fallback to native play button -->
                                <onclick condition="[String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,movie)] + String.IsEmpty(ListItem.DBID)">AlarmClock(PlayMovie,PlayMedia($INFO[ListItem.FileNameAndPath],noresume),00:01,silent)</onclick>
									<!-- Hidden next-up list contains a concrete episode; bypass its resume point. -->
									<onclick condition="Control.IsVisible(5050)">AlarmClock(PlayMovie,PlayMedia($ESCINFO[Container(5050).ListItem.FileNameAndPath],noresume),00:01,silent)</onclick>
                            </control>


							<!-- Browse POV seasons and episodes. -->
                            <control type="radiobutton" id="53">
								<visible>$EXP[IsTvShowDBTypeNoFallback] + !String.IsEmpty(ListItem.UniqueID(tmdb))</visible>
                                <include>Bingie_InfoDialog_Button_Default_Defs</include>
                                <include content="Bingie_InfoDialog_Button_Texture">
                                    <param name="radiotexture" value="dialogs/videoinfo/info/more_episodes.png"/>
                                </include>
								<label>Episodes</label>
								<radioposy>22</radioposy>
                                <radioposx>16</radioposx>
                                <radiowidth>24</radiowidth>
                                <radioheight>24</radioheight>
								<onclick>Dialog.Close(movieinformation)</onclick>
								<onclick>AlarmClock(BrowseEpisodes,ActivateWindow(Videos,plugin://skin.titan.bingie.lite/?mode=build_season_list&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)],return),00:01,silent)</onclick>
							</control>

						</control>
					</control>
				</control>
			</control>
		</control>
	</control>
