<?xml version="1.0" encoding="UTF-8"?>
<!-- BINGIE -->
<includes>
	<!-- View 527 row details -->
    <include name="View_527_Row_Details">
        <control type="grouplist">
            <orientation>horizontal</orientation>
            <usecontrolcoords>true</usecontrolcoords>
            <height>50</height>
            <itemgap>15</itemgap>

            <include>Percentage_Rating_Details_Row_Seasons</include>

            <!-- Year -->
            <control type="label" id="611111">
                <visible>!String.IsEmpty(Control.GetLabel(611111))</visible>
                <posy>6</posy>
                <height>35</height>
                <width>auto</width>
                <aligny>center</aligny>
                <font>Reg26</font>
                <textcolor>a6ffffff</textcolor>
                <label>$VAR[GetYear]</label>
                <include>Default_Visible_Fade</include>
            </control>

			<include>MPAA_Details_Row</include>
            <!-- Total Seasons -->
            <control type="label" id="711117">
                <posy>6</posy>
                <visible>!String.IsEmpty(Control.GetLabel(711117)) + Control.IsVisible(527)</visible>
                <width>auto</width>
                <label>$VAR[View527TotalSeasons]</label>
                <height>35</height>
                <aligny>center</aligny>
                <textcolor>a6ffffff</textcolor>
                <font>Reg26</font>
                <include>Default_Visible_Fade</include>
            </control>
			<control type="label" id="711118">
                <posy>6</posy>
                <visible>!Control.IsVisible(711117)</visible>
                <width>auto</width>
                <label>$VAR[View527CurrentSeason]</label>
                <height>35</height>
                <aligny>center</aligny>
                <textcolor>a6ffffff</textcolor>
                <font>Reg26</font>
                <include>Default_Visible_Fade</include>
            </control>
        </control>
    </include>

	<!-- workaround for Total Season/s IN EPISODE LEVEL -->
    <variable name="View527TotalSeasons">
        <value condition="Integer.IsGreater(Container(527).NumItems,1)">$INFO[Container(527).NumItems,, $LOCALIZE[320207]]</value>
        <value>$INFO[Container(527).NumItems,, $LOCALIZE[20373]]</value>
    </variable>

	<!-- item main label -->
    <variable name="View527MainLabel">
        <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
        <value>$INFO[ListItem.Label]</value>
    </variable>

	<!-- Season x / Special label -->
    <variable name="View527CurrentSeason">
        <!-- case special episode -->
        <value condition="!String.IsEmpty(ListItem.Episode) + String.Contains(ListItem.Episode,S)">$LOCALIZE[20381]</value>
        <!-- default case -->
        <value>$INFO[ListItem.Season,$LOCALIZE[20373] ,]</value>
    </variable>

	<!-- Variable for sorting out Season or TV Show Landscape -->

	<!-- Total episode/s -->
    <variable name="View527TotalEpisodes">
        <value condition="Integer.IsGreater(ListItem.Property(TotalEpisodes),1)">$INFO[ListItem.Property(TotalEpisodes),, $LOCALIZE[20453]]</value>
        <value>$INFO[ListItem.Property(TotalEpisodes),, $LOCALIZE[20452]]</value>
    </variable>

	<!-- view527 landscape layout -->
    <include name="View_527_Landscape_Defs">
        <control type="group">
            <left>0</left>
            <height>episodes_thumb_height</height>
            <width>episodes_thumb_width</width>
            <!-- landscape image-->
            <control type="image">
                <width>episodes_thumb_width</width>
                <height>episodes_thumb_height</height>
                <bordersize>8</bordersize>
                <texture background="true" diffuse="diffuse/wide.png" fallback="DefaultVideo.png">$VAR[LandscapeImage]</texture>
                <aspectratio scalediffuse="false" align="center" aligny="center">scale</aspectratio>
            </control>
            <!-- gradient overlay -->
            <control type="image">
                <bottom>8</bottom>
                <left>8</left>
                <width>450</width>
                <height>250</height>
                <texture>overlays/gradient_episodes.png</texture>
            </control>
            <!-- Episode/Season Sxx:Exx format -->
            <control type="label">
                <left>28</left>
                <bottom>30</bottom>
                <height>35</height>
                <width>200</width>
                <font>Reg26</font>
                <align>left</align>
                <textcolor>ff929699</textcolor>
                <label>[B]$VAR[View527SeasonEpisodeFormat][/B]</label>
				<animation effect="slide" end="0,8" time="0" condition="!Integer.IsGreater(ListItem.PercentPlayed,0) + !Integer.IsGreater(ListItem.PlayCount,0)">Conditional</animation>
            </control>
            <!-- progress bar -->
            <control type="progress">
                <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                <left>28</left>
                <bottom>23</bottom>
                <description>progress bar</description>
                <width>410</width>
                <height>6</height>
                <texturebg colordiffuse="ff929699">diffuse/panel2.png</texturebg>
                <lefttexture/>
                <midtexture colordiffuse="ffe50914">diffuse/panel2.png</midtexture>
                <righttexture/>
                <info>ListItem.PercentPlayed</info>
            </control>
            <!-- fake progress bar for watched & not resumable -->
            <control type="progress">
                <visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable</visible>
                <left>28</left>
                <bottom>23</bottom>
                <description>progress bar</description>
                <width>410</width>
                <height>6</height>
                <texturebg colordiffuse="ffe50914">diffuse/panel2.png</texturebg>
                <lefttexture/>
                <midtexture colordiffuse="ffe50914">diffuse/panel2.png</midtexture>
                <righttexture/>
                <info>ListItem.PercentPlayed</info>
            </control>
            <!-- dim landscape -->
            <control type="image">
                <visible>!Control.HasFocus(5027) + !Control.HasFocus(60)</visible>
                <animation effect="fade" start="0" end="50" time="150" condition="!Control.HasFocus(5027) + !Control.HasFocus(60)">Conditional</animation>
                <width>450</width>
                <height>250</height>
                <top>8</top>
                <left>8</left>
                <texture background="true">colors/color_black.png</texture>
            </control>
        </control>
    </include>

	<!-- view527 container item details focused -->
    <include name="View_527_Details_Defs_Focus">
		<include content="BingieEpisodeSeasonDetailCard">
			<param name="label" value="$VAR[View527MainLabel]" />
			<param name="focus_condition" value="!Control.HasFocus(5027) + !Control.HasFocus(60)" />
			<param name="content_visibility" value="Container(5027).Content(episodes) | String.IsEqual(ListItem.DBTYPE,episode)" />
			<param name="scroll" value="true" />
		</include>
    </include>

	<!-- view527 container item details focused with air date -->

	<!-- view527 container item details -->
    <include name="View_527_Details_Defs">
		<include content="BingieEpisodeSeasonDetailCard">
			<param name="label" value="$VAR[View527MainLabel]" />
			<param name="focus_condition" value="!Control.HasFocus(5027) + !Control.HasFocus(60)" />
			<param name="content_visibility" value="Container(5027).Content(episodes) | String.IsEqual(ListItem.DBTYPE,episode)" />
			<param name="scroll" value="false" />
		</include>
    </include>

	<!-- view527 container item details with air date -->

	<!-- View 527 SxxExx format -->
    <variable name="View527SeasonEpisodeFormat">
		<value condition="Integer.IsLess(ListItem.Season,1) + !String.IsEmpty(ListItem.Episode)">$LOCALIZE[20381] $INFO[ListItem.Episode]</value>
        <value condition="!String.IsEmpty(ListItem.Season)">$INFO[ListItem.Season,$LOCALIZE[31871],]$INFO[ListItem.Episode,: $LOCALIZE[31872],]</value>
        <value condition="String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode) + !String.Contains(ListItem.Episode,S)">$INFO[ListItem.Episode,$LOCALIZE[31873,,.] ,]</value>
        <value condition="String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode) + String.Contains(ListItem.Episode,S)">$INFO[ListItem.Episode]</value>
    </variable>

	<!-- item sublabel - premiered for episodes / year mpaa totalepisodes (unwatched) for seasons -->

	<!-- year mpaa totalepisodes (unwatched) format for seasons -->

	<!-- height for left list without fanart thumb -->
	<include name="HeightWithoutThumb">
		<height>650</height>
	</include>
	<!-- height for left list with fanart thumb -->

	<include name="View_527_Seasons">
		<control type="group">
			<visible>Control.IsVisible(527) + Container.Content(seasons)</visible>

			<!-- Fanart Image Added to View-->

			<!-- Hidden Label for Landscape/Poster choice -->
			<control type="label" id="22345">
				<visible>false</visible>
				<left>50</left>
				<width>100</width>
				<height>40</height>
				<bottom>50</bottom>
				<label>landscape</label>
			</control>

			<control type="grouplist">

                <top>10</top>
                <left>123</left>
                <usecontrolcoords>true</usecontrolcoords>
                <orientation>vertical</orientation>

                <!-- clearlogo title -->
                <control type="image" id="987767">
                    <left>15</left>
					<height>190</height>
                    <width>490</width>
                    <align>left</align>
                    <top>0</top>
                    <fadetime>350</fadetime>
                    <aspectratio align="left" aligny="center">keep</aspectratio>
                    <texture background="true" fallback="colors/color_transparent.png">$VAR[BingieInfoClearlogo]</texture>
                </control>

				<!-- Blank image for gap -->
				<control type="image">
					<visible>String.EndsWith(Control.GetLabel(987767),color_transparent.png)</visible>
					<top>0</top>
					<left>0</left>
					<width>650</width>
					<height>0</height>
				</control>

                <!-- text title -->
                <control type="textbox">
                    <visible>String.EndsWith(Control.GetLabel(987767),color_transparent.png)</visible>
                    <top>-194</top>
					<left>15</left>
                    <width max="650">auto</width>
                    <height>184</height>
                    <font>Title</font>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textcolor>ffffffff</textcolor>
                    <label>[B]$VAR[TVShowTitle][/B]</label>
					<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
                </control>

                <!-- row details -->
                <control type="group">
					<left>15</left>
					<top>8</top>
                    <width>650</width>
                    <height>40</height>
                    <include>View_527_Row_Details</include>
                </control>

			<!-- Season Landscape -->

			<!-- Blank image for gap -->
			<control type="image">
				<visible>String.Contains(Control.GetLabel(22345),landscape)</visible>
				<top>14</top>
				<left>15</left>
				<width>570</width>
				<height>60</height>
			</control>

			<!-- left list -->
			<control type="list" id="527">
				<visible>Container.Content(seasons)</visible>
				<include>Animation_Right_Bingie_2</include>
                <animation effect="fade" start="100" end="60" time="150" condition="!Control.HasFocus(527)">Conditional</animation>
				<viewtype label="31095">wide</viewtype>
				<left>16</left>
				<top>9</top>
				<width>565</width>
				<include>HeightWithoutThumb</include>
				<preloaditems>1</preloaditems>
				<orientation>vertical</orientation>
				<onleft>9000</onleft>
				<onright>5027</onright>
				<onup>527</onup>
				<ondown>527</ondown>
				<include>ScrollTime</include>
				<focusedlayout height="65" width="565" condition="Control.HasFocus(527)">
						<!-- Season x label -->
                            <control type="label">
                                <left>18</left>
                                <width>280</width>
                                <height>61</height>
                                <aligny>center</aligny>
                                <align>left</align>
                                <font>Reg32</font>
                                <textcolor>ffffffff</textcolor>
                                <label>$INFO[ListItem.Label]</label>
                            </control>
						<!-- x Episodes label -->
                            <control type="label">
                                <right>19</right>
                                <width>250</width>
                                <height>61</height>
                                <aligny>center</aligny>
                                <align>right</align>
                                <font>Reg28</font>
                                <textcolor>ffffffff</textcolor>
                                <label>[LOWERCASE]$VAR[View527TotalEpisodes][/LOWERCASE]</label>
                            </control>
						<!-- bingie button border -->
                            <control type="image">
                                <width>565</width>
                                <height>65</height>
                                <aligny>top</aligny>
                                <align>left</align>
                                <aspectratio align="left" aligny="top">stretch</aspectratio>
                                <colordiffuse>ffffffff</colordiffuse>
                                <texture border="10" background="true" colordiffuse="ffffffff">bingie/border/default_button_fo_4.png</texture>
                            </control>
				</focusedlayout>
				<focusedlayout height="65" width="565" condition="!Control.HasFocus(527)">
						<!-- Season x label -->
                            <control type="label">
                                <left>18</left>
                                <width>280</width>
                                <height>61</height>
                                <aligny>center</aligny>
                                <align>left</align>
                                <font>Reg32</font>
                                <textcolor>a6ffffff</textcolor>
                                <label>$INFO[ListItem.Label]</label>
                            </control>
						<!-- x Episodes label -->
                            <control type="label">
                                <right>19</right>
                                <width>250</width>
                                <height>61</height>
                                <aligny>center</aligny>
                                <align>right</align>
                                <font>Reg28</font>
                                <textcolor>a6ffffff</textcolor>
                                <label>[LOWERCASE]$VAR[View527TotalEpisodes][/LOWERCASE]</label>
                            </control>
						<!-- bingie button border -->
                            <control type="image">
                                <width>565</width>
                                <height>65</height>
                                <aligny>top</aligny>
                                <align>left</align>
                                <aspectratio align="left" aligny="top">stretch</aspectratio>
                                <texture border="10" background="true" colordiffuse="a6ffffff">bingie/border/default_button_fo_4.png</texture>
                            </control>
				</focusedlayout>
				<itemlayout height="65" width="565" condition="Container.Content(seasons)">
						<!-- Season x label -->
                            <control type="label">
                                <left>18</left>
                                <width>280</width>
                                <height>61</height>
                                <aligny>center</aligny>
                                <align>left</align>
                                <font>Reg32</font>
                                <textcolor>a6ffffff</textcolor>
                                <label>$INFO[ListItem.Label]</label>
                            </control>
				</itemlayout>
			</control>
			</control>
			<!-- right list -->
			<control type="group">
			<include>Animation_Right_Bingie_2</include>
			<visible>Control.IsVisible(527)</visible>
				<control type="fixedlist" id="5027">
				<visible>Control.IsVisible(527) + !Container(527).ListItem.IsParentFolder</visible>
				<onclick>Action(Info)</onclick>
				<animation effect="fade" start="100" end="0" condition="Container(5027).IsUpdating">Conditional</animation>
				<top>-153</top>
				<posx>781</posx>
                <height>1280</height>
                <width>1100</width>
				<orientation>vertical</orientation>
				<focusposition>1</focusposition>
				<pagecontrol>60</pagecontrol>
				<onleft>527</onleft>
				<onup>5027</onup>
				<ondown>5027</ondown>
				<onright>60</onright>
				<onback>527</onback>
                <preloaditems>2</preloaditems>
                <include>ScrollTime</include>
				<focusedlayout width="1050" height="280">
                        <!-- panel/border -->
                        <!-- landscape content -->
                        <include>View_527_Landscape_Defs</include>
                        <!-- details content -->
                        <include>View_527_Details_Defs_Focus</include>
                </focusedlayout>
				<itemlayout width="1050" height="280">
                        <!-- landscape content -->
                        <include>View_527_Landscape_Defs</include>
                        <!-- details content -->
                        <include>View_527_Details_Defs</include>
                    </itemlayout>
				<content target="videos" sortby="episode" sortorder="ascending">$INFO[Container(527).ListItem.FolderPath]</content>
				</control>
				<!-- fixed border moving with screen -->
                <control type="image">
                    <visible>Integer.IsGreater(Container(5027).NumItems,0) + Control.HasFocus(5027)</visible>
					<animation effect="fade" start="100" end="0" condition="Container(5027).IsUpdating">Conditional</animation>
                    <top>127</top>
                    <posx>781</posx>
                    <width>episodes_thumb_width</width>
                    <height>episodes_thumb_height</height>
                    <texture background="true" border="10">bingie/border/thumb_fo_4.png</texture>
                    <colordiffuse>ffffffff</colordiffuse>
                    <bordersize>2</bordersize>
                </control>
                <!-- vertical Scrollbar -->
                <control type="scrollbar" id="60">
					<texturesliderbackground border="5" colordiffuse="ff141414">scrollbar/texturesliderbar_small.png</texturesliderbackground>
					<texturesliderbar colordiffuse="ff646464" border="5">scrollbar/texturesliderbar_small.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="ffcc0000" border="5">scrollbar/texturesliderbar_small.png</texturesliderbarfocus>
					<textureslidernib colordiffuse="ff646464">scrollbar/texturesliderbar_nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="ffcc0000">scrollbar/texturesliderbar_nib.png</textureslidernibfocus>
                    <visible>Control.IsVisible(5027) + Integer.IsGreater(Container(5027).NumItems,0)</visible>
                    <top>0</top>
                    <right>2</right>
                    <width>10</width>
                    <height>100%</height>
                    <onup>60</onup>
                    <onleft>5027</onleft>
                    <animation effect="fade" start="0" end="100" time="400" condition="Control.HasFocus(60) + !Control.IsVisible(6002)">Conditional</animation>
                    <animation effect="fade" start="100" end="0" time="400" condition="!Control.HasFocus(60) | Control.IsVisible(6002)">Conditional</animation>
                </control>
			</control>
		<!-- Loading Spinner -->
        <include content="Busy_Spinner">
            <param name="centerleft" value="67%"/>
            <param name="centertop" value="50%"/>
            <param name="visibility" value="Container(5027).IsUpdating + !Window.IsVisible(DialogBusy.xml)"/>
            <param name="size" value="100"/>
        </include>
		</control>
	</include>
</includes>
