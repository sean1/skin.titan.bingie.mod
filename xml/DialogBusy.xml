<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
	<defaultcontrol always="true">9900</defaultcontrol>
	<onload condition="!String.IsEmpty(Window(Home).Property(BingieTrailerPreview))">Dialog.Close(busydialog,true)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(BingieTrailerPreview))">Dialog.Close(busydialognocancel,true)</onload>
	<controls>
		<!-- Kodi's busy dialog otherwise dismisses Back without stopping a stream that is still opening. -->
		<control type="button" id="9900">
			<left>0</left><top>0</top><width>1</width><height>1</height>
			<visible>Player.HasMedia + !Player.HasVideo</visible>
			<visible>String.Contains(Player.Filenameandpath,plugin://skin.titan.bingie.lite/?mode=livetv.play)|[!String.IsEmpty(Window(Home).Property(BingieTV))+String.IsEqual(Player.Filenameandpath,Window(Home).Property(BingieTV))]</visible>
			<onback>PlayerControl(Stop)</onback>
		</control>
		<control type="group">
            <visible>!Window.IsVisible(startup)</visible>
		</control>
        <control type="group">
            <visible>!Window.IsVisible(startup)</visible>
            <include>Busy_Spinner</include>
        </control>
    </controls>
</window>
